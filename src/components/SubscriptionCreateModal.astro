---

---

<div
  id="subscription-create-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/20 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
>
  <!-- Modal Content -->
  <div
    class="glass-modal w-full max-w-2xl rounded-[24px] overflow-hidden flex flex-col max-h-[90vh] transform scale-95 transition-transform duration-300"
  >
    <div
      class="px-8 py-6 border-b border-slate-200/60 flex items-center justify-between shrink-0"
    >
      <div>
        <h2 class="text-xl font-extrabold text-slate-800 tracking-tight">
          Add New Subscription
        </h2>
        <p class="text-sm text-slate-500">
          Track a new recurring expense or service
        </p>
      </div>
      <button
        id="close-subscription-modal"
        class="size-10 rounded-full hover:bg-slate-100 flex items-center justify-center text-slate-400 hover:text-slate-600 transition-colors"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <div class="p-8 overflow-y-auto hide-scroll flex flex-col gap-8">
      <!-- Service Selection -->
      <div class="flex flex-col gap-4">
        <label class="text-xs font-bold uppercase tracking-wider text-slate-500"
          >Service Selection</label
        >
        <div class="relative group">
          <span
            class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 group-focus-within:text-primary transition-colors"
            >search</span
          >
          <input
            class="w-full pl-12 pr-4 py-4 custom-input font-medium text-slate-700 placeholder:text-slate-400 text-sm"
            placeholder="Search for a service (e.g., Netflix, Adobe)"
            type="text"
          />
        </div>
        <div class="grid grid-cols-6 gap-3">
          <button
            class="aspect-square rounded-2xl bg-white border border-slate-100 flex items-center justify-center hover:border-primary hover:shadow-md transition-all group"
          >
            <div
              class="size-8 bg-black text-red-600 rounded-lg flex items-center justify-center font-bold text-sm"
            >
              N
            </div>
          </button>
          <button
            class="aspect-square rounded-2xl bg-white border border-slate-100 flex items-center justify-center hover:border-primary hover:shadow-md transition-all group"
          >
            <div
              class="size-8 bg-[#1db954] text-white rounded-full flex items-center justify-center"
            >
              <span class="material-symbols-outlined text-[18px]"
                >graphic_eq</span
              >
            </div>
          </button>
          <button
            class="aspect-square rounded-2xl bg-white border border-slate-100 flex items-center justify-center hover:border-primary hover:shadow-md transition-all group"
          >
            <div
              class="size-8 bg-black text-white rounded-lg flex items-center justify-center text-[10px] font-bold tracking-tighter"
            >
              APPLE
            </div>
          </button>
          <button
            class="aspect-square rounded-2xl bg-white border border-slate-100 flex items-center justify-center hover:border-primary hover:shadow-md transition-all group"
          >
            <div
              class="size-8 bg-gradient-to-r from-purple-600 to-blue-600 text-white rounded-lg flex items-center justify-center"
            >
              <span class="material-symbols-outlined text-[16px]">palette</span>
            </div>
          </button>
          <button
            class="aspect-square rounded-2xl bg-white border border-slate-100 flex items-center justify-center hover:border-primary hover:shadow-md transition-all group"
          >
            <div
              class="size-8 bg-blue-500 text-white rounded-full flex items-center justify-center font-serif font-bold italic text-sm"
            >
              P
            </div>
          </button>
          <button
            class="aspect-square rounded-2xl bg-slate-50 border border-slate-200 border-dashed flex items-center justify-center text-slate-400 hover:text-primary hover:border-primary/50 transition-all"
          >
            <span class="material-symbols-outlined text-[20px]">add</span>
          </button>
        </div>
      </div>

      <!-- Amount & Currency -->
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-7 flex flex-col gap-2">
          <label
            class="text-xs font-bold uppercase tracking-wider text-slate-500"
            >Amount</label
          >
          <div class="relative">
            <span
              class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-mono text-lg"
              >$</span
            >
            <input
              class="w-full pl-8 pr-4 py-3 custom-input font-mono text-2xl font-bold text-slate-800 placeholder:text-slate-300"
              type="text"
              value="0.00"
            />
          </div>
        </div>
        <div class="col-span-12 md:col-span-5 flex flex-col gap-2">
          <label
            class="text-xs font-bold uppercase tracking-wider text-slate-500"
            >Currency</label
          >
          <div class="relative">
            <select
              class="w-full pl-4 pr-10 py-3.5 custom-input font-mono text-sm font-medium text-slate-700 appearance-none bg-none"
            >
              <option>USD ($)</option>
              <option>EUR (€)</option>
              <option>IDR (Rp)</option>
              <option>GBP (£)</option>
            </select>
            <span
              class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-sm"
              >expand_more</span
            >
          </div>
        </div>
      </div>

      <!-- Frequency & Date -->
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-6 flex flex-col gap-2">
          <label
            class="text-xs font-bold uppercase tracking-wider text-slate-500"
            >Frequency</label
          >
          <div class="relative">
            <select
              class="w-full pl-10 pr-10 py-3.5 custom-input font-medium text-slate-700 appearance-none bg-none text-sm"
            >
              <option>Monthly</option>
              <option>Yearly</option>
              <option>Weekly</option>
              <option>Quarterly</option>
            </select>
            <span
              class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]"
              >update</span
            >
            <span
              class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-sm"
              >expand_more</span
            >
          </div>
        </div>
        <div class="col-span-12 md:col-span-6 flex flex-col gap-2">
          <label
            class="text-xs font-bold uppercase tracking-wider text-slate-500"
            >Next Billing Date</label
          >
          <div class="relative">
            <input
              class="w-full pl-10 pr-4 py-3.5 custom-input font-medium text-slate-700 text-sm"
              type="date"
            />
            <span
              class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]"
              >calendar_today</span
            >
          </div>
        </div>
      </div>

      <!-- Category & Pocket -->
      <div class="grid grid-cols-12 gap-6">
        <div class="col-span-12 md:col-span-6 flex flex-col gap-2">
          <label
            class="text-xs font-bold uppercase tracking-wider text-slate-500"
            >Category</label
          >
          <div class="relative">
            <select
              class="w-full pl-10 pr-10 py-3.5 custom-input font-medium text-slate-700 appearance-none bg-none text-sm"
            >
              <option>Entertainment</option>
              <option>SaaS / Software</option>
              <option>Utilities</option>
              <option>Education</option>
              <option>Health & Fitness</option>
            </select>
            <span
              class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]"
              >category</span
            >
            <span
              class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-sm"
              >expand_more</span
            >
          </div>
        </div>
        <div class="col-span-12 md:col-span-6 flex flex-col gap-2">
          <label
            class="text-xs font-bold uppercase tracking-wider text-slate-500"
            >Payment Pocket</label
          >
          <div class="relative">
            <select
              class="w-full pl-10 pr-10 py-3.5 custom-input font-medium text-slate-700 appearance-none bg-none text-sm"
            >
              <option>Jago - Main</option>
              <option>BCA - Savings</option>
              <option>Cash Wallet</option>
              <option>Credit Card</option>
            </select>
            <span
              class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]"
              >account_balance_wallet</span
            >
            <span
              class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-sm"
              >expand_more</span
            >
          </div>
        </div>
      </div>

      <!-- Settings -->
      <div
        class="p-5 rounded-2xl bg-white/50 border border-white/60 flex flex-col md:flex-row gap-6 items-center justify-between"
      >
        <div class="flex items-center gap-4 w-full md:w-auto">
          <div
            class="relative inline-block w-12 mr-2 align-middle select-none transition duration-200 ease-in"
          >
            <input
              checked=""
              class="toggle-checkbox absolute block w-6 h-6 rounded-full bg-white border-4 appearance-none cursor-pointer border-slate-300 transition-all duration-300 top-[-4px]"
              id="modal-toggle-new-sub"
              name="toggle"
              type="checkbox"
            />
            <label
              class="toggle-label block overflow-hidden h-4 rounded-full bg-slate-300 cursor-pointer transition-colors duration-300"
              for="modal-toggle-new-sub"></label>
          </div>
          <div>
            <p class="text-sm font-bold text-slate-800">Auto-record</p>
            <p class="text-xs text-slate-500">Add to ledger automatically</p>
          </div>
        </div>
        <div class="h-px w-full md:w-px md:h-12 bg-slate-200"></div>
        <div class="flex flex-col gap-2 w-full md:w-auto">
          <div class="flex items-center justify-between gap-4">
            <span
              class="text-xs font-bold uppercase tracking-wider text-slate-500"
              >Vibe Check</span
            >
            <span
              class="px-2 py-0.5 rounded-full bg-teal-50 border border-teal-100 text-teal-600 text-[10px] font-extrabold tracking-wide uppercase"
              >CHILL</span
            >
          </div>
          <div class="flex gap-1 w-full max-w-[200px]">
            <button
              class="flex-1 h-2 rounded-full bg-slate-200 hover:bg-slate-300 transition-colors"
              title="Mager"></button>
            <button
              class="flex-1 h-2 rounded-full bg-slate-200 hover:bg-slate-300 transition-colors"
              title="Meh"></button>
            <button
              class="flex-1 h-2 rounded-full bg-primary hover:bg-primary-dark transition-colors"
              title="Chill"></button>
            <button
              class="flex-1 h-2 rounded-full bg-slate-200 hover:bg-slate-300 transition-colors"
              title="Happy"></button>
            <button
              class="flex-1 h-2 rounded-full bg-slate-200 hover:bg-slate-300 transition-colors"
              title="Hype"></button>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div
      class="px-8 py-6 border-t border-slate-200/60 bg-white/30 flex items-center justify-end gap-3 shrink-0"
    >
      <button
        id="cancel-subscription-modal"
        class="px-6 py-3 rounded-xl text-slate-600 font-bold text-sm hover:bg-slate-100 transition-colors"
      >
        Cancel
      </button>
      <button
        class="px-6 py-3 rounded-xl bg-gradient-to-r from-teal-400 to-primary text-white font-bold text-sm shadow-lg shadow-primary/20 hover:shadow-primary/40 hover:-translate-y-0.5 transition-all"
      >
        Create Subscription
      </button>
    </div>
  </div>
</div>

<style>
  .glass-modal {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow:
      0 20px 60px -10px rgba(0, 0, 0, 0.1),
      0 10px 30px -5px rgba(0, 0, 0, 0.05);
  }
  .hide-scroll::-webkit-scrollbar {
    display: none;
  }
  .hide-scroll {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .custom-input {
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    background-color: rgba(255, 255, 255, 0.6);
    transition: all 0.2s;
  }
  .custom-input:focus {
    outline: none;
    border-color: #22c3b6;
    box-shadow: 0 0 0 3px rgba(34, 195, 182, 0.1);
    background-color: #ffffff;
  }
  .toggle-checkbox:checked {
    right: 0;
    border-color: #22c3b6;
  }
  .toggle-checkbox:checked + .toggle-label {
    background-color: #22c3b6;
  }
</style>

<script>
  const modal = document.getElementById("subscription-create-modal");
  const modalContent = modal?.querySelector(".glass-modal");
  const closeBtn = document.getElementById("close-subscription-modal");
  const cancelBtn = document.getElementById("cancel-subscription-modal");

  function openModal() {
    if (modal) {
      modal.classList.remove("opacity-0", "pointer-events-none");
      if (modalContent) {
        modalContent.classList.remove("scale-95");
        modalContent.classList.add("scale-100");
      }
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add("opacity-0", "pointer-events-none");
      if (modalContent) {
        modalContent.classList.remove("scale-100");
        modalContent.classList.add("scale-95");
      }
    }
  }

  // Listen for custom event
  document.addEventListener("open-subscription-modal", openModal);

  closeBtn?.addEventListener("click", closeModal);
  cancelBtn?.addEventListener("click", closeModal);

  // Close on backdrop click
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });
</script>
