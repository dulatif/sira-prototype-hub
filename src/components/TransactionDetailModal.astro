---

---

<!-- Transaction Detail Modal -->
<div
  id="transaction-detail-modal"
  class="fixed inset-0 z-[60] flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-300"
>
  <!-- Backdrop -->
  <div
    id="transaction-detail-backdrop"
    class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm transition-opacity"
  >
  </div>

  <!-- Modal Card -->
  <div
    id="transaction-detail-content"
    class="relative w-full max-w-md bg-white/90 premium-glass-card rounded-[24px] shadow-premium overflow-hidden flex flex-col max-h-[90vh] transform scale-95 opacity-0 transition-all duration-300"
  >
    <!-- Dynamic Glow -->
    <div
      class="absolute -top-32 left-1/2 -translate-x-1/2 w-64 h-64 bg-primary/20 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <!-- Close Button -->
    <button
      id="btn-close-detail"
      class="absolute top-4 right-4 z-20 p-2 rounded-full hover:bg-slate-100/50 text-slate-400 hover:text-slate-600 transition-colors"
    >
      <span class="material-symbols-outlined text-[20px]">close</span>
    </button>

    <!-- Scrollable Content -->
    <div
      class="overflow-y-auto overflow-x-hidden custom-scrollbar bg-gradient-to-b from-white/40 to-white/90 relative z-10 flex-1"
    >
      <!-- Reflection / Vibe Check Section -->
      <div
        class="bg-gradient-to-b from-rose-50/60 to-transparent p-6 pt-10 pb-6 text-center border-b border-rose-100/40 relative"
      >
        <div
          class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-rose-200/50 to-transparent"
        >
        </div>

        <div class="inline-flex flex-col items-center gap-3 mb-4">
          <div
            class="text-[10px] font-bold text-slate-400 uppercase tracking-widest flex items-center gap-1.5 mb-1"
          >
            <span class="material-symbols-outlined text-sm text-primary"
              >psychology</span
            >
            Reflection
          </div>
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/80 backdrop-blur-sm rounded-full shadow-sm border border-rose-100/60"
          >
            <span class="text-xl">🫠</span>
            <span class="text-xs font-bold text-rose-600 tracking-wider"
              >GABUT / BORED</span
            >
          </div>
        </div>

        <div class="relative max-w-xs mx-auto">
          <p
            class="text-slate-600 font-medium italic text-sm leading-relaxed text-center px-4"
          >
            "Bought that new desk organizer I saw on TikTok. The aesthetic was
            too good to pass up."
          </p>
          <p class="text-[11px] text-slate-400 mt-2 font-medium">
            Note: Need to be mindful about "aesthetic" purchases.
          </p>
        </div>
      </div>

      <!-- Transaction Amount & Info -->
      <div class="p-8 text-center flex flex-col items-center relative">
        <div class="mb-1">
          <h2
            class="font-mono text-5xl font-bold text-slate-800 tracking-tighter"
          >
            -$42.00
          </h2>
        </div>
        <div class="flex flex-col items-center gap-1">
          <span class="text-lg font-semibold text-slate-800 font-outfit"
            >Amazon.com</span
          >
          <div
            class="flex items-center gap-2 text-slate-400 text-xs font-medium bg-slate-100/50 px-3 py-1 rounded-full border border-slate-200/50"
          >
            <span class="material-symbols-outlined text-[14px]"
              >calendar_today</span
            >
            <span>Oct 12, 2023 • 14:30</span>
          </div>
        </div>
      </div>

      <!-- Detail Grid -->
      <div class="px-6 pb-6">
        <div class="grid grid-cols-2 gap-3">
          <div
            class="p-3 rounded-2xl bg-slate-50/80 border border-slate-100 hover:bg-white transition-colors group"
          >
            <div class="flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <span
                  class="text-[10px] font-bold text-slate-400 uppercase tracking-wider"
                  >Source</span
                >
                <span
                  class="material-symbols-outlined text-blue-500 text-[18px]"
                  >account_balance</span
                >
              </div>
              <span
                class="text-sm font-bold text-slate-700 font-outfit truncate"
                >BCA Main</span
              >
            </div>
          </div>

          <div
            class="p-3 rounded-2xl bg-slate-50/80 border border-slate-100 hover:bg-white transition-colors group"
          >
            <div class="flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <span
                  class="text-[10px] font-bold text-slate-400 uppercase tracking-wider"
                  >Category</span
                >
                <span
                  class="material-symbols-outlined text-orange-500 text-[18px]"
                  >devices</span
                >
              </div>
              <span
                class="text-sm font-bold text-slate-700 font-outfit truncate"
                >Tech & Gadgets</span
              >
            </div>
          </div>

          <div
            class="p-3 rounded-2xl bg-slate-50/80 border border-slate-100 hover:bg-white transition-colors group"
          >
            <div class="flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <span
                  class="text-[10px] font-bold text-slate-400 uppercase tracking-wider"
                  >Type</span
                >
                <span
                  class="material-symbols-outlined text-rose-500 text-[18px]"
                  >receipt_long</span
                >
              </div>
              <span class="text-sm font-bold text-rose-600 font-outfit"
                >Expense</span
              >
            </div>
          </div>

          <div
            class="p-3 rounded-2xl bg-slate-50/80 border border-slate-100 hover:bg-white transition-colors group"
          >
            <div class="flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <span
                  class="text-[10px] font-bold text-slate-400 uppercase tracking-wider"
                  >Goal</span
                >
                <span
                  class="material-symbols-outlined text-purple-500 text-[18px]"
                  >track_changes</span
                >
              </div>
              <div class="flex items-center gap-1 truncate">
                <span
                  class="material-symbols-outlined text-[14px] text-purple-500"
                  >flag</span
                >
                <span
                  class="text-sm font-bold text-slate-700 font-outfit truncate"
                  >Dream Desk</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Actions -->
    <div
      class="p-5 pt-4 bg-white/60 backdrop-blur-xl border-t border-white flex items-center justify-between gap-3 relative z-20 shrink-0"
    >
      <div class="flex gap-2">
        <button
          class="size-10 flex items-center justify-center rounded-xl text-slate-400 hover:text-primary hover:bg-primary/5 border border-transparent hover:border-primary/10 transition-all"
          title="Duplicate"
        >
          <span class="material-symbols-outlined text-[20px]">content_copy</span
          >
        </button>
        <button
          class="size-10 flex items-center justify-center rounded-xl text-slate-400 hover:text-primary hover:bg-primary/5 border border-transparent hover:border-primary/10 transition-all"
          title="Export Receipt"
        >
          <span class="material-symbols-outlined text-[20px]">ios_share</span>
        </button>
      </div>
      <button
        class="flex-1 teal-flux-gradient text-white h-10 px-4 rounded-xl shadow-lg shadow-primary/20 hover:shadow-primary/30 hover:-translate-y-0.5 transition-all font-bold text-sm flex items-center justify-center gap-2"
      >
        <span>Edit Details</span>
        <span class="material-symbols-outlined text-[16px]">edit</span>
      </button>
    </div>
  </div>
</div>

<style>
  .premium-glass-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.15),
      0 0 0 1px rgba(255, 255, 255, 0.4) inset;
  }
  .teal-flux-gradient {
    background: linear-gradient(135deg, #22c3b6 0%, #1aa398 100%);
  }
  .shadow-premium {
    box-shadow:
      0 20px 40px -10px rgba(0, 0, 0, 0.1),
      0 0 15px rgba(255, 255, 255, 0.5) inset;
  }
</style>

<script>
  const detailModal = document.getElementById("transaction-detail-modal");
  const detailBackdrop = document.getElementById("transaction-detail-backdrop");
  const detailContent = document.getElementById("transaction-detail-content");
  const btnCloseDetail = document.getElementById("btn-close-detail");

  function openDetailModal() {
    if (detailModal) {
      detailModal.classList.remove("hidden");
      // Animation frame to ensure display block is applied before opacity transition
      requestAnimationFrame(() => {
        detailModal.classList.remove("opacity-0");
        if (detailContent) {
          detailContent.classList.remove("scale-95", "opacity-0");
          detailContent.classList.add("scale-100", "opacity-100");
        }
      });
    }
  }

  function closeDetailModal() {
    if (detailModal) {
      detailModal.classList.add("opacity-0");
      if (detailContent) {
        detailContent.classList.remove("scale-100", "opacity-100");
        detailContent.classList.add("scale-95", "opacity-0");
      }
      setTimeout(() => {
        detailModal.classList.add("hidden");
      }, 300);
    }
  }

  if (btnCloseDetail)
    btnCloseDetail.addEventListener("click", closeDetailModal);
  if (detailBackdrop)
    detailBackdrop.addEventListener("click", closeDetailModal);

  // Listen for custom event 'open-transaction-detail'
  document.addEventListener("open-transaction-detail", () => {
    openDetailModal();
  });

  // Expose to window
  (window as any).openTransactionDetailModal = openDetailModal;
</script>
