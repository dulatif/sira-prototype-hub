---

---

<!-- Modal Backdrop & Container -->
<div
  id="transaction-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 wealth-wizard-overlay font-outfit hidden opacity-0 transition-opacity duration-300"
>
  <!-- Backdrop -->
  <div
    class="absolute inset-0 bg-slate-900/20 backdrop-blur-sm"
    id="transaction-modal-backdrop"
  >
  </div>

  <!-- Modal Card -->
  <div
    class="relative wizard-card w-full max-w-2xl rounded-[24px] overflow-hidden flex flex-col max-h-[90vh] shadow-2xl transform scale-95 opacity-0 transition-all duration-300"
    id="transaction-modal-content"
  >
    <!-- Header & Tabs -->
    <div class="p-6 pb-2 border-b border-white/40">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
          <span class="material-symbols-outlined text-primary" id="modal-icon"
            >add_circle</span
          >
          <span id="modal-title">Add Transaction</span>
        </h2>
        <button
          id="btn-close-transaction-modal"
          class="p-2 rounded-full hover:bg-slate-100/50 text-slate-400 hover:text-slate-600 transition-colors cursor-pointer"
        >
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <!-- Tab Navigation -->
      <div class="bg-slate-100/50 p-1 rounded-xl flex gap-1 relative mb-2">
        <button
          data-tab="expense"
          class="tab-btn flex-1 py-2 rounded-lg text-sm font-semibold transition-all bg-white text-rose-500 shadow-sm border border-black/5"
        >
          Expense
        </button>
        <button
          data-tab="income"
          class="tab-btn flex-1 py-2 rounded-lg text-sm font-semibold transition-all text-slate-500 hover:bg-white/50 hover:text-slate-700"
        >
          Income
        </button>
        <button
          data-tab="transfer"
          class="tab-btn flex-1 py-2 rounded-lg text-sm font-semibold transition-all text-slate-500 hover:bg-white/50 hover:text-slate-700"
        >
          Transfer
        </button>
      </div>
    </div>

    <!-- Content Area -->
    <div
      class="overflow-y-auto flex-1 p-6 md:p-8 space-y-8 hide-scrollbar"
      id="modal-body"
    >
      <!-- EXPENSE FORM -->
      <div id="form-expense" class="tab-content block space-y-8">
        <!-- Amount -->
        <div class="flex flex-col items-center justify-center py-4">
          <label
            class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2"
            >Amount</label
          >
          <div
            class="flex items-center justify-center gap-2 relative group w-full"
          >
            <button
              class="absolute left-4 md:left-12 lg:left-20 p-2 text-slate-400 hover:text-primary transition-colors"
            >
              <span class="text-lg font-mono font-bold">USD</span>
              <span class="material-symbols-outlined text-sm align-middle"
                >expand_more</span
              >
            </button>
            <div class="relative flex items-center justify-center">
              <span class="text-4xl text-slate-300 font-mono absolute -left-6"
                >$</span
              >
              <input
                autofocus
                class="bg-transparent border-none text-center font-mono text-[48px] font-bold text-slate-800 focus:ring-0 p-0 w-64 placeholder:text-slate-200"
                placeholder="0.00"
                type="text"
                value="45.00"
              />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Pocket Selector -->
          <div class="space-y-3">
            <label
              class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
              >Pocket</label
            >
            <div class="flex gap-3 overflow-x-auto pb-2 hide-scrollbar snap-x">
              <button
                class="snap-start shrink-0 flex flex-col items-center gap-2 group min-w-[70px]"
              >
                <div
                  class="size-14 rounded-2xl bg-white border-2 border-primary shadow-glow-teal flex items-center justify-center text-primary transition-all"
                >
                  <span class="material-symbols-outlined">account_balance</span>
                </div>
                <span class="text-xs font-semibold text-primary">BCA</span>
              </button>
              <button
                class="snap-start shrink-0 flex flex-col items-center gap-2 group min-w-[70px]"
              >
                <div
                  class="size-14 rounded-2xl bg-white/40 border border-white hover:bg-white hover:border-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-600 transition-all"
                >
                  <span class="material-symbols-outlined">savings</span>
                </div>
                <span class="text-xs font-medium text-slate-500">Jago</span>
              </button>
              <button
                class="snap-start shrink-0 flex flex-col items-center gap-2 group min-w-[70px]"
              >
                <div
                  class="size-14 rounded-2xl bg-white/40 border border-white hover:bg-white hover:border-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-600 transition-all"
                >
                  <span class="material-symbols-outlined">payments</span>
                </div>
                <span class="text-xs font-medium text-slate-500">Cash</span>
              </button>
              <button
                class="snap-start shrink-0 flex flex-col items-center gap-2 group min-w-[70px]"
              >
                <div
                  class="size-14 rounded-2xl border border-dashed border-slate-300 hover:border-primary hover:bg-primary/5 flex items-center justify-center text-slate-400 hover:text-primary transition-all"
                >
                  <span class="material-symbols-outlined">add</span>
                </div>
                <span class="text-xs font-medium text-slate-500">New</span>
              </button>
            </div>
          </div>

          <!-- Category Selector -->
          <div class="space-y-3">
            <label
              class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
              >Category</label
            >
            <div class="relative">
              <div
                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
              >
                <span class="material-symbols-outlined text-slate-400"
                  >restaurant</span
                >
              </div>
              <input
                class="block w-full pl-10 pr-10 py-3.5 bg-white/60 border border-white/60 rounded-xl text-sm focus:ring-2 focus:ring-primary/30 focus:border-primary/50 shadow-sm placeholder-slate-400 text-slate-700 font-medium cursor-pointer hover:bg-white/80 transition-colors"
                placeholder="Select category..."
                readonly
                type="text"
                value="Food & Drink"
              />
              <div
                class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none"
              >
                <span class="material-symbols-outlined text-slate-400"
                  >expand_more</span
                >
              </div>
            </div>
          </div>

          <!-- Date & Note -->
          <div
            class="col-span-1 md:col-span-2 grid grid-cols-1 md:grid-cols-3 gap-4"
          >
            <div class="md:col-span-1 space-y-3">
              <label
                class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
                >Date</label
              >
              <div class="relative">
                <div
                  class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                >
                  <span class="material-symbols-outlined text-slate-400"
                    >calendar_today</span
                  >
                </div>
                <input
                  class="block w-full pl-10 py-3 bg-white/60 border border-white/60 rounded-xl text-sm focus:ring-2 focus:ring-primary/30 focus:border-primary/50 shadow-sm text-slate-700 font-medium"
                  type="text"
                  value="Today, 16 Jan"
                />
              </div>
            </div>
            <div class="md:col-span-2 space-y-3">
              <label
                class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
                >Note</label
              >
              <input
                class="block w-full px-4 py-3 bg-white/60 border border-white/60 rounded-xl text-sm focus:ring-2 focus:ring-primary/30 focus:border-primary/50 shadow-sm placeholder-slate-400 text-slate-700"
                placeholder="Add Note... (e.g., Lunch with team)"
                type="text"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- INCOME FORM -->
      <div id="form-income" class="tab-content hidden space-y-6">
        <!-- Amount -->
        <div class="flex flex-col items-center justify-center py-2">
          <label
            class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2"
            >Incoming Amount</label
          >
          <div
            class="flex items-center justify-center gap-2 relative group w-full"
          >
            <button
              class="absolute left-4 md:left-12 lg:left-20 p-2 text-slate-400 hover:text-primary transition-colors"
            >
              <span class="text-lg font-mono font-bold">USD</span>
              <span class="material-symbols-outlined text-sm align-middle"
                >expand_more</span
              >
            </button>
            <div class="relative flex items-center justify-center">
              <span class="text-4xl text-slate-300 font-mono absolute -left-6"
                >$</span
              >
              <input
                class="bg-transparent border-none text-center font-mono text-[48px] font-bold text-slate-800 focus:ring-0 p-0 w-80 placeholder:text-slate-200"
                placeholder="0.00"
                type="text"
                value="2,500.00"
              />
            </div>
          </div>
        </div>

        <!-- Destination Pocket -->
        <div class="space-y-3 w-full">
          <label
            class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
            >Destination Pocket</label
          >
          <div
            class="flex gap-3 overflow-x-auto pb-2 hide-scrollbar snap-x w-full"
          >
            <button
              class="snap-start shrink-0 flex flex-col items-center gap-2 group min-w-[80px] flex-1"
            >
              <div
                class="h-16 w-full rounded-2xl bg-white border-2 border-primary shadow-glow-teal flex items-center justify-center text-primary transition-all"
              >
                <span class="material-symbols-outlined text-[28px]"
                  >account_balance</span
                >
              </div>
              <span class="text-xs font-semibold text-primary">BCA</span>
            </button>
            <!-- Other pockets... (Simplified) -->
            <button
              class="snap-start shrink-0 flex flex-col items-center gap-2 group min-w-[80px] flex-1"
            >
              <div
                class="h-16 w-full rounded-2xl bg-white/40 border border-white hover:bg-white hover:border-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-600 transition-all"
              >
                <span class="material-symbols-outlined text-[28px]"
                  >savings</span
                >
              </div>
              <span class="text-xs font-medium text-slate-500">Jago</span>
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
          <!-- Category -->
          <div class="space-y-3">
            <label
              class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
              >Category</label
            >
            <div class="relative">
              <div
                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
              >
                <span class="material-symbols-outlined text-slate-400"
                  >work</span
                >
              </div>
              <input
                class="block w-full pl-10 pr-10 py-3.5 bg-white/60 border border-white/60 rounded-xl text-sm focus:ring-2 focus:ring-primary/30 focus:border-primary/50 shadow-sm placeholder-slate-400 text-slate-700 font-medium cursor-pointer hover:bg-white/80 transition-colors"
                placeholder="Select category..."
                readonly
                type="text"
                value="Salary"
              />
            </div>
          </div>
          <!-- Date -->
          <div class="space-y-3">
            <label
              class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
              >Date</label
            >
            <div class="relative">
              <div
                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
              >
                <span class="material-symbols-outlined text-slate-400"
                  >calendar_today</span
                >
              </div>
              <input
                class="block w-full pl-10 py-3.5 bg-white/60 border border-white/60 rounded-xl text-sm focus:ring-2 focus:ring-primary/30 focus:border-primary/50 shadow-sm text-slate-700 font-medium"
                type="text"
                value="Today, 16 Jan"
              />
            </div>
          </div>
        </div>

        <!-- Note -->
        <div class="space-y-3 w-full">
          <label
            class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
            >Note</label
          >
          <textarea
            class="block w-full px-4 py-3 bg-white/60 border border-white/60 rounded-xl text-sm focus:ring-2 focus:ring-primary/30 focus:border-primary/50 shadow-sm placeholder-slate-400 text-slate-700 resize-none"
            placeholder="Add details..."
            rows="2">Monthly payroll deposit</textarea
          >
        </div>
      </div>

      <!-- TRANSFER FORM -->
      <div id="form-transfer" class="tab-content hidden space-y-8">
        <!-- Amount -->
        <div class="flex flex-col items-center justify-center py-4">
          <label
            class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-2"
            >Amount</label
          >
          <div
            class="flex items-center justify-center gap-2 relative group w-full"
          >
            <button
              class="absolute left-4 md:left-12 lg:left-20 p-2 text-slate-400 hover:text-primary transition-colors"
            >
              <span class="text-lg font-mono font-bold">USD</span>
              <span class="material-symbols-outlined text-sm align-middle"
                >expand_more</span
              >
            </button>
            <div class="relative flex items-center justify-center">
              <span class="text-4xl text-slate-300 font-mono absolute -left-6"
                >$</span
              >
              <input
                class="bg-transparent border-none text-center font-mono text-[48px] font-bold text-slate-800 focus:ring-0 p-0 w-64 placeholder:text-slate-200"
                placeholder="0.00"
                type="text"
                value="250.00"
              />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 relative">
          <!-- Arrow Icon -->
          <div
            class="absolute left-1/2 top-[44px] -translate-x-1/2 hidden md:flex z-10 pointer-events-none"
          >
            <div
              class="size-8 rounded-full bg-white shadow-sm border border-slate-100 flex items-center justify-center text-slate-400"
            >
              <span class="material-symbols-outlined text-[16px]"
                >arrow_forward</span
              >
            </div>
          </div>

          <!-- From -->
          <div class="space-y-3">
            <label
              class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
              >From</label
            >
            <button
              class="w-full flex items-center gap-3 p-3 bg-white/60 hover:bg-white/80 border border-white/60 rounded-xl transition-all group text-left shadow-sm ring-1 ring-primary/20 bg-primary/5"
            >
              <div
                class="size-12 rounded-xl bg-white text-primary border border-primary/10 shadow-sm flex items-center justify-center shrink-0"
              >
                <span class="material-symbols-outlined">savings</span>
              </div>
              <div class="flex-1 min-w-0">
                <span
                  class="block text-xs font-bold text-primary uppercase tracking-wide"
                  >Jago Pocket</span
                >
                <span
                  class="block text-sm font-mono font-bold text-slate-700 truncate"
                  >$2,450.50</span
                >
              </div>
              <span class="material-symbols-outlined text-primary shrink-0"
                >expand_more</span
              >
            </button>
          </div>

          <!-- To -->
          <div class="space-y-3">
            <label
              class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
              >To</label
            >
            <button
              class="w-full flex items-center gap-3 p-3 bg-white/60 hover:bg-white/80 border border-white/60 rounded-xl transition-all group text-left shadow-sm"
            >
              <div
                class="size-12 rounded-xl bg-white text-slate-400 border border-slate-100 shadow-sm flex items-center justify-center group-hover:text-primary group-hover:border-primary/20 transition-colors shrink-0"
              >
                <span class="material-symbols-outlined">account_balance</span>
              </div>
              <div class="flex-1 min-w-0">
                <span
                  class="block text-xs font-bold text-slate-500 uppercase tracking-wide"
                  >BCA Main</span
                >
                <span
                  class="block text-sm font-mono font-bold text-slate-700 truncate"
                  >Select...</span
                >
              </div>
              <span
                class="material-symbols-outlined text-slate-400 group-hover:text-primary shrink-0"
                >expand_more</span
              >
            </button>
          </div>
        </div>

        <!-- Date & Note -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="md:col-span-1 space-y-3">
            <label
              class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
              >Date</label
            >
            <div class="relative">
              <div
                class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
              >
                <span class="material-symbols-outlined text-slate-400"
                  >calendar_today</span
                >
              </div>
              <input
                class="block w-full pl-10 py-3 bg-white/60 border border-white/60 rounded-xl text-sm focus:ring-2 focus:ring-primary/30 focus:border-primary/50 shadow-sm text-slate-700 font-medium"
                type="text"
                value="Today, 16 Jan"
              />
            </div>
          </div>
          <div class="md:col-span-2 space-y-3">
            <label
              class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1"
              >Note</label
            >
            <textarea
              class="block w-full px-4 py-3 bg-white/60 border border-white/60 rounded-xl text-sm focus:ring-2 focus:ring-primary/30 focus:border-primary/50 shadow-sm placeholder-slate-400 text-slate-700 resize-none"
              placeholder="Purpose..."
              rows="1"></textarea>
          </div>
        </div>
      </div>

      <!-- Vibe Check (Common) -->
      <div class="space-y-4 pt-2">
        <label
          class="text-xs font-bold uppercase tracking-widest text-slate-400 pl-1 flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-sm">mood</span>
          Vibe Check
        </label>
        <div class="grid grid-cols-3 md:grid-cols-5 gap-3">
          <button
            class="mood-slang-btn px-2 py-3 rounded-xl bg-slate-100/50 hover:bg-rose-100 hover:text-rose-600 text-slate-500 text-xs font-extrabold border border-transparent hover:border-rose-200 transition-all duration-200 flex flex-col items-center gap-1 active text-rose-600 bg-rose-50 border-rose-200 shadow-sm"
          >
            <span class="text-lg">🛋️</span>
            MAGER
          </button>
          <button
            class="mood-slang-btn px-2 py-3 rounded-xl bg-slate-100/50 hover:bg-purple-100 hover:text-purple-600 text-slate-500 text-xs font-extrabold border border-transparent hover:border-purple-200 transition-all duration-200 flex flex-col items-center gap-1"
          >
            <span class="text-lg">😶‍🌫️</span>
            GABUT
          </button>
          <button
            class="mood-slang-btn px-2 py-3 rounded-xl bg-slate-100/50 hover:bg-teal-100 hover:text-teal-600 text-slate-500 text-xs font-extrabold border border-transparent hover:border-teal-200 transition-all duration-200 flex flex-col items-center gap-1"
          >
            <span class="text-lg">💆</span>
            HEALING
          </button>
          <button
            class="mood-slang-btn px-2 py-3 rounded-xl bg-slate-100/50 hover:bg-emerald-100 hover:text-emerald-600 text-slate-500 text-xs font-extrabold border border-transparent hover:border-emerald-200 transition-all duration-200 flex flex-col items-center gap-1"
          >
            <span class="text-lg">💸</span>
            CUAN
          </button>
          <button
            class="mood-slang-btn px-2 py-3 rounded-xl bg-slate-100/50 hover:bg-orange-100 hover:text-orange-600 text-slate-500 text-xs font-extrabold border border-transparent hover:border-orange-200 transition-all duration-200 flex flex-col items-center gap-1"
          >
            <span class="text-lg">🔥</span>
            HYPE
          </button>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="p-6 pt-4 border-t border-white/40 bg-white/40">
      <button
        id="btn-submit-transaction"
        class="w-full py-4 rounded-xl flux-gradient text-white font-bold text-lg shadow-lg hover:shadow-xl hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2"
      >
        <span class="material-symbols-outlined">check_circle</span>
        <span id="btn-submit-text">Record Transaction</span>
      </button>
    </div>
  </div>
</div>

<style>
  .wealth-wizard-overlay {
    background: rgba(250, 250, 249, 0.6);
    backdrop-filter: blur(12px);
  }
  .wizard-card {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .flux-gradient {
    background: linear-gradient(135deg, #22c3b6 0%, #a7f3d0 100%);
  }
  .mood-slang-btn.active {
    transform: scale(1.05);
    box-shadow: 0 0 15px currentColor;
  }
  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
</style>

<script>
  const modal = document.getElementById("transaction-modal");
  const backdrop = document.getElementById("transaction-modal-backdrop");
  const modalContent = document.querySelector(
    "#transaction-modal .wizard-card",
  ) as HTMLElement;
  const btnClose = document.getElementById("btn-close-transaction-modal");
  const btnSubmitText = document.getElementById("btn-submit-text");
  const modalTitle = document.getElementById("modal-title");
  const modalIcon = document.getElementById("modal-icon");

  const tabs = document.querySelectorAll(".tab-btn");
  const contents = document.querySelectorAll(".tab-content");

  // Tab Switching Logic
  function switchTab(tabName) {
    // 1. Update Buttons
    tabs.forEach((t) => {
      const btn = t as HTMLElement;
      if (btn.dataset.tab === tabName) {
        // Active Style
        if (tabName === "expense") {
          btn.className =
            "tab-btn flex-1 py-2 rounded-lg text-sm font-semibold transition-all bg-white text-rose-500 shadow-sm border border-black/5";
        } else if (tabName === "income") {
          btn.className =
            "tab-btn flex-1 py-2 rounded-lg text-sm font-semibold transition-all bg-white text-primary shadow-sm border border-black/5";
        } else if (tabName === "transfer") {
          btn.className =
            "tab-btn flex-1 py-2 rounded-lg text-sm font-semibold transition-all bg-white text-blue-500 shadow-sm border border-black/5";
        }
      } else {
        // Inactive Style
        btn.className =
          "tab-btn flex-1 py-2 rounded-lg text-sm font-semibold transition-all text-slate-500 hover:bg-white/50 hover:text-slate-700";
      }
    });

    // 2. Show Content
    contents.forEach((c) => {
      const content = c as HTMLElement;
      if (content.id === `form-${tabName}`) {
        content.classList.remove("hidden");
        content.classList.add("block");
      } else {
        content.classList.add("hidden");
        content.classList.remove("block");
      }
    });

    // 3. Update Text/Icons
    if (tabName === "expense") {
      if (modalTitle) modalTitle.innerText = "Add Expense";
      if (modalIcon) {
        modalIcon.innerText = "add_circle";
        modalIcon.className = "material-symbols-outlined text-rose-500";
      }
      if (btnSubmitText) btnSubmitText.innerText = "Record Expense";
    } else if (tabName === "income") {
      if (modalTitle) modalTitle.innerText = "Add Income";
      if (modalIcon) {
        modalIcon.innerText = "attach_money";
        modalIcon.className = "material-symbols-outlined text-primary";
      }
      if (btnSubmitText) btnSubmitText.innerText = "Record Income";
    } else if (tabName === "transfer") {
      if (modalTitle) modalTitle.innerText = "Transfer Funds";
      if (modalIcon) {
        modalIcon.innerText = "sync_alt";
        modalIcon.className = "material-symbols-outlined text-blue-500";
      }
      if (btnSubmitText) btnSubmitText.innerText = "Confirm Transfer";
    }
  }

  tabs.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tab = (btn as HTMLElement).dataset.tab;
      if (tab) switchTab(tab);
    });
  });

  // Modal Open/Close Logic
  function openModal() {
    if (modal) {
      modal.classList.remove("hidden");
      // Small delay to allow display:block to apply before opacity transition
      requestAnimationFrame(() => {
        modal.classList.remove("opacity-0");
        if (modalContent) {
          modalContent.classList.remove("scale-95", "opacity-0");
          modalContent.classList.add("scale-100", "opacity-100");
        }
      });
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add("opacity-0");
      if (modalContent) {
        modalContent.classList.remove("scale-100", "opacity-100");
        modalContent.classList.add("scale-95", "opacity-0");
      }
      setTimeout(() => {
        modal.classList.add("hidden");
      }, 300);
    }
  }

  if (btnClose) btnClose.addEventListener("click", closeModal);
  if (backdrop) backdrop.addEventListener("click", closeModal);

  // Listen for custom event 'open-transaction-modal'
  document.addEventListener("open-transaction-modal", () => {
    openModal();
  });

  // Expose to window for direct calls if needed
  (window as any).openTransactionModal = openModal;

  // Initialize Default Tab
  switchTab("expense");
</script>
