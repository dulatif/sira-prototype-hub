---

---

<div
  id="goal-create-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/20 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
  aria-hidden="true"
>
  <!-- Modal Content -->
  <div
    class="glass-modal w-full max-w-2xl rounded-[24px] overflow-hidden flex flex-col max-h-[90vh] transform scale-95 transition-transform duration-300"
  >
    <div
      class="flex items-center justify-between px-8 py-6 border-b border-[#e7f3f2]"
    >
      <div>
        <h2 class="text-2xl font-display font-bold text-[#0d1b1a]">
          Create New Path
        </h2>
        <p class="text-[#4c9a93] text-sm">
          Define your next financial milestone
        </p>
      </div>
      <button
        id="close-goal-modal"
        class="p-2 rounded-full hover:bg-black/5 text-[#4c9a93] transition-colors"
      >
        <span class="material-symbols-outlined">close</span>
      </button>
    </div>

    <div class="p-8 overflow-y-auto custom-scrollbar">
      <form class="space-y-8" onsubmit="event.preventDefault();">
        <div class="space-y-6">
          <div>
            <label
              class="block text-xs font-bold text-[#4c9a93] uppercase tracking-wider mb-2"
              >Path Name</label
            >
            <input
              class="w-full bg-white/50 border border-[#e7f3f2] focus:border-[#11d4c4]/50 focus:ring-4 focus:ring-[#11d4c4]/10 rounded-xl px-4 py-3 text-lg font-medium placeholder:text-[#4c9a93]/40 transition-all outline-none"
              placeholder="e.g. Dream Home, Tesla Model 3"
              type="text"
            />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                class="block text-xs font-bold text-[#4c9a93] uppercase tracking-wider mb-2"
                >Target Amount</label
              >
              <div class="relative">
                <span
                  class="absolute left-4 top-1/2 -translate-y-1/2 text-[#4c9a93] font-mono text-lg"
                  >$</span
                >
                <input
                  class="w-full bg-white/50 border border-[#e7f3f2] focus:border-[#11d4c4]/50 focus:ring-4 focus:ring-[#11d4c4]/10 rounded-xl pl-8 pr-4 py-3 font-mono text-2xl font-bold text-[#0d1b1a] placeholder:text-[#4c9a93]/40 transition-all outline-none"
                  placeholder="0.00"
                  type="text"
                />
              </div>
            </div>
            <div>
              <label
                class="block text-xs font-bold text-[#4c9a93] uppercase tracking-wider mb-2"
                >Target Date</label
              >
              <div class="relative">
                <span
                  class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-[#4c9a93]/70"
                  >calendar_today</span
                >
                <input
                  class="w-full bg-white/50 border border-[#e7f3f2] focus:border-[#11d4c4]/50 focus:ring-4 focus:ring-[#11d4c4]/10 rounded-xl pl-12 pr-4 py-3.5 font-medium text-[#0d1b1a] transition-all outline-none cursor-pointer"
                  type="date"
                />
              </div>
            </div>
          </div>
        </div>

        <div>
          <label
            class="block text-xs font-bold text-[#4c9a93] uppercase tracking-wider mb-3"
            >Visual Identity</label
          >
          <div class="flex gap-3 overflow-x-auto pb-2">
            <label class="cursor-pointer group">
              <input checked="" class="peer sr-only" name="icon" type="radio" />
              <div
                class="w-14 h-14 rounded-2xl border border-[#e7f3f2] bg-white flex items-center justify-center text-[#4c9a93] peer-checked:border-[#11d4c4] peer-checked:bg-[#11d4c4]/5 peer-checked:text-[#11d4c4] transition-all hover:border-[#11d4c4]/50 hover:shadow-sm"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><path
                    d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
              </div>
            </label>
            <label class="cursor-pointer group">
              <input class="peer sr-only" name="icon" type="radio" />
              <div
                class="w-14 h-14 rounded-2xl border border-[#e7f3f2] bg-white flex items-center justify-center text-[#4c9a93] peer-checked:border-[#11d4c4] peer-checked:bg-[#11d4c4]/5 peer-checked:text-[#11d4c4] transition-all hover:border-[#11d4c4]/50 hover:shadow-sm"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><path
                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
              </div>
            </label>
            <label class="cursor-pointer group">
              <input class="peer sr-only" name="icon" type="radio" />
              <div
                class="w-14 h-14 rounded-2xl border border-[#e7f3f2] bg-white flex items-center justify-center text-[#4c9a93] peer-checked:border-[#11d4c4] peer-checked:bg-[#11d4c4]/5 peer-checked:text-[#11d4c4] transition-all hover:border-[#11d4c4]/50 hover:shadow-sm"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><path
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
              </div>
            </label>
            <label class="cursor-pointer group">
              <input class="peer sr-only" name="icon" type="radio" />
              <div
                class="w-14 h-14 rounded-2xl border border-[#e7f3f2] bg-white flex items-center justify-center text-[#4c9a93] peer-checked:border-[#11d4c4] peer-checked:bg-[#11d4c4]/5 peer-checked:text-[#11d4c4] transition-all hover:border-[#11d4c4]/50 hover:shadow-sm"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><path
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
              </div>
            </label>
            <label class="cursor-pointer group">
              <input class="peer sr-only" name="icon" type="radio" />
              <div
                class="w-14 h-14 rounded-2xl border border-[#e7f3f2] bg-white flex items-center justify-center text-[#4c9a93] peer-checked:border-[#11d4c4] peer-checked:bg-[#11d4c4]/5 peer-checked:text-[#11d4c4] transition-all hover:border-[#11d4c4]/50 hover:shadow-sm"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  ><path
                    d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path></svg
                >
              </div>
            </label>
            <button
              class="w-14 h-14 rounded-2xl border border-dashed border-[#e7f3f2] bg-transparent flex items-center justify-center text-[#4c9a93]/50 hover:border-[#11d4c4]/50 hover:text-[#11d4c4] transition-all"
            >
              <span class="material-symbols-outlined">add</span>
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label
              class="block text-xs font-bold text-[#4c9a93] uppercase tracking-wider mb-2"
              >Funding Source</label
            >
            <div class="relative">
              <select
                class="w-full bg-white/50 border border-[#e7f3f2] focus:border-[#11d4c4]/50 focus:ring-4 focus:ring-[#11d4c4]/10 rounded-xl px-4 py-3 font-medium text-[#0d1b1a] appearance-none outline-none cursor-pointer"
              >
                <option>Main Checking (***4523)</option>
                <option>Savings Pocket</option>
                <option>External Transfer</option>
              </select>
              <span
                class="material-symbols-outlined absolute right-4 top-1/2 -translate-y-1/2 text-[#4c9a93] pointer-events-none"
                >expand_more</span
              >
            </div>
          </div>
          <div>
            <label
              class="block text-xs font-bold text-[#4c9a93] uppercase tracking-wider mb-2"
              >Automation</label
            >
            <div
              class="flex items-center justify-between bg-white/50 border border-[#e7f3f2] rounded-xl px-4 py-2.5"
            >
              <span class="text-sm font-medium text-[#0d1b1a]"
                >Auto-save Weekly</span
              >
              <label class="relative inline-flex items-center cursor-pointer">
                <input class="sr-only peer" type="checkbox" value="" />
                <div
                  class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[#11d4c4]"
                >
                </div>
              </label>
            </div>
          </div>
        </div>

        <div>
          <div class="flex justify-between items-center mb-4">
            <label
              class="text-xs font-bold text-[#4c9a93] uppercase tracking-wider"
              >Goal Vibe</label
            >
            <span
              class="text-xs font-bold text-[#11d4c4] bg-[#11d4c4]/10 px-2 py-0.5 rounded"
              >STEADY</span
            >
          </div>
          <div class="relative px-2">
            <input
              class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer"
              max="100"
              min="1"
              type="range"
              value="50"
            />
            <div
              class="flex justify-between text-[10px] font-bold text-[#4c9a93] uppercase mt-2 tracking-widest"
            >
              <span>Meager</span>
              <span>Balanced</span>
              <span>Hype</span>
            </div>
          </div>
        </div>
      </form>
    </div>

    <!-- Footer -->
    <div
      class="flex items-center justify-end gap-4 px-8 py-6 border-t border-[#e7f3f2] bg-white/40"
    >
      <button
        id="cancel-goal-modal"
        class="px-6 py-3 rounded-xl text-sm font-bold text-[#4c9a93] hover:text-[#0d1b1a] hover:bg-black/5 transition-all"
        >Cancel</button
      >
      <button
        class="px-8 py-3 rounded-xl flux-button text-white text-sm font-bold shadow-lg shadow-[#11d4c4]/30 hover:shadow-[#11d4c4]/50 hover:scale-[1.02] transition-all flex items-center gap-2"
      >
        <span>Start Journey</span>
        <span class="material-symbols-outlined text-lg">arrow_forward</span>
      </button>
    </div>
  </div>
</div>

<style>
  .glass-modal {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 25px 50px -12px rgba(17, 212, 196, 0.15);
  }
  .flux-button {
    background: linear-gradient(135deg, #11d4c4 0%, #0ca89b 100%);
  }
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    height: 20px;
    width: 20px;
    border-radius: 50%;
    background: #11d4c4;
    margin-top: -6px; /* Adjusted alignment */
    box-shadow: 0 0 10px rgba(17, 212, 196, 0.4);
    cursor: pointer;
  }
  input[type="range"]::-webkit-slider-runnable-track {
    width: 100%;
    height: 8px; /* Adjusted height */
    cursor: pointer;
    background: #e7f3f2;
    border-radius: 4px; /* Adjusted radius */
  }
</style>

<script>
  const modal = document.getElementById("goal-create-modal");
  const modalContent = modal?.querySelector(".glass-modal");
  const closeBtn = document.getElementById("close-goal-modal");
  const cancelBtn = document.getElementById("cancel-goal-modal");

  function openModal() {
    if (modal) {
      modal.classList.remove("opacity-0", "pointer-events-none");
      if (modalContent) {
        modalContent.classList.remove("scale-95");
        modalContent.classList.add("scale-100");
      }
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add("opacity-0", "pointer-events-none");
      if (modalContent) {
        modalContent.classList.remove("scale-100");
        modalContent.classList.add("scale-95");
      }
    }
  }

  // Listen for custom event
  document.addEventListener("open-goal-modal", openModal);

  closeBtn?.addEventListener("click", closeModal);
  cancelBtn?.addEventListener("click", closeModal);

  // Close on backdrop click
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });
</script>
