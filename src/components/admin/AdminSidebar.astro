---

---

<aside
  class="w-72 h-full flex flex-col glass-sidebar z-20 shrink-0 relative transition-all duration-300"
>
  <div class="p-6 flex items-center gap-3 mb-2">
    <div
      class="size-10 rounded-xl bg-gradient-to-br from-primary to-teal-600 shadow-lg shadow-primary/20 flex items-center justify-center text-white"
    >
      <span class="material-symbols-outlined text-[24px]">token</span>
    </div>
    <div>
      <h1 class="text-lg font-bold tracking-tight text-text-main">
        Sira Admin
      </h1>
      <p class="text-xs text-text-muted font-medium">Super Admin Access</p>
    </div>
  </div>
  <nav class="flex-1 px-4 space-y-1 overflow-y-auto">
    <div
      class="text-xs font-bold text-text-muted uppercase tracking-wider px-4 py-2 mt-4"
    >
      Main Menu
    </div>
    <a
      class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-muted hover:bg-primary/10 hover:text-primary transition-colors group"
      href="/admin"
    >
      <span
        class="material-symbols-outlined group-hover:scale-110 transition-transform"
        >dashboard</span
      >
      <span class="font-medium">Dashboard</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-muted hover:bg-primary/10 hover:text-primary transition-colors group"
      href="/admin/icons"
    >
      <span
        class="material-symbols-outlined group-hover:scale-110 transition-transform"
        >stars</span
      >
      <span class="font-medium">Icon Governance</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-muted hover:bg-primary/10 hover:text-primary transition-colors group"
      href="/admin/providers"
    >
      <span
        class="material-symbols-outlined group-hover:scale-110 transition-transform"
        >account_balance</span
      >
      <span class="font-medium">Provider Management</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-muted hover:bg-primary/10 hover:text-primary transition-colors group"
      href="/admin/categories"
    >
      <span
        class="material-symbols-outlined group-hover:scale-110 transition-transform"
        >category</span
      >
      <span class="font-medium">Category Governance</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-muted hover:bg-primary/10 hover:text-primary transition-colors group"
      href="/admin/users"
    >
      <span
        class="material-symbols-outlined group-hover:scale-110 transition-transform"
        >group</span
      >
      <span class="font-medium">User Management</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-muted hover:bg-primary/10 hover:text-primary transition-colors group"
      href="/admin/support"
    >
      <span
        class="material-symbols-outlined group-hover:scale-110 transition-transform"
        >support_agent</span
      >
      <span class="font-medium">Support Tickets</span>
    </a>

    <div
      class="text-xs font-bold text-text-muted uppercase tracking-wider px-4 py-2 mt-6"
    >
      Settings
    </div>
    <a
      class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-muted hover:bg-primary/10 hover:text-primary transition-colors group"
      href="#"
    >
      <span
        class="material-symbols-outlined group-hover:scale-110 transition-transform"
        >shield</span
      >
      <span class="font-medium">Security</span>
    </a>
    <a
      class="flex items-center gap-3 px-4 py-3 rounded-xl text-text-muted hover:bg-primary/10 hover:text-primary transition-colors group"
      href="#"
    >
      <span
        class="material-symbols-outlined group-hover:scale-110 transition-transform"
        >settings</span
      >
      <span class="font-medium">Preferences</span>
    </a>
  </nav>
  <div class="p-4 border-t border-gray-200/50">
    <div
      class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/50 transition-colors cursor-pointer border border-transparent hover:border-gray-200/50"
    >
      <div
        class="size-10 rounded-full bg-primary/20 flex items-center justify-center border border-primary/30"
        title="Marcus Reiner"
      >
        <span class="text-xs font-bold text-primary">MR</span>
      </div>
      <div class="flex flex-col overflow-hidden">
        <span class="text-sm font-bold text-text-main truncate"
          >Marcus Reiner</span
        >
        <span class="text-xs text-text-muted truncate">marcus@sira.io</span>
      </div>
      <button class="ml-auto text-text-muted hover:text-text-main">
        <span class="material-symbols-outlined text-[20px]">logout</span>
      </button>
    </div>
  </div>
</aside>
