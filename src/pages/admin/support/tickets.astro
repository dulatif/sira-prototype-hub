---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Support Tickets">
  <div class="flex flex-col gap-6 h-full min-h-0">
    <!-- Toolbar -->
    <div class="flex items-center justify-between shrink-0">
      <h2 class="text-2xl font-bold text-text-main leading-tight hidden">
        Support Tickets
      </h2>
      <div class="flex items-center gap-4 w-full">
        <div class="relative group w-72">
          <div
            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
          >
            <span
              class="material-symbols-outlined text-text-muted group-focus-within:text-primary transition-colors text-[20px]"
              >search</span
            >
          </div>
          <input
            class="block w-full pl-10 pr-3 py-2.5 border-none rounded-xl leading-5 bg-white/50 text-text-main placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-primary/50 focus:bg-white shadow-inner transition-all font-medium sm:text-sm"
            placeholder="Search tickets by ID, user or subject..."
            type="text"
          />
        </div>
        <!-- Kanban/List Toggle -->
        <div
          class="bg-white/50 rounded-xl p-1 shadow-sm border border-white/60 flex items-center ml-auto"
        >
          <a
            href="/admin/support"
            class="p-1.5 rounded-lg text-text-muted hover:text-text-main hover:bg-white/50 transition-colors"
          >
            <span class="material-symbols-outlined text-[20px]"
              >view_kanban</span
            >
          </a>
          <a
            href="/admin/support/tickets"
            class="p-1.5 rounded-lg bg-white shadow-sm text-primary"
          >
            <span class="material-symbols-outlined text-[20px]"
              >splitscreen</span
            >
          </a>
          <a
            href="/admin/support/list"
            class="p-1.5 rounded-lg text-text-muted hover:text-text-main hover:bg-white/50 transition-colors"
          >
            <span class="material-symbols-outlined text-[20px]"
              >table_chart</span
            >
          </a>
        </div>
      </div>
    </div>

    <!-- Split Layout -->
    <div class="flex gap-6 h-full min-h-0">
      <!-- Left Column: Active Tickets List (2/3) -->
      <div class="w-2/3 flex flex-col min-h-0">
        <div
          class="glass-panel rounded-xl flex flex-col h-full overflow-hidden shadow-sm"
        >
          <div
            class="p-5 border-b border-gray-200/60 bg-white/40 flex items-center justify-between sticky top-0 backdrop-blur-md z-10"
          >
            <h3
              class="font-bold text-lg text-text-main flex items-center gap-3"
            >
              <span
                class="material-symbols-outlined text-primary bg-primary/10 p-1.5 rounded-lg"
                >list_alt</span
              >
              Active Tickets
            </h3>
            <button
              class="text-xs font-bold text-primary hover:text-primary-dark transition-colors flex items-center gap-1"
            >
              <span class="material-symbols-outlined text-[16px]">refresh</span>
              Refresh List
            </button>
          </div>
          <div class="flex-1 overflow-y-auto">
            <table class="w-full text-left border-collapse">
              <thead
                class="bg-white/40 sticky top-0 backdrop-blur-sm z-10 text-xs uppercase tracking-wider text-text-muted font-bold"
              >
                <tr>
                  <th class="px-6 py-3 border-b border-gray-200/50"
                    >Ticket ID</th
                  >
                  <th class="px-6 py-3 border-b border-gray-200/50">User</th>
                  <th class="px-6 py-3 border-b border-gray-200/50">Subject</th>
                  <th class="px-6 py-3 border-b border-gray-200/50">Created</th>
                  <th class="px-6 py-3 border-b border-gray-200/50">Priority</th
                  >
                  <th class="px-6 py-3 border-b border-gray-200/50">Status</th>
                </tr>
              </thead>
              <tbody class="text-sm divide-y divide-gray-100">
                <!-- Ticket 1 -->
                <tr
                  class="bg-primary/5 hover:bg-primary/10 transition-colors cursor-pointer group border-l-4 border-primary"
                >
                  <td class="px-6 py-4 font-mono text-text-main font-medium"
                    >#TKT-9204</td
                  >
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-2">
                      <div
                        class="size-6 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-[10px] font-bold"
                      >
                        JD
                      </div>
                      <span class="font-medium text-text-main">John Doe</span>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-text-main font-medium"
                    >Transaction failed on checkout</td
                  >
                  <td class="px-6 py-4 text-text-muted">10 mins ago</td>
                  <td class="px-6 py-4">
                    <span
                      class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-red-100 text-status-red border border-red-200"
                      >Critical</span
                    >
                  </td>
                  <td class="px-6 py-4">
                    <div
                      class="flex items-center gap-1.5 text-status-green font-bold text-xs"
                    >
                      <span
                        class="w-1.5 h-1.5 rounded-full bg-status-green animate-pulse"
                      ></span>
                      Open
                    </div>
                  </td>
                </tr>
                <!-- Ticket 2 -->
                <tr
                  class="hover:bg-white/40 transition-colors cursor-pointer border-l-4 border-transparent"
                >
                  <td class="px-6 py-4 font-mono text-text-muted">#TKT-9203</td>
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-2">
                      <div
                        class="size-6 rounded-full bg-orange-50 border border-orange-200 flex items-center justify-center text-[8px] font-bold text-orange-600"
                      >
                        SS
                      </div>
                      <span class="font-medium text-text-main">Sarah Smith</span
                      >
                    </div>
                  </td>
                  <td class="px-6 py-4 text-text-main"
                    >Account verification pending</td
                  >
                  <td class="px-6 py-4 text-text-muted">1 hr ago</td>
                  <td class="px-6 py-4">
                    <span
                      class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-orange-100 text-orange-700 border border-orange-200"
                      >High</span
                    >
                  </td>
                  <td class="px-6 py-4">
                    <div
                      class="flex items-center gap-1.5 text-yellow-600 font-bold text-xs"
                    >
                      <span class="w-1.5 h-1.5 rounded-full bg-yellow-500"
                      ></span>
                      Pending
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
            <div
              class="p-3 bg-white/40 border-t border-gray-200/50 flex justify-center"
            >
              <button
                class="text-xs font-semibold text-text-muted hover:text-primary transition-colors"
                >Load more tickets</button
              >
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Detail View (1/3) -->
      <div class="w-1/3 flex flex-col min-h-0">
        <div
          class="glass-panel rounded-xl flex flex-col h-full overflow-hidden shadow-lg border-l border-white/80"
        >
          <div
            class="p-5 border-b border-gray-200/60 bg-white/60 backdrop-blur-md"
          >
            <div class="flex justify-between items-start mb-3">
              <span
                class="font-mono text-xs font-bold text-text-muted bg-gray-100 px-2 py-1 rounded"
                >#TKT-9204</span
              >
              <div class="flex gap-2">
                <span
                  class="material-symbols-outlined text-text-muted text-[18px] cursor-pointer hover:text-primary"
                  >open_in_new</span
                >
                <span
                  class="material-symbols-outlined text-text-muted text-[18px] cursor-pointer hover:text-primary"
                  >more_horiz</span
                >
              </div>
            </div>
            <h2 class="text-xl font-bold text-text-main mb-2 leading-tight">
              Transaction failed on checkout
            </h2>
            <div class="flex items-center gap-3 mt-3">
              <div
                class="size-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xs font-bold border border-white shadow-sm"
              >
                JD
              </div>
              <div>
                <div class="text-sm font-bold text-text-main">John Doe</div>
                <div class="text-[10px] text-text-muted">
                  user_id: 8821 • Premium Plan
                </div>
              </div>
            </div>
          </div>
          <div class="flex-1 overflow-y-auto p-5 space-y-6 bg-white/20">
            <!-- Chat Message 1 -->
            <div class="flex gap-3">
              <div
                class="size-8 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center text-xs font-bold shrink-0 mt-1"
              >
                JD
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold text-text-main">John Doe</span>
                  <span class="text-[10px] text-text-muted">10:42 AM</span>
                </div>
                <div
                  class="bg-white p-3 rounded-2xl rounded-tl-none shadow-sm border border-gray-100 text-sm text-text-main leading-relaxed"
                >
                  I tried to purchase the enterprise plan using my VISA card
                  ending in 4242, but I keep getting a generic "Error 500"
                  message. I've tried twice now. Please help as I need to deploy
                  today.
                </div>
              </div>
            </div>
            <!-- Chat Message 2 -->
            <div class="flex gap-3">
              <div
                class="size-8 rounded-full bg-yellow-100 text-yellow-700 flex items-center justify-center shrink-0 mt-1 border border-yellow-200"
              >
                <span class="material-symbols-outlined text-[16px]">lock</span>
              </div>
              <div class="flex-1">
                <div class="flex items-center justify-between mb-1">
                  <span
                    class="text-xs font-bold text-yellow-700 uppercase tracking-wider"
                    >Internal Note</span
                  >
                  <span class="text-[10px] text-text-muted">10:45 AM</span>
                </div>
                <div
                  class="bg-yellow-50/80 p-3 rounded-2xl rounded-tl-none border border-yellow-100 text-sm text-text-muted leading-relaxed italic"
                >
                  System logs show a timeout from the payment gateway provider.
                  It might be a momentary glitch on their end. Checking Stripe
                  status now.
                  <br class="block mt-1" /><span
                    class="font-semibold not-italic text-xs text-text-main"
                    >- Marcus Reiner</span
                  >
                </div>
              </div>
            </div>
          </div>
          <div
            class="p-5 bg-white/60 border-t border-gray-200/60 backdrop-blur-md z-20"
          >
            <textarea
              class="w-full h-24 bg-white border border-gray-200 rounded-xl p-3 text-sm focus:ring-2 focus:ring-primary/30 focus:border-primary transition-all resize-none shadow-inner mb-2 placeholder:text-gray-400"
              placeholder="Type your response here..."></textarea>
            <div class="flex gap-2">
              <button
                class="flex-1 bg-gradient-to-br from-primary to-teal-600 hover:bg-primary-dark text-white py-2.5 rounded-lg shadow-lg shadow-primary/20 transition-all hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-2 font-semibold text-sm"
              >
                <span class="material-symbols-outlined text-[18px]">send</span>
                Send
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
