---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="User Management">
  <div
    class="glass-panel rounded-xl flex flex-col overflow-hidden min-h-[500px]"
  >
    <!-- Filters -->
    <div
      class="p-4 border-b border-gray-200/60 bg-white/30 flex flex-wrap items-center gap-3"
    >
      <button
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-sm font-medium hover:border-primary hover:text-primary transition-colors shadow-sm"
      >
        <span class="material-symbols-outlined text-[18px]">filter_list</span>
        All Filters
      </button>
      <div class="h-6 w-px bg-gray-300 mx-1"></div>
      <div class="relative group">
        <select
          class="appearance-none bg-white border border-gray-200 text-text-main text-sm rounded-lg focus:ring-primary focus:border-primary block w-full pl-3 pr-8 py-1.5 shadow-sm cursor-pointer hover:border-gray-300"
        >
          <option>Tier: All</option>
          <option>Premium</option>
          <option>Free</option>
        </select>
        <div
          class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500"
        >
          <span class="material-symbols-outlined text-[18px]">expand_more</span>
        </div>
      </div>
      <div class="relative group">
        <select
          class="appearance-none bg-white border border-gray-200 text-text-main text-sm rounded-lg focus:ring-primary focus:border-primary block w-full pl-3 pr-8 py-1.5 shadow-sm cursor-pointer hover:border-gray-300"
        >
          <option>Status: All</option>
          <option>Active</option>
          <option>Suspended</option>
          <option>Flagged</option>
        </select>
        <div
          class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500"
        >
          <span class="material-symbols-outlined text-[18px]">expand_more</span>
        </div>
      </div>
      <div class="relative group">
        <select
          class="appearance-none bg-white border border-gray-200 text-text-main text-sm rounded-lg focus:ring-primary focus:border-primary block w-full pl-3 pr-8 py-1.5 shadow-sm cursor-pointer hover:border-gray-300"
        >
          <option>Region: Global</option>
          <option>North America</option>
          <option>Europe</option>
          <option>Asia Pacific</option>
        </select>
        <div
          class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-500"
        >
          <span class="material-symbols-outlined text-[18px]">expand_more</span>
        </div>
      </div>
      <div class="ml-auto flex gap-2">
        <button
          class="text-text-muted hover:text-primary p-1.5 rounded-lg hover:bg-primary/10 transition-colors"
        >
          <span class="material-symbols-outlined text-[20px]">refresh</span>
        </button>
        <button
          class="text-text-muted hover:text-primary p-1.5 rounded-lg hover:bg-primary/10 transition-colors"
        >
          <span class="material-symbols-outlined text-[20px]">download</span>
        </button>
      </div>
    </div>

    <!-- Table Content -->
    <div class="overflow-x-auto flex-1">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr
            class="bg-gray-50/50 text-xs font-semibold text-text-muted uppercase tracking-wider border-b border-gray-200/60"
          >
            <th class="px-6 py-4 w-12">
              <input
                class="rounded border-gray-300 text-primary focus:ring-primary/20 cursor-pointer"
                type="checkbox"
              />
            </th>
            <th class="px-6 py-4">User</th>
            <th class="px-6 py-4">Joined Date</th>
            <th class="px-6 py-4">Tier</th>
            <th class="px-6 py-4">Last Active</th>
            <th class="px-6 py-4 font-mono">Total Assets</th>
            <th class="px-6 py-4">Status</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <!-- Row 1 -->
          <tr
            class="hover:bg-primary/5 transition-colors group cursor-pointer"
            onclick="window.location.href='/admin/users/1'"
          >
            <td class="px-6 py-4" onclick="event.stopPropagation()">
              <input
                class="rounded border-gray-300 text-primary focus:ring-primary/20 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity"
                type="checkbox"
              />
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div
                  class="size-10 rounded-full bg-indigo-50 border border-indigo-200 flex items-center justify-center text-indigo-600 font-bold"
                >
                  AC
                </div>
                <div>
                  <div class="font-bold text-text-main">Alice Chen</div>
                  <div class="text-xs text-text-muted font-mono">
                    ID: 839201
                  </div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 text-sm text-text-muted font-medium"
              >Oct 24, 2023</td
            >
            <td class="px-6 py-4">
              <span
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-yellow-100/50 text-yellow-700 border border-yellow-200"
              >
                <span
                  class="material-symbols-outlined text-[14px] text-status-gold"
                  >stars</span
                > Premium
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-text-muted">2 hours ago</td>
            <td class="px-6 py-4 font-mono font-medium text-text-main"
              >$12,450.00</td
            >
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                <span class="relative flex h-2.5 w-2.5">
                  <span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                  ></span>
                  <span
                    class="relative inline-flex rounded-full h-2.5 w-2.5 bg-status-green"
                  ></span>
                </span>
                <span class="text-sm font-medium text-text-main">Active</span>
              </div>
            </td>
            <td class="px-6 py-4 text-right" onclick="event.stopPropagation()">
              <button
                class="text-text-muted hover:text-primary hover:bg-primary/10 p-2 rounded-full transition-all"
              >
                <span class="material-symbols-outlined">more_horiz</span>
              </button>
            </td>
          </tr>
          <!-- Row 2 -->
          <tr
            class="hover:bg-primary/5 transition-colors group cursor-pointer"
            onclick="window.location.href='/admin/users/2'"
          >
            <td class="px-6 py-4" onclick="event.stopPropagation()">
              <input
                class="rounded border-gray-300 text-primary focus:ring-primary/20 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity"
                type="checkbox"
              />
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div
                  class="size-10 rounded-full bg-gray-200 flex items-center justify-center text-gray-500 font-bold border border-white"
                >
                  BS
                </div>
                <div>
                  <div class="font-bold text-text-main">Bob Smith</div>
                  <div class="text-xs text-text-muted font-mono">
                    ID: 110293
                  </div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 text-sm text-text-muted font-medium"
              >Sep 12, 2023</td
            >
            <td class="px-6 py-4">
              <span
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600 border border-gray-200"
              >
                Free
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-text-muted">1 day ago</td>
            <td class="px-6 py-4 font-mono font-medium text-text-main"
              >$450.00</td
            >
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-status-green"></span>
                <span class="text-sm font-medium text-text-main">Active</span>
              </div>
            </td>
            <td class="px-6 py-4 text-right" onclick="event.stopPropagation()">
              <button
                class="text-text-muted hover:text-primary hover:bg-primary/10 p-2 rounded-full transition-all"
              >
                <span class="material-symbols-outlined">more_horiz</span>
              </button>
            </td>
          </tr>
          <!-- Row 3 -->
          <tr
            class="hover:bg-primary/5 transition-colors group bg-red-50/30 cursor-pointer"
            onclick="window.location.href='/admin/users/4'"
          >
            <td class="px-6 py-4" onclick="event.stopPropagation()">
              <input
                class="rounded border-gray-300 text-primary focus:ring-primary/20 cursor-pointer opacity-0 group-hover:opacity-100 transition-opacity"
                type="checkbox"
              />
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div
                  class="size-10 rounded-full bg-red-100 flex items-center justify-center text-status-red font-bold border border-white"
                >
                  DW
                </div>
                <div>
                  <div class="font-bold text-text-main">Dana White</div>
                  <div class="text-xs text-text-muted font-mono">
                    ID: 405912
                  </div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 text-sm text-text-muted font-medium"
              >Aug 15, 2023</td
            >
            <td class="px-6 py-4">
              <span
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-600 border border-gray-200"
              >
                Free
              </span>
            </td>
            <td class="px-6 py-4 text-sm text-text-muted">3 weeks ago</td>
            <td class="px-6 py-4 font-mono font-medium text-text-main">$0.00</td
            >
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-status-red"></span>
                <span class="text-sm font-medium text-status-red"
                  >Suspended</span
                >
              </div>
            </td>
            <td class="px-6 py-4 text-right" onclick="event.stopPropagation()">
              <button
                class="text-status-red hover:bg-red-100/50 p-2 rounded-full transition-all"
              >
                <span class="material-symbols-outlined">warning</span>
              </button>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div
      class="p-4 border-t border-gray-200/60 flex items-center justify-between bg-white/30 text-xs text-text-muted font-medium"
    >
      <div>Showing 1-10 of 84,291 users</div>
      <div class="flex items-center gap-2">
        <button
          class="p-1 rounded hover:bg-white hover:text-primary hover:shadow-sm disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span class="material-symbols-outlined">chevron_left</span>
        </button>
        <button
          class="px-2 py-1 rounded bg-white text-primary shadow-sm border border-gray-100"
          >1</button
        >
        <button class="px-2 py-1 rounded hover:bg-white/50">2</button>
        <button class="px-2 py-1 rounded hover:bg-white/50">3</button>
        <span class="px-1">...</span>
        <button class="px-2 py-1 rounded hover:bg-white/50">843</button>
        <button
          class="p-1 rounded hover:bg-white hover:text-primary hover:shadow-sm"
        >
          <span class="material-symbols-outlined">chevron_right</span>
        </button>
      </div>
    </div>
  </div>
</AdminLayout>
