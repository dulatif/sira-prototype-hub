---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Icon Governance">
  <div class="flex flex-col h-full gap-6">
    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 shrink-0">
      <div
        class="glass-panel p-5 rounded-2xl flex items-center justify-between group"
      >
        <div>
          <p
            class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1"
          >
            Total Icons
          </p>
          <h3 class="text-2xl font-extrabold text-slate-800 dark:text-white">
            8,432
          </h3>
        </div>
        <div
          class="size-10 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-400 group-hover:text-primary group-hover:bg-primary/10 transition-colors flex items-center justify-center"
        >
          <span class="material-symbols-outlined">grid_view</span>
        </div>
      </div>
      <div
        class="glass-panel p-5 rounded-2xl flex items-center justify-between group"
      >
        <div>
          <p
            class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1"
          >
            Active in Categories
          </p>
          <h3 class="text-2xl font-extrabold text-slate-800 dark:text-white">
            6,201
          </h3>
        </div>
        <div
          class="size-10 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-400 group-hover:text-emerald-500 group-hover:bg-emerald-500/10 transition-colors flex items-center justify-center"
        >
          <span class="material-symbols-outlined">check_circle</span>
        </div>
      </div>
      <div
        class="glass-panel p-5 rounded-2xl flex items-center justify-between group"
      >
        <div>
          <p
            class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1"
          >
            Recently Added
          </p>
          <div class="flex items-center gap-2">
            <h3 class="text-2xl font-extrabold text-slate-800 dark:text-white">
              24
            </h3>
            <span
              class="text-[10px] font-bold text-emerald-500 bg-emerald-50 dark:bg-emerald-900/20 px-1.5 py-0.5 rounded"
              >+12 today</span
            >
          </div>
        </div>
        <div
          class="size-10 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-400 group-hover:text-blue-500 group-hover:bg-blue-500/10 transition-colors flex items-center justify-center"
        >
          <span class="material-symbols-outlined">schedule</span>
        </div>
      </div>
      <div
        class="glass-panel p-5 rounded-2xl flex items-center justify-between group"
      >
        <div>
          <p
            class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1"
          >
            Unused Icons
          </p>
          <h3 class="text-2xl font-extrabold text-slate-800 dark:text-white">
            512
          </h3>
        </div>
        <div
          class="size-10 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-400 group-hover:text-amber-500 group-hover:bg-amber-500/10 transition-colors flex items-center justify-center"
        >
          <span class="material-symbols-outlined">warning</span>
        </div>
      </div>
    </div>

    <!-- Main Content Split Pane -->
    <div
      class="glass-panel rounded-3xl flex-1 flex min-h-0 relative overflow-hidden shadow-glass dark:shadow-glass-dark border border-white/60 dark:border-slate-800"
    >
      <!-- Blobs (Scoped to this container) -->
      <div
        class="absolute top-0 right-0 w-[600px] h-[600px] bg-primary/5 rounded-full blur-[120px] pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-0 left-20 w-[400px] h-[400px] bg-blue-500/5 rounded-full blur-[100px] pointer-events-none"
      >
      </div>

      <!-- Icon Grid Section -->
      <div
        class="flex-1 flex flex-col min-w-0 z-10 relative bg-white/30 dark:bg-surface-dark/30 backdrop-blur-sm"
      >
        <div
          class="px-6 py-4 border-b border-slate-200/50 dark:border-slate-700/50 flex items-center justify-between bg-white/40 dark:bg-surface-dark/40 backdrop-blur-sm sticky top-0 z-20"
        >
          <div class="flex items-center gap-2">
            <button
              class="px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-700 dark:text-slate-300 shadow-sm hover:border-primary transition-all"
              >All Icons</button
            >
            <button
              class="px-3 py-1.5 rounded-lg hover:bg-white/50 dark:hover:bg-slate-800/50 border border-transparent text-xs font-bold text-slate-500 hover:text-slate-700 transition-all"
              >Outlined</button
            >
            <button
              class="px-3 py-1.5 rounded-lg hover:bg-white/50 dark:hover:bg-slate-800/50 border border-transparent text-xs font-bold text-slate-500 hover:text-slate-700 transition-all"
              >Solid</button
            >
            <button
              class="px-3 py-1.5 rounded-lg hover:bg-white/50 dark:hover:bg-slate-800/50 border border-transparent text-xs font-bold text-slate-500 hover:text-slate-700 transition-all"
              >Duotone</button
            >
          </div>
          <div class="flex items-center gap-2">
            <button
              class="size-8 flex items-center justify-center rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500"
            >
              <span class="material-symbols-outlined text-lg">sort</span>
            </button>
            <button
              class="size-8 flex items-center justify-center rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-500"
            >
              <span class="material-symbols-outlined text-lg">filter_list</span>
            </button>
          </div>
        </div>

        <div class="flex-1 overflow-y-auto p-6 custom-scrollbar">
          <div
            class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-4"
          >
            <!-- Icon Card 1 -->
            <div
              class="group relative flex flex-col items-center p-4 rounded-xl bg-primary/5 border-2 border-primary/30 transition-all cursor-pointer ring-4 ring-primary/10"
            >
              <div
                class="text-slate-800 dark:text-white mb-4 transition-transform group-hover:scale-110 duration-200"
              >
                <span class="material-symbols-outlined text-4xl">coffee</span>
              </div>
              <div class="w-full flex items-center justify-between">
                <span
                  class="text-xs font-bold text-slate-700 dark:text-slate-200 truncate"
                  >Coffee-01</span
                >
                <span
                  class="px-1.5 py-0.5 rounded-md bg-white dark:bg-slate-800 text-[10px] font-mono font-bold text-primary border border-primary/20"
                  >42</span
                >
              </div>
              <div
                class="absolute inset-0 bg-white/90 dark:bg-slate-900/90 backdrop-blur-[2px] rounded-xl flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity z-10"
              >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-primary hover:border-primary transition-colors"
                  title="Edit Metadata"
                  ><span class="material-symbols-outlined text-sm">edit</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-blue-500 hover:border-blue-500 transition-colors"
                  title="Replace SVG"
                  ><span class="material-symbols-outlined text-sm"
                    >autorenew</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-red-500 hover:border-red-500 transition-colors"
                  title="Delete"
                  ><span class="material-symbols-outlined text-sm">delete</span
                  ></button
                >
              </div>
            </div>

            <!-- Icon Card 2 -->
            <div
              class="group relative flex flex-col items-center p-4 rounded-xl bg-white/60 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5 transition-all cursor-pointer"
            >
              <div
                class="text-slate-600 dark:text-slate-400 mb-4 transition-transform group-hover:scale-110 duration-200"
              >
                <span class="material-symbols-outlined text-4xl">home</span>
              </div>
              <div class="w-full flex items-center justify-between">
                <span
                  class="text-xs font-bold text-slate-600 dark:text-slate-400 truncate"
                  >Home-Basic</span
                >
                <span
                  class="px-1.5 py-0.5 rounded-md bg-slate-200 dark:bg-slate-700 text-[10px] font-mono text-slate-500"
                  >128</span
                >
              </div>
              <div
                class="absolute inset-0 bg-white/90 dark:bg-slate-900/90 backdrop-blur-[2px] rounded-xl flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity z-10"
              >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-primary hover:border-primary transition-colors"
                  ><span class="material-symbols-outlined text-sm">edit</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-blue-500 hover:border-blue-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm"
                    >autorenew</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-red-500 hover:border-red-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm">delete</span
                  ></button
                >
              </div>
            </div>

            <!-- Icon Card 3 (Settings) -->
            <div
              class="group relative flex flex-col items-center p-4 rounded-xl bg-white/60 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5 transition-all cursor-pointer"
            >
              <div
                class="text-slate-600 dark:text-slate-400 mb-4 transition-transform group-hover:scale-110 duration-200"
              >
                <span class="material-symbols-outlined text-4xl">settings</span>
              </div>
              <div class="w-full flex items-center justify-between">
                <span
                  class="text-xs font-bold text-slate-600 dark:text-slate-400 truncate"
                  >Settings-V1</span
                >
                <span
                  class="px-1.5 py-0.5 rounded-md bg-slate-200 dark:bg-slate-700 text-[10px] font-mono text-slate-500"
                  >89</span
                >
              </div>
              <div
                class="absolute inset-0 bg-white/90 dark:bg-slate-900/90 backdrop-blur-[2px] rounded-xl flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity z-10"
              >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-primary hover:border-primary transition-colors"
                  ><span class="material-symbols-outlined text-sm">edit</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-blue-500 hover:border-blue-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm"
                    >autorenew</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-red-500 hover:border-red-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm">delete</span
                  ></button
                >
              </div>
            </div>

            <!-- Icon Card 4 (Search) -->
            <div
              class="group relative flex flex-col items-center p-4 rounded-xl bg-white/60 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5 transition-all cursor-pointer"
            >
              <div
                class="text-slate-600 dark:text-slate-400 mb-4 transition-transform group-hover:scale-110 duration-200"
              >
                <span class="material-symbols-outlined text-4xl">search</span>
              </div>
              <div class="w-full flex items-center justify-between">
                <span
                  class="text-xs font-bold text-slate-600 dark:text-slate-400 truncate"
                  >Search-Mag</span
                >
                <span
                  class="px-1.5 py-0.5 rounded-md bg-slate-200 dark:bg-slate-700 text-[10px] font-mono text-slate-500"
                  >215</span
                >
              </div>
              <div
                class="absolute inset-0 bg-white/90 dark:bg-slate-900/90 backdrop-blur-[2px] rounded-xl flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity z-10"
              >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-primary hover:border-primary transition-colors"
                  ><span class="material-symbols-outlined text-sm">edit</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-blue-500 hover:border-blue-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm"
                    >autorenew</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-red-500 hover:border-red-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm">delete</span
                  ></button
                >
              </div>
            </div>

            <!-- Icon Card 5 (Bell) -->
            <div
              class="group relative flex flex-col items-center p-4 rounded-xl bg-white/60 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5 transition-all cursor-pointer"
            >
              <div
                class="text-slate-600 dark:text-slate-400 mb-4 transition-transform group-hover:scale-110 duration-200"
              >
                <span class="material-symbols-outlined text-4xl"
                  >notifications</span
                >
              </div>
              <div class="w-full flex items-center justify-between">
                <span
                  class="text-xs font-bold text-slate-600 dark:text-slate-400 truncate"
                  >Bell-Active</span
                >
                <span
                  class="px-1.5 py-0.5 rounded-md bg-slate-200 dark:bg-slate-700 text-[10px] font-mono text-slate-500"
                  >54</span
                >
              </div>
              <div
                class="absolute inset-0 bg-white/90 dark:bg-slate-900/90 backdrop-blur-[2px] rounded-xl flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity z-10"
              >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-primary hover:border-primary transition-colors"
                  ><span class="material-symbols-outlined text-sm">edit</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-blue-500 hover:border-blue-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm"
                    >autorenew</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-red-500 hover:border-red-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm">delete</span
                  ></button
                >
              </div>
            </div>

            <!-- Icon Card 6 (Heart) -->
            <div
              class="group relative flex flex-col items-center p-4 rounded-xl bg-white/60 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5 transition-all cursor-pointer"
            >
              <div
                class="text-slate-600 dark:text-slate-400 mb-4 transition-transform group-hover:scale-110 duration-200"
              >
                <span class="material-symbols-outlined text-4xl">favorite</span>
              </div>
              <div class="w-full flex items-center justify-between">
                <span
                  class="text-xs font-bold text-slate-600 dark:text-slate-400 truncate"
                  >Heart-Fill</span
                >
                <span
                  class="px-1.5 py-0.5 rounded-md bg-slate-200 dark:bg-slate-700 text-[10px] font-mono text-slate-500"
                  >310</span
                >
              </div>
              <div
                class="absolute inset-0 bg-white/90 dark:bg-slate-900/90 backdrop-blur-[2px] rounded-xl flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity z-10"
              >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-primary hover:border-primary transition-colors"
                  ><span class="material-symbols-outlined text-sm">edit</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-blue-500 hover:border-blue-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm"
                    >autorenew</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-red-500 hover:border-red-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm">delete</span
                  ></button
                >
              </div>
            </div>
            <!-- Icon Card 7 (Cart) -->
            <div
              class="group relative flex flex-col items-center p-4 rounded-xl bg-white/60 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5 transition-all cursor-pointer"
            >
              <div
                class="text-slate-600 dark:text-slate-400 mb-4 transition-transform group-hover:scale-110 duration-200"
              >
                <span class="material-symbols-outlined text-4xl"
                  >shopping_cart</span
                >
              </div>
              <div class="w-full flex items-center justify-between">
                <span
                  class="text-xs font-bold text-slate-600 dark:text-slate-400 truncate"
                  >Cart-Alt</span
                >
                <span
                  class="px-1.5 py-0.5 rounded-md bg-slate-200 dark:bg-slate-700 text-[10px] font-mono text-slate-500"
                  >14</span
                >
              </div>
              <div
                class="absolute inset-0 bg-white/90 dark:bg-slate-900/90 backdrop-blur-[2px] rounded-xl flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity z-10"
              >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-primary hover:border-primary transition-colors"
                  ><span class="material-symbols-outlined text-sm">edit</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-blue-500 hover:border-blue-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm"
                    >autorenew</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-red-500 hover:border-red-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm">delete</span
                  ></button
                >
              </div>
            </div>
            <!-- Icon Card 8 (Credit Card) -->
            <div
              class="group relative flex flex-col items-center p-4 rounded-xl bg-white/60 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/5 transition-all cursor-pointer"
            >
              <div
                class="text-slate-600 dark:text-slate-400 mb-4 transition-transform group-hover:scale-110 duration-200"
              >
                <span class="material-symbols-outlined text-4xl"
                  >credit_card</span
                >
              </div>
              <div class="w-full flex items-center justify-between">
                <span
                  class="text-xs font-bold text-slate-600 dark:text-slate-400 truncate"
                  >CC-Front</span
                >
                <span
                  class="px-1.5 py-0.5 rounded-md bg-slate-200 dark:bg-slate-700 text-[10px] font-mono text-slate-500"
                  >9</span
                >
              </div>
              <div
                class="absolute inset-0 bg-white/90 dark:bg-slate-900/90 backdrop-blur-[2px] rounded-xl flex items-center justify-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity z-10"
              >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-primary hover:border-primary transition-colors"
                  ><span class="material-symbols-outlined text-sm">edit</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-blue-500 hover:border-blue-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm"
                    >autorenew</span
                  ></button
                >
                <button
                  class="size-8 rounded-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 flex items-center justify-center text-slate-500 hover:text-red-500 hover:border-red-500 transition-colors"
                  ><span class="material-symbols-outlined text-sm">delete</span
                  ></button
                >
              </div>
            </div>
          </div>

          <div class="mt-8 text-center pt-4">
            <span class="text-xs text-slate-400">Showing 8 of 8,432 icons</span>
          </div>
        </div>
      </div>

      <!-- Inspector Sidebar -->
      <aside
        class="w-96 flex-none bg-white/95 dark:bg-surface-dark/95 border-l border-slate-200 dark:border-slate-800 overflow-y-auto z-20 backdrop-blur-md hidden xl:block"
      >
        <div class="h-full flex flex-col">
          <div
            class="px-6 py-5 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between"
          >
            <h2
              class="font-bold text-slate-800 dark:text-white flex items-center gap-2"
            >
              <span class="material-symbols-outlined text-primary">info</span>
              Icon Inspector
            </h2>
            <button
              class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-300"
            >
              <span class="material-symbols-outlined">close</span>
            </button>
          </div>
          <div class="p-6 flex-1 overflow-y-auto space-y-8">
            <div>
              <label
                class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block mb-3"
                >Vector Preview</label
              >
              <div
                class="aspect-square w-full rounded-2xl checkerboard border border-slate-200 dark:border-slate-700 flex items-center justify-center relative group overflow-hidden"
