---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Provider Management">
  <div class="flex flex-col gap-6 h-full">
    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 shrink-0">
      <div
        class="glass-panel p-5 rounded-xl flex flex-col justify-between group hover:border-primary/30 transition-all h-[140px]"
      >
        <div class="flex justify-between items-start">
          <div class="p-2 rounded-lg bg-blue-50 text-blue-600">
            <span class="material-symbols-outlined">account_balance</span>
          </div>
        </div>
        <div>
          <p class="text-sm font-medium text-text-muted">
            Total Connected Banks
          </p>
          <h3
            class="text-3xl font-bold text-text-main font-mono mt-1 group-hover:text-blue-600 transition-colors"
          >
            24
          </h3>
        </div>
      </div>
      <div
        class="glass-panel p-5 rounded-xl flex flex-col justify-between group hover:border-primary/30 transition-all h-[140px]"
      >
        <div class="flex justify-between items-start">
          <div class="p-2 rounded-lg bg-teal-50 text-teal-600">
            <span class="material-symbols-outlined">account_balance_wallet</span
            >
          </div>
          <span
            class="text-xs font-bold px-2 py-1 rounded-full bg-green-100 text-status-green flex items-center gap-1"
          >
            <span class="material-symbols-outlined text-[14px]"
              >trending_up</span
            > 2
          </span>
        </div>
        <div>
          <p class="text-sm font-medium text-text-muted">Active E-Wallets</p>
          <h3
            class="text-3xl font-bold text-text-main font-mono mt-1 group-hover:text-teal-600 transition-colors"
          >
            12
          </h3>
        </div>
      </div>
      <div
        class="glass-panel p-5 rounded-xl flex flex-col justify-between group hover:border-primary/30 transition-all h-[140px]"
      >
        <div class="flex justify-between items-start">
          <div class="p-2 rounded-lg bg-purple-50 text-purple-600">
            <span class="material-symbols-outlined">timer</span>
          </div>
          <span
            class="text-xs font-bold px-2 py-1 rounded-full bg-purple-100 text-purple-700 flex items-center gap-1"
          >
            -12ms
          </span>
        </div>
        <div>
          <p class="text-sm font-medium text-text-muted">Avg. Sync Latency</p>
          <h3
            class="text-3xl font-bold text-text-main font-mono mt-1 group-hover:text-purple-600 transition-colors"
          >
            145ms
          </h3>
        </div>
      </div>
      <div
        class="glass-panel p-5 rounded-xl flex flex-col justify-between group hover:border-primary/30 transition-all h-[140px]"
      >
        <div class="flex justify-between items-start">
          <div class="p-2 rounded-lg bg-primary/10 text-primary">
            <span class="material-symbols-outlined">health_and_safety</span>
          </div>
          <span
            class="text-xs font-bold px-2 py-1 rounded-full bg-green-100 text-status-green flex items-center gap-1"
          >
            Good
          </span>
        </div>
        <div>
          <p class="text-sm font-medium text-text-muted">
            Provider Health Score
          </p>
          <h3
            class="text-3xl font-bold text-text-main font-mono mt-1 group-hover:text-primary transition-colors"
          >
            99.8%
          </h3>
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="flex flex-col xl:flex-row gap-6 h-full min-h-[500px]">
      <!-- Active Providers Grid -->
      <div class="flex-1">
        <h3
          class="text-lg font-bold text-text-main mb-4 flex items-center gap-2"
        >
          <span class="material-symbols-outlined text-primary">grid_view</span>
          Active Providers
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <!-- BCA Bank -->
          <div
            class="glass-panel p-6 rounded-xl flex flex-col gap-4 group hover:border-primary/40 transition-all shadow-sm relative overflow-hidden"
          >
            <div class="absolute top-0 right-0 p-4">
              <span
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-status-green border border-green-200"
              >
                <span class="relative flex h-2 w-2">
                  <span
                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                  ></span>
                  <span
                    class="relative inline-flex rounded-full h-2 w-2 bg-status-green"
                  ></span>
                </span>
                Operational
              </span>
            </div>
            <div class="flex items-center gap-4">
              <div
                class="size-14 rounded-xl bg-white border border-gray-100 p-2 shadow-sm flex items-center justify-center overflow-hidden"
              >
                <img
                  alt="BCA Logo"
                  class="w-full h-full object-cover rounded-lg"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBCfKKs9lG8Y9HVCYEuup3n-AoFuPKNBM1fOKPrG4Hf3hOJL5PC4W-UN5ZqgwoAkzSGQGIqyFqdT1KAWLfZRJw8iQYTcfUnUj7BBBFppV731WDY6TH4RGJZ282-Yk51r6HuGDe4ja9lSAcnnY7ahUSEYR3DhY8i9CcmeBTLKuIiEGE6a8M2i8iJJHDb7h-THasE5vPVSNtKpxuA5vgQuKFHZ8J9jmYW6iJpc_D95A0UP4vwHPHIZ5NqPO-ntXXODsOegwH39nmWWYwH"
                />
              </div>
              <div>
                <h4 class="text-lg font-bold text-text-main">BCA Bank</h4>
                <p class="text-xs text-text-muted font-mono mt-0.5">
                  API: v4.2.0 • TLS 1.3
                </p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4 py-2">
              <div class="bg-white/40 rounded-lg p-3 border border-white/60">
                <p class="text-xs text-text-muted mb-1">Total Users Linked</p>
                <p class="font-mono font-bold text-text-main text-lg">
                  2,491,020
                </p>
              </div>
              <div class="bg-white/40 rounded-lg p-3 border border-white/60">
                <p class="text-xs text-text-muted mb-1">Sync Frequency</p>
                <div
                  class="flex items-center gap-1 text-primary font-bold text-sm"
                >
                  <span class="material-symbols-outlined text-[16px]">bolt</span
                  >
                  Real-time
                </div>
              </div>
            </div>
            <div class="flex gap-2 mt-auto pt-2">
              <button
                class="flex-1 py-2 px-3 rounded-lg bg-primary/10 text-primary hover:bg-primary hover:text-white transition-colors text-sm font-semibold border border-primary/20"
              >
                Manage API
              </button>
              <button
                class="p-2 rounded-lg bg-white/50 text-text-muted hover:text-text-main hover:bg-white border border-gray-200/50 transition-colors"
                title="View Analytics"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >analytics</span
                >
              </button>
              <button
                class="p-2 rounded-lg bg-white/50 text-status-red hover:bg-red-50 border border-gray-200/50 transition-colors"
                title="Disable Connection"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >link_off</span
                >
              </button>
            </div>
          </div>

          <!-- Bank Jago -->
          <div
            class="glass-panel p-6 rounded-xl flex flex-col gap-4 group hover:border-primary/40 transition-all shadow-sm relative overflow-hidden"
          >
            <div class="absolute top-0 right-0 p-4">
              <span
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-status-green border border-green-200"
              >
                <span class="h-2 w-2 rounded-full bg-status-green"></span>
                Operational
              </span>
            </div>
            <div class="flex items-center gap-4">
              <div
                class="size-14 rounded-xl bg-orange-50 border border-orange-100 p-2 shadow-sm flex items-center justify-center overflow-hidden"
              >
                <div
                  class="w-full h-full bg-gradient-to-tr from-orange-400 to-purple-500 rounded-lg flex items-center justify-center text-white font-bold text-xl"
                >
                  J
                </div>
              </div>
              <div>
                <h4 class="text-lg font-bold text-text-main">Bank Jago</h4>
                <p class="text-xs text-text-muted font-mono mt-0.5">
                  API: v2.1.5 • OAUTH2
                </p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4 py-2">
              <div class="bg-white/40 rounded-lg p-3 border border-white/60">
                <p class="text-xs text-text-muted mb-1">Total Users Linked</p>
                <p class="font-mono font-bold text-text-main text-lg">
                  892,102
                </p>
              </div>
              <div class="bg-white/40 rounded-lg p-3 border border-white/60">
                <p class="text-xs text-text-muted mb-1">Sync Frequency</p>
                <div
                  class="flex items-center gap-1 text-text-main font-bold text-sm"
                >
                  <span
                    class="material-symbols-outlined text-[16px] text-text-muted"
                    >schedule</span
                  >
                  15 min
                </div>
              </div>
            </div>
            <div class="flex gap-2 mt-auto pt-2">
              <button
                class="flex-1 py-2 px-3 rounded-lg bg-white border border-gray-200 text-text-main hover:border-primary hover:text-primary transition-colors text-sm font-semibold"
              >
                Manage API
              </button>
              <button
                class="p-2 rounded-lg bg-white/50 text-text-muted hover:text-text-main hover:bg-white border border-gray-200/50 transition-colors"
                title="View Analytics"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >analytics</span
                >
              </button>
              <button
                class="p-2 rounded-lg bg-white/50 text-status-red hover:bg-red-50 border border-gray-200/50 transition-colors"
                title="Disable Connection"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >link_off</span
                >
              </button>
            </div>
          </div>

          <!-- Mandiri -->
          <div
            class="glass-panel p-6 rounded-xl flex flex-col gap-4 group hover:border-primary/40 transition-all shadow-sm relative overflow-hidden"
          >
            <div class="absolute top-0 right-0 p-4">
              <span
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700 border border-yellow-200"
              >
                <span class="material-symbols-outlined text-[14px]"
                  >warning</span
                >
                Degraded
              </span>
            </div>
            <div class="flex items-center gap-4">
              <div
                class="size-14 rounded-xl bg-blue-50 border border-blue-100 p-2 shadow-sm flex items-center justify-center overflow-hidden"
              >
                <div
                  class="w-full h-full bg-blue-700 rounded-lg flex items-center justify-center text-white font-bold text-xl"
                >
                  M
                </div>
              </div>
              <div>
                <h4 class="text-lg font-bold text-text-main">Mandiri</h4>
                <p class="text-xs text-text-muted font-mono mt-0.5">
                  API: v1.8 • DIRECT
                </p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4 py-2">
              <div class="bg-white/40 rounded-lg p-3 border border-white/60">
                <p class="text-xs text-text-muted mb-1">Total Users Linked</p>
                <p class="font-mono font-bold text-text-main text-lg">
                  3,100,550
                </p>
              </div>
              <div class="bg-white/40 rounded-lg p-3 border border-white/60">
                <p class="text-xs text-text-muted mb-1">Sync Frequency</p>
                <div
                  class="flex items-center gap-1 text-text-main font-bold text-sm"
                >
                  <span
                    class="material-symbols-outlined text-[16px] text-text-muted"
                    >schedule</span
                  >
                  30 min
                </div>
              </div>
            </div>
            <div class="flex gap-2 mt-auto pt-2">
              <button
                class="flex-1 py-2 px-3 rounded-lg bg-white border border-gray-200 text-text-main hover:border-primary hover:text-primary transition-colors text-sm font-semibold"
              >
                Manage API
              </button>
              <button
                class="p-2 rounded-lg bg-white/50 text-text-muted hover:text-text-main hover:bg-white border border-gray-200/50 transition-colors"
                title="View Analytics"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >analytics</span
                >
              </button>
              <button
                class="p-2 rounded-lg bg-white/50 text-status-red hover:bg-red-50 border border-gray-200/50 transition-colors"
                title="Disable Connection"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >link_off</span
                >
              </button>
            </div>
          </div>

          <!-- GoPay -->
          <div
            class="glass-panel p-6 rounded-xl flex flex-col gap-4 group hover:border-primary/40 transition-all shadow-sm relative overflow-hidden"
          >
            <div class="absolute top-0 right-0 p-4">
              <span
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-green-100 text-status-green border border-green-200"
              >
                <span class="h-2 w-2 rounded-full bg-status-green"></span>
                Operational
              </span>
            </div>
            <div class="flex items-center gap-4">
              <div
                class="size-14 rounded-xl bg-white border border-gray-100 p-2 shadow-sm flex items-center justify-center overflow-hidden"
              >
                <img
                  alt="GoPay Logo"
                  class="w-full h-full object-cover rounded-lg"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuB0tCrp9wGPhIBNHSRq0D2uof3nkY8W3iUy39w3U5L1PVEccGVhK4Z_wFstQQzjqqVeVedaEfNkUqaixAmnxMzEk5zizWPslv1pU3MOM5uEbRijJQtiwhS8i83CY6lNvzE0mTObWggzJHVXkIPeO4Dygsz5YySxXVBnNvTuT8dQvYNb7DLDA6m2OtYKOR_JDokfg2KVn0GbNzg9O1FNENYq0OBAgLRJcbw8aCL_YEVw9Gq1UlNZSr5gkGyvFw0-gLdwJyl8iSmAUk8E"
                />
              </div>
              <div>
                <h4 class="text-lg font-bold text-text-main">GoPay</h4>
                <p class="text-xs text-text-muted font-mono mt-0.5">
                  API: v5.0 • E-WALLET
                </p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4 py-2">
              <div class="bg-white/40 rounded-lg p-3 border border-white/60">
                <p class="text-xs text-text-muted mb-1">Total Users Linked</p>
                <p class="font-mono font-bold text-text-main text-lg">
                  5,220,100
                </p>
              </div>
              <div class="bg-white/40 rounded-lg p-3 border border-white/60">
                <p class="text-xs text-text-muted mb-1">Sync Frequency</p>
                <div
                  class="flex items-center gap-1 text-primary font-bold text-sm"
                >
                  <span class="material-symbols-outlined text-[16px]">bolt</span
                  >
                  Real-time
                </div>
              </div>
            </div>
            <div class="flex gap-2 mt-auto pt-2">
              <button
                class="flex-1 py-2 px-3 rounded-lg bg-white border border-gray-200 text-text-main hover:border-primary hover:text-primary transition-colors text-sm font-semibold"
              >
                Manage API
              </button>
              <button
                class="p-2 rounded-lg bg-white/50 text-text-muted hover:text-text-main hover:bg-white border border-gray-200/50 transition-colors"
                title="View Analytics"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >analytics</span
                >
              </button>
              <button
                class="p-2 rounded-lg bg-white/50 text-status-red hover:bg-red-50 border border-gray-200/50 transition-colors"
                title="Disable Connection"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >link_off</span
                >
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Logs Sidebar -->
      <div class="w-full xl:w-96 shrink-0 flex flex-col">
        <div
          class="glass-panel rounded-xl flex flex-col h-full overflow-hidden max-h-[800px]"
        >
          <div
            class="p-4 border-b border-gray-200/60 bg-white/30 flex items-center justify-between sticky top-0 backdrop-blur-md"
          >
            <h3 class="font-bold text-text-main flex items-center gap-2">
              <span class="material-symbols-outlined text-text-muted"
                >terminal</span
              >
              Integration Status
            </h3>
            <span
              class="text-[10px] uppercase font-bold tracking-wider text-status-green bg-green-100 px-2 py-0.5 rounded border border-green-200"
              >Live</span
            >
          </div>
          <div class="flex-1 overflow-y-auto p-2 space-y-1 font-mono text-xs">
            <div
              class="p-3 rounded-lg bg-white/40 border border-gray-100 hover:bg-white/60 transition-colors group"
            >
              <div class="flex justify-between items-center mb-1">
                <span class="text-text-muted text-[10px]">10:42:05.120</span>
                <span class="text-status-green font-bold text-[10px]"
                  >SUCCESS</span
                >
              </div>
              <div class="flex items-start gap-2">
                <div
                  class="w-1 h-full min-h-[1.5rem] bg-status-green rounded-full self-stretch"
                >
                </div>
                <div>
                  <span class="font-bold text-text-main block">BCA Bank</span>
                  <span class="text-text-muted"
                    >Batch sync completed (450 records)</span
                  >
                </div>
              </div>
            </div>

            <div
              class="p-3 rounded-lg bg-white/40 border border-gray-100 hover:bg-white/60 transition-colors group"
            >
              <div class="flex justify-between items-center mb-1">
                <span class="text-text-muted text-[10px]">10:41:58.902</span>
                <span class="text-status-green font-bold text-[10px]"
                  >SUCCESS</span
                >
              </div>
              <div class="flex items-start gap-2">
                <div
                  class="w-1 h-full min-h-[1.5rem] bg-status-green rounded-full self-stretch"
                >
                </div>
                <div>
                  <span class="font-bold text-text-main block">GoPay</span>
                  <span class="text-text-muted"
                    >Webhook received: transaction_update</span
                  >
                </div>
              </div>
            </div>

            <div
              class="p-3 rounded-lg bg-yellow-50/50 border border-yellow-100 hover:bg-yellow-50/80 transition-colors group"
            >
              <div class="flex justify-between items-center mb-1">
                <span class="text-text-muted text-[10px]">10:40:12.441</span>
                <span class="text-yellow-600 font-bold text-[10px]"
                  >WARNING</span
                >
              </div>
              <div class="flex items-start gap-2">
                <div
                  class="w-1 h-full min-h-[1.5rem] bg-status-gold rounded-full self-stretch"
                >
                </div>
                <div>
                  <span class="font-bold text-text-main block">Mandiri</span>
                  <span class="text-text-muted"
                    >High latency detected (&gt;2500ms)</span
                  >
                </div>
              </div>
            </div>

            <div
              class="p-3 rounded-lg bg-white/40 border border-gray-100 hover:bg-white/60 transition-colors group"
            >
              <div class="flex justify-between items-center mb-1">
                <span class="text-text-muted text-[10px]">10:39:01.005</span>
                <span class="text-status-green font-bold text-[10px]"
                  >SUCCESS</span
                >
              </div>
              <div class="flex items-start gap-2">
                <div
                  class="w-1 h-full min-h-[1.5rem] bg-status-green rounded-full self-stretch"
                >
                </div>
                <div>
                  <span class="font-bold text-text-main block">Bank Jago</span>
                  <span class="text-text-muted"
                    >Token refreshed successfully</span
                  >
                </div>
              </div>
            </div>

            <div
              class="p-3 rounded-lg bg-red-50/50 border border-red-100 hover:bg-red-50/80 transition-colors group"
            >
              <div class="flex justify-between items-center mb-1">
                <span class="text-text-muted text-[10px]">10:38:45.220</span>
                <span class="text-status-red font-bold text-[10px]"
                  >CRITICAL</span
                >
              </div>
              <div class="flex items-start gap-2">
                <div
                  class="w-1 h-full min-h-[1.5rem] bg-status-red rounded-full self-stretch"
                >
                </div>
                <div>
                  <span class="font-bold text-text-main block"
                    >BNI (Legacy)</span
                  >
                  <span class="text-text-muted"
                    >Connection timeout. Retrying... (3/5)</span
                  >
                </div>
              </div>
            </div>

            <div
              class="p-3 rounded-lg bg-white/40 border border-gray-100 hover:bg-white/60 transition-colors group"
            >
              <div class="flex justify-between items-center mb-1">
                <span class="text-text-muted text-[10px]">10:35:10.118</span>
                <span class="text-status-green font-bold text-[10px]"
                  >SUCCESS</span
                >
              </div>
              <div class="flex items-start gap-2">
                <div
                  class="w-1 h-full min-h-[1.5rem] bg-status-green rounded-full self-stretch"
                >
                </div>
                <div>
                  <span class="font-bold text-text-main block">BCA Bank</span>
                  <span class="text-text-muted">Health check ping OK</span>
                </div>
              </div>
            </div>
          </div>
          <div class="p-3 bg-white/40 border-t border-gray-200/50 text-center">
            <button
              class="text-xs font-semibold text-primary hover:text-primary-dark transition-colors w-full py-1"
              >View Full System Logs</button
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
