---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Provider Library">
  <div class="flex flex-col gap-6 h-full min-h-0">
    <!-- Split Layout -->
    <div class="flex gap-6 h-full min-h-0">
      <!-- Left Column: System Activity Log (2/3) -->
      <div class="w-2/3 flex flex-col min-h-0">
        <div
          class="glass-panel rounded-xl flex flex-col h-full overflow-hidden shadow-sm"
        >
          <div
            class="p-5 border-b border-gray-200/60 bg-white/40 flex items-center justify-between sticky top-0 backdrop-blur-md z-10"
          >
            <h3
              class="font-bold text-lg text-text-main flex items-center gap-3"
            >
              <span
                class="material-symbols-outlined text-primary bg-primary/10 p-1.5 rounded-lg"
                >list_alt</span
              >
              System Activity Log
            </h3>
            <div class="flex items-center gap-4">
              <div
                class="flex items-center gap-2 px-3 py-1 bg-white/50 rounded-lg border border-gray-200/50"
              >
                <span class="w-2 h-2 rounded-full bg-status-green animate-pulse"
                ></span>
                <span
                  class="text-xs font-bold text-text-main uppercase tracking-tight"
                  >Real-time Feed</span
                >
              </div>
              <span
                class="text-[10px] uppercase font-bold tracking-widest text-status-green bg-green-100 px-3 py-1 rounded-full border border-green-200"
                >Active</span
              >
            </div>
          </div>
          <div class="flex-1 overflow-y-auto p-4 space-y-3 font-mono text-sm">
            <!-- Log Item 1 -->
            <div
              class="p-4 rounded-xl bg-white/40 border border-white hover:bg-white/60 transition-all group flex gap-4"
            >
              <div class="flex-shrink-0 flex flex-col items-center">
                <div
                  class="size-10 rounded-full bg-green-100 flex items-center justify-center text-status-green"
                >
                  <span class="material-symbols-outlined text-[20px]"
                    >person_add</span
                  >
                </div>
                <div class="w-px flex-1 bg-gray-200 my-2"></div>
              </div>
              <div class="flex-1">
                <div class="flex justify-between items-center mb-1">
                  <span
                    class="text-status-green font-bold text-xs uppercase tracking-wider"
                    >New Association</span
                  >
                  <span class="text-text-muted text-xs">10:42:05.120</span>
                </div>
                <span class="font-bold text-text-main block text-base"
                  >BCA Bank</span
                >
                <p class="text-text-muted leading-relaxed">
                  New manual BCA pocket created by User ID: 4920
                </p>
              </div>
            </div>
            <!-- Log Item 2 -->
            <div
              class="p-4 rounded-xl bg-white/40 border border-white hover:bg-white/60 transition-all group flex gap-4"
            >
              <div class="flex-shrink-0 flex flex-col items-center">
                <div
                  class="size-10 rounded-full bg-blue-100 flex items-center justify-center text-status-blue"
                >
                  <span class="material-symbols-outlined text-[20px]">link</span
                  >
                </div>
                <div class="w-px flex-1 bg-gray-200 my-2"></div>
              </div>
              <div class="flex-1">
                <div class="flex justify-between items-center mb-1">
                  <span
                    class="text-status-blue font-bold text-xs uppercase tracking-wider"
                    >User Action</span
                  >
                  <span class="text-text-muted text-xs">10:41:58.902</span>
                </div>
                <span class="font-bold text-text-main block text-base"
                  >GoPay</span
                >
                <p class="text-text-muted leading-relaxed">
                  User ID: 8821 manually linked GoPay account
                </p>
              </div>
            </div>
            <!-- Log Item 3 -->
            <div
              class="p-4 rounded-xl bg-yellow-50/50 border border-yellow-100/50 hover:bg-yellow-50/80 transition-all group flex gap-4"
            >
              <div class="flex-shrink-0 flex flex-col items-center">
                <div
                  class="size-10 rounded-full bg-status-gold/20 flex items-center justify-center text-yellow-700"
                >
                  <span class="material-symbols-outlined text-[20px]"
                    >description</span
                  >
                </div>
                <div class="w-px flex-1 bg-gray-200 my-2"></div>
              </div>
              <div class="flex-1">
                <div class="flex justify-between items-center mb-1">
                  <span
                    class="text-yellow-700 font-bold text-xs uppercase tracking-wider"
                    >Metadata Update</span
                  >
                  <span class="text-text-muted text-xs">10:40:12.441</span>
                </div>
                <span class="font-bold text-text-main block text-base"
                  >Mandiri</span
                >
                <p class="text-text-muted leading-relaxed">
                  Logo updated by Admin (Size: 400x400px)
                </p>
              </div>
            </div>
            <!-- Log Item 4 -->
            <div
              class="p-4 rounded-xl bg-white/40 border border-white hover:bg-white/60 transition-all group flex gap-4"
            >
              <div class="flex-shrink-0 flex flex-col items-center">
                <div
                  class="size-10 rounded-full bg-green-100 flex items-center justify-center text-status-green"
                >
                  <span class="material-symbols-outlined text-[20px]"
                    >person_add</span
                  >
                </div>
                <div class="w-px flex-1 bg-gray-200 my-2"></div>
              </div>
              <div class="flex-1">
                <div class="flex justify-between items-center mb-1">
                  <span
                    class="text-status-green font-bold text-xs uppercase tracking-wider"
                    >New Association</span
                  >
                  <span class="text-text-muted text-xs">10:39:01.005</span>
                </div>
                <span class="font-bold text-text-main block text-base"
                  >Bank Jago</span
                >
                <p class="text-text-muted leading-relaxed">
                  Manual tracking enabled by User ID: 1055
                </p>
              </div>
            </div>
            <!-- Log Item 5 -->
            <div
              class="p-4 rounded-xl bg-red-50/50 border border-red-100/50 hover:bg-red-50/80 transition-all group flex gap-4"
            >
              <div class="flex-shrink-0 flex flex-col items-center">
                <div
                  class="size-10 rounded-full bg-red-100 flex items-center justify-center text-status-red"
                >
                  <span class="material-symbols-outlined text-[20px]"
                    >report</span
                  >
                </div>
                <div class="w-px flex-1 bg-gray-200 my-2"></div>
              </div>
              <div class="flex-1">
                <div class="flex justify-between items-center mb-1">
                  <span
                    class="text-status-red font-bold text-xs uppercase tracking-wider"
                    >User Report</span
                  >
                  <span class="text-text-muted text-xs">10:38:45.220</span>
                </div>
                <span class="font-bold text-text-main block text-base"
                  >BNI (Legacy)</span
                >
                <p class="text-text-muted leading-relaxed">
                  User reported incorrect interest rate metadata
                </p>
              </div>
            </div>
            <!-- Log Item 6 -->
            <div
              class="p-4 rounded-xl bg-white/40 border border-white hover:bg-white/60 transition-all group flex gap-4"
            >
              <div class="flex-shrink-0 flex flex-col items-center">
                <div
                  class="size-10 rounded-full bg-blue-100 flex items-center justify-center text-status-blue"
                >
                  <span class="material-symbols-outlined text-[20px]">sync</span
                  >
                </div>
                <div class="w-px flex-1 bg-gray-200 my-2"></div>
              </div>
              <div class="flex-1">
                <div class="flex justify-between items-center mb-1">
                  <span
                    class="text-status-blue font-bold text-xs uppercase tracking-wider"
                    >System Update</span
                  >
                  <span class="text-text-muted text-xs">10:35:10.118</span>
                </div>
                <span class="font-bold text-text-main block text-base"
                  >BCA Bank</span
                >
                <p class="text-text-muted leading-relaxed">
                  Batch update: 50 new branch locations added to manual
                  selection library
                </p>
              </div>
            </div>
          </div>
          <div class="p-4 bg-white/40 border-t border-gray-200/50 text-center">
            <button
              class="text-sm font-bold text-primary hover:text-primary-dark transition-colors flex items-center justify-center gap-2 mx-auto"
            >
              View Full System History
              <span class="material-symbols-outlined text-[18px]"
                >arrow_forward</span
              >
            </button>
          </div>
        </div>
      </div>

      <!-- Right Column: Stats & Active List (1/3) -->
      <div class="w-1/3 flex flex-col gap-6 min-h-0">
        <!-- Stats Grid -->
        <div class="flex flex-col gap-3">
          <div class="grid grid-cols-2 gap-3">
            <div
              class="glass-panel p-3.5 rounded-xl flex items-center gap-3 border border-white"
            >
              <div
                class="size-9 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >account_balance</span
                >
              </div>
              <div>
                <p
                  class="text-[10px] font-bold text-text-muted uppercase tracking-wider"
                >
                  Banks
                </p>
                <h3
                  class="text-lg font-bold text-text-main font-mono leading-none"
                >
                  24
                </h3>
              </div>
            </div>
            <div
              class="glass-panel p-3.5 rounded-xl flex items-center gap-3 border border-white"
            >
              <div
                class="size-9 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >account_balance_wallet</span
                >
              </div>
              <div>
                <p
                  class="text-[10px] font-bold text-text-muted uppercase tracking-wider"
                >
                  E-Wallets
                </p>
                <h3
                  class="text-lg font-bold text-text-main font-mono leading-none"
                >
                  12
                </h3>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div
              class="glass-panel p-3.5 rounded-xl flex items-center gap-3 border border-white"
            >
              <div
                class="size-9 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center"
              >
                <span class="material-symbols-outlined text-[20px]">groups</span
                >
              </div>
              <div class="overflow-hidden">
                <p
                  class="text-[10px] font-bold text-text-muted uppercase tracking-wider truncate"
                >
                  Manual Users
                </p>
                <h3
                  class="text-lg font-bold text-text-main font-mono leading-none"
                >
                  84.3K
                </h3>
              </div>
            </div>
            <div
              class="glass-panel p-3.5 rounded-xl flex items-center gap-3 border border-white"
            >
              <div
                class="size-9 rounded-lg bg-primary/10 text-primary flex items-center justify-center"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >verified</span
                >
              </div>
              <div>
                <p
                  class="text-[10px] font-bold text-text-muted uppercase tracking-wider"
                >
                  Accuracy
                </p>
                <h3
                  class="text-lg font-bold text-text-main font-mono leading-none"
                >
                  99.8%
                </h3>
              </div>
            </div>
          </div>
        </div>

        <!-- Active Providers List -->
        <div
          class="glass-panel flex-1 rounded-xl flex flex-col overflow-hidden min-h-0 shadow-sm"
        >
          <div
            class="p-4 border-b border-gray-200/60 bg-white/30 sticky top-0 backdrop-blur-md z-10 flex items-center justify-between"
          >
            <h3 class="font-bold text-text-main flex items-center gap-2">
              <span
                class="material-symbols-outlined text-text-muted text-[20px]"
                >inventory_2</span
              >
              Active Providers
            </h3>
            <span
              class="text-[10px] font-bold text-text-muted bg-gray-100 px-2 py-0.5 rounded"
              >36 Total</span
            >
          </div>
          <div class="flex-1 overflow-y-auto p-3 space-y-2">
            <!-- Provider Item 1 -->
            <div
              class="p-3 rounded-lg bg-white/40 border border-white hover:bg-white/80 transition-all group flex items-center gap-3"
            >
              <div
                class="size-10 rounded-lg bg-white border border-gray-100 p-1 flex items-center justify-center overflow-hidden flex-shrink-0 shadow-sm"
              >
                <img
                  alt="BCA Logo"
                  class="w-full h-full object-cover rounded"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuBCfKKs9lG8Y9HVCYEuup3n-AoFuPKNBM1fOKPrG4Hf3hOJL5PC4W-UN5ZqgwoAkzSGQGIqyFqdT1KAWLfZRJw8iQYTcfUnUj7BBBFppV731WDY6TH4RGJZ282-Yk51r6HuGDe4ja9lSAcnnY7ahUSEYR3DhY8i9CcmeBTLKuIiEGE6a8M2i8iJJHDb7h-THasE5vPVSNtKpxuA5vgQuKFHZ8J9jmYW6iJpc_D95A0UP4vwHPHIZ5NqPO-ntXXODsOegwH39nmWWYwH"
                />
              </div>
              <div class="flex-1 min-w-0">
                <h4 class="text-sm font-bold text-text-main truncate">
                  BCA Bank
                </h4>
                <div
                  class="flex items-center gap-1.5 text-[10px] text-text-muted"
                >
                  <span
                    class="material-symbols-outlined text-[12px] text-primary"
                    >edit_calendar</span
                  >
                  Updated: 24 Oct 2023
                </div>
              </div>
              <button
                class="size-8 rounded-lg bg-white border border-gray-200 flex items-center justify-center text-text-muted hover:text-primary hover:border-primary/30 transition-colors"
              >
                <span class="material-symbols-outlined text-[18px]">edit</span>
              </button>
            </div>
            <!-- Provider Item 2 -->
            <div
              class="p-3 rounded-lg bg-white/40 border border-white hover:bg-white/80 transition-all group flex items-center gap-3"
            >
              <div
                class="size-10 rounded-lg bg-orange-50 border border-orange-100 flex items-center justify-center flex-shrink-0 shadow-sm overflow-hidden"
              >
                <div
                  class="w-full h-full bg-gradient-to-tr from-orange-400 to-purple-500 flex items-center justify-center text-white font-bold text-xs"
                >
                  J
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <h4 class="text-sm font-bold text-text-main truncate">
                  Bank Jago
                </h4>
                <div
                  class="flex items-center gap-1.5 text-[10px] text-text-muted"
                >
                  <span class="material-symbols-outlined text-[12px]"
                    >edit_calendar</span
                  >
                  Updated: 12 Sep 2023
                </div>
              </div>
              <button
                class="size-8 rounded-lg bg-white border border-gray-200 flex items-center justify-center text-text-muted hover:text-primary hover:border-primary/30 transition-colors"
              >
                <span class="material-symbols-outlined text-[18px]">edit</span>
              </button>
            </div>
            <!-- Provider Item 3 -->
            <div
              class="p-3 rounded-lg bg-white/40 border border-white hover:bg-white/80 transition-all group flex items-center gap-3"
            >
              <div
                class="size-10 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center flex-shrink-0 shadow-sm overflow-hidden"
              >
                <div
                  class="w-full h-full bg-blue-700 flex items-center justify-center text-white font-bold text-xs"
                >
                  M
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <h4 class="text-sm font-bold text-text-main truncate">
                  Mandiri
                </h4>
                <div
                  class="flex items-center gap-1.5 text-[10px] text-text-muted"
                >
                  <span class="material-symbols-outlined text-[12px]"
                    >edit_calendar</span
                  >
                  Updated: Yesterday
                </div>
              </div>
              <button
                class="size-8 rounded-lg bg-white border border-gray-200 flex items-center justify-center text-text-muted hover:text-primary hover:border-primary/30 transition-colors"
              >
                <span class="material-symbols-outlined text-[18px]">edit</span>
              </button>
            </div>
            <!-- Provider Item 4 -->
            <div
              class="p-3 rounded-lg bg-white/40 border border-white hover:bg-white/80 transition-all group flex items-center gap-3"
            >
              <div
                class="size-10 rounded-lg bg-white border border-gray-100 p-1 flex items-center justify-center overflow-hidden flex-shrink-0 shadow-sm"
              >
                <img
                  alt="GoPay Logo"
                  class="w-full h-full object-cover rounded"
                  src="https://lh3.googleusercontent.com/aida-public/AB6AXuB0tCrp9wGPhIBNHSRq0D2uof3nkY8W3iUy39w3U5L1PVEccGVhK4Z_wFstQQzjqqVeVedaEfNkUqaixAmnxMzEk5zizWPslv1pU3MOM5uEbRijJQtiwhS8i83CY6lNvzE0mTObWggzJHVXkIPeO4Dygsz5YySxXVBnNvTuT8dQvYNb7DLDA6m2OtYKOR_JDokfg2KVn0GbNzg9O1FNENYq0OBAgLRJcbw8aCL_YEVw9Gq1UlNZSr5gkGyvFw0-gLdwJyl8iSmAUk8E"
                />
              </div>
              <div class="flex-1 min-w-0">
                <h4 class="text-sm font-bold text-text-main truncate">GoPay</h4>
                <div
                  class="flex items-center gap-1.5 text-[10px] text-text-muted"
                >
                  <span
                    class="material-symbols-outlined text-[12px] text-primary"
                    >edit_calendar</span
                  >
                  Updated: Just now
                </div>
              </div>
              <button
                class="size-8 rounded-lg bg-white border border-gray-200 flex items-center justify-center text-text-muted hover:text-primary hover:border-primary/30 transition-colors"
              >
                <span class="material-symbols-outlined text-[18px]">edit</span>
              </button>
            </div>

            <div
              class="p-3 rounded-lg bg-white/20 border border-dashed border-gray-200/50 flex items-center justify-center"
            >
              <p class="text-[10px] font-bold text-text-muted uppercase">
                Additional providers...
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>
