                  <div
                    class="size-10 rounded-lg bg-white border border-gray-100 p-1 flex items-center justify-center shadow-sm"
                  >
                    <img
                      alt="BCA Logo"
                      class="w-full h-full object-cover rounded"
                      src="https://lh3.googleusercontent.com/aida-public/AB6AXuBCfKKs9lG8Y9HVCYEuup3n-AoFuPKNBM1fOKPrG4Hf3hOJL5PC4W-UN5ZqgwoAkzSGQGIqyFqdT1KAWLfZRJw8iQYTcfUnUj7BBBFppV731WDY6TH4RGJZ282-Yk51r6HuGDe4ja9lSAcnnY7ahUSEYR3DhY8i9CcmeBTLKuIiEGE6a8M2i8iJJHDb7h-THasE5vPVSNtKpxuA5vgQuKFHZ8J9jmYW6iJpc_D95A0UP4vwHPHIZ5NqPO-ntXXODsOegwH39nmWWYwH"
                    />
                  </div>
                  <div class="flex flex-col">
                    <span class="text-sm font-bold text-text-main"
                      >BCA Bank</span
                    >
                    <span
                      class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-green-100 text-status-green w-fit border border-green-200 mt-0.5"
                      >PUBLIC</span
