                      >visibility_off</span
                    >
                  </button>
                </div>
              </td>
            </tr>
            <!-- Row 4 -->
            <tr class="hover:bg-white/50 transition-colors group">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div
                    class="size-10 rounded-lg bg-white border border-gray-100 p-1 flex items-center justify-center shadow-sm"
                  >
                    <img
                      alt="GoPay Logo"
                      class="w-full h-full object-cover rounded"
                      src="https://lh3.googleusercontent.com/aida-public/AB6AXuB0tCrp9wGPhIBNHSRq0D2uof3nkY8W3iUy39w3U5L1PVEccGVhK4Z_wFstQQzjqqVeVedaEfNkUqaixAmnxMzEk5zizWPslv1pU3MOM5uEbRijJQtiwhS8i83CY6lNvzE0mTObWggzJHVXkIPeO4Dygsz5YySxXVBnNvTuT8dQvYNb7DLDA6m2OtYKOR_JDokfg2KVn0GbNzg9O1FNENYq0OBAgLRJcbw8aCL_YEVw9Gq1UlNZSr5gkGyvFw0-gLdwJyl8iSmAUk8E"
                    />
                  </div>
                  <div class="flex flex-col">
                    <span class="text-sm font-bold text-text-main">GoPay</span>
                    <span
                      class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-green-100 text-status-green w-fit border border-green-200 mt-0.5"
                      >PUBLIC</span
                    >
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 text-xs font-mono text-text-muted"
                >E-Wallet</td
              >
              <td class="px-6 py-4 text-sm font-bold font-mono text-text-main"
                >5,220,100</td
              >
              <td class="px-6 py-4">
                <div
