              </td>
              <td class="px-6 py-4">
                <div class="flex justify-end gap-2">
                  <button
                    class="px-3 py-1.5 rounded-lg bg-primary/10 text-primary hover:bg-primary hover:text-white transition-colors text-xs font-bold border border-primary/10"
