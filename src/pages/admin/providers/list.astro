              </td>
              <td class="px-6 py-4">
                <div class="flex justify-end gap-2">
                  <button
                    class="px-3 py-1.5 rounded-lg bg-white border border-gray-200 text-text-main hover:border-primary hover:text-primary transition-colors text-xs font-bold"
