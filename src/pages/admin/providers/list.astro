        >
          <div class="flex justify-between items-center mb-1">
            <span class="text-text-muted text-[10px]">10:39:01.005</span>
            <span class="text-status-green font-bold text-[10px]"
              >NEW ASSOCIATION</span
            >
          </div>
          <div class="flex items-start gap-3">
            <div class="w-1 h-8 bg-status-green rounded-full shrink-0"></div>
            <div>
              <span class="font-bold text-text-main block">Bank Jago</span>
              <span class="text-text-muted leading-relaxed"
                >Manual tracking enabled by User ID: 1055</span
              >
            </div>
          </div>
        </div>
        <!-- Log Item 5 -->
        <div
          class="p-4 rounded-lg bg-red-50/50 border border-red-100 hover:bg-red-50/80 transition-colors group"
        >
          <div class="flex justify-between items-center mb-1">
            <span class="text-text-muted text-[10px]">10:38:45.220</span>
            <span class="text-status-red font-bold text-[10px]">REPORT</span>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-1 h-8 bg-status-red rounded-full shrink-0"></div>
