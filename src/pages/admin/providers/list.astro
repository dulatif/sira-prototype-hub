                    >
                  </button>
                  <button
                    class="p-1.5 rounded-lg text-status-red hover:bg-red-50 border border-transparent hover:border-red-100 transition-colors"
                  >
                    <span class="material-symbols-outlined text-[20px]"
                      >visibility_off</span
                    >
                  </button>
                </div>
              </td>
            </tr>
            <!-- Row 3 -->
            <tr class="hover:bg-white/50 transition-colors group">
              <td class="px-6 py-4">
                <div class="flex items-center gap-3">
                  <div
                    class="size-10 rounded-lg bg-blue-50 border border-blue-100 p-1 flex items-center justify-center shadow-sm"
                  >
                    <div
                      class="w-full h-full bg-blue-700 rounded flex items-center justify-center text-white font-bold text-xs"
                    >
                      M
                    </div>
                  </div>
                  <div class="flex flex-col">
                    <span class="text-sm font-bold text-text-main">Mandiri</span
                    >
                    <span
                      class="text-[10px] font-bold px-1.5 py-0.5 rounded-full bg-yellow-100 text-yellow-700 w-fit border border-yellow-200 mt-0.5"
                      >DRAFT</span
                    >
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 text-xs font-mono text-text-muted"
