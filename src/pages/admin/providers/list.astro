              >
              <td class="px-6 py-4">
                <div
                  class="flex items-center gap-2 text-text-muted font-bold text-xs"
                >
                  <span class="material-symbols-outlined text-[16px]"
                    >edit_calendar</span
                  >
                  12 Sep 2023
