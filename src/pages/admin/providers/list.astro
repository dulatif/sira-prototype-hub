          <span class="material-symbols-outlined text-text-muted">list_alt</span
          >
          System Activity Log
        </h3>
        <div class="flex items-center gap-3">
          <span
            class="text-[10px] uppercase font-bold tracking-wider text-status-green bg-green-100 px-2 py-0.5 rounded border border-green-200"
            >System Online</span
          >
          <button class="text-xs font-bold text-primary hover:underline"
            >Download Report</button
          >
        </div>
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-1 p-2 font-mono text-xs"
      >
        <!-- Log Item 1 -->
        <div
          class="p-4 rounded-lg bg-white/40 border border-gray-100 hover:bg-white/60 transition-colors group"
        >
          <div class="flex justify-between items-center mb-1">
            <span class="text-text-muted text-[10px]">10:42:05.120</span>
            <span class="text-status-green font-bold text-[10px]"
