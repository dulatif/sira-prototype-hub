---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Provider Library">
  <div class="flex flex-col gap-6">
    <!-- Metrics Grid -->
    <div class="grid grid-cols-4 gap-4">
      <div
        class="glass-panel p-4 rounded-xl flex items-center gap-4 group hover:border-primary/30 transition-all"
      >
        <div class="p-2.5 rounded-lg bg-blue-50 text-blue-600">
          <span class="material-symbols-outlined text-[20px]"
            >account_balance</span
          >
        </div>
        <div>
          <p
            class="text-[11px] font-bold text-text-muted uppercase tracking-wider"
          >
            Bank Options
          </p>
          <h3 class="text-xl font-bold text-text-main font-mono">24</h3>
        </div>
      </div>
      <div
        class="glass-panel p-4 rounded-xl flex items-center gap-4 group hover:border-primary/30 transition-all"
      >
        <div class="p-2.5 rounded-lg bg-teal-50 text-teal-600">
          <span class="material-symbols-outlined text-[20px]"
            >account_balance_wallet</span
          >
        </div>
        <div>
          <p
            class="text-[11px] font-bold text-text-muted uppercase tracking-wider"
          >
            E-Wallet Options
          </p>
          <h3 class="text-xl font-bold text-text-main font-mono">12</h3>
        </div>
      </div>
      <div
        class="glass-panel p-4 rounded-xl flex items-center gap-4 group hover:border-primary/30 transition-all"
      >
        <div class="p-2.5 rounded-lg bg-purple-50 text-purple-600">
          <span class="material-symbols-outlined text-[20px]"
            >manage_accounts</span
          >
        </div>
        <div>
          <p
            class="text-[11px] font-bold text-text-muted uppercase tracking-wider"
          >
            Manual Tracking Users
          </p>
          <h3 class="text-xl font-bold text-text-main font-mono">84,392</h3>
        </div>
      </div>
      <div
        class="glass-panel p-4 rounded-xl flex items-center gap-4 group hover:border-primary/30 transition-all"
      >
        <div class="p-2.5 rounded-lg bg-primary/10 text-primary">
          <span class="material-symbols-outlined text-[20px]">fact_check</span>
        </div>
        <div>
          <p
            class="text-[11px] font-bold text-text-muted uppercase tracking-wider"
          >
            Metadata Accuracy
          </p>
          <h3 class="text-xl font-bold text-text-main font-mono">99.8%</h3>
        </div>
      </div>
    </div>

    <!-- Active Providers Table -->
    <div class="space-y-4">
      <h3 class="text-lg font-bold text-text-main flex items-center gap-2 px-2">
        <span class="material-symbols-outlined text-primary">grid_view</span>
        Active Providers
      </h3>
      <div class="glass-panel rounded-xl overflow-hidden">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-white/40 border-b border-gray-200/60">
              <th
                class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider"
              >
                <button
                  class="flex items-center gap-1 hover:text-text-main transition-colors"
                >
                  Provider <span class="material-symbols-outlined text-[14px]"
                    >unfold_more</span
                  >
                </button>
              </th>
              <th
                class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider"
              >
                <button
                  class="flex items-center gap-1 hover:text-text-main transition-colors"
                >
                  Category <span class="material-symbols-outlined text-[14px]"
                    >unfold_more</span
                  >
                </button>
              </th>
              <th
                class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider"
              >
                <button
                  class="flex items-center gap-1 hover:text-text-main transition-colors"
                >
                  Total Users Linked <span
                    class="material-symbols-outlined text-[14px]"
                    >unfold_more</span
                  >
                </button>
              </th>
              <th
                class="px-6 py-4 text-xs font-bold text-text-muted uppercase tracking-wider"
              >
                <button
                  class="flex items-center gap-1 hover:text-text-main transition-colors"
                >
                  Last Updated Metadata <span
                    class="material-symbols-outlined text-[14px]"
                    >unfold_more</span
