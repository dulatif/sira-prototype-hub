                  </div>
                </div>
              </td>
              <td class="px-6 py-4 text-xs font-mono text-text-muted"
                >Commercial Bank</td
              >
              <td class="px-6 py-4 text-sm font-bold font-mono text-text-main"
                >2,491,020</td
              >
              <td class="px-6 py-4">
                <div
                  class="flex items-center gap-2 text-primary font-bold text-xs"
                >
                  <span class="material-symbols-outlined text-[16px]"
