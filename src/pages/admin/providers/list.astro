              </td>
            </tr>
          </tbody>
        </table>
        <div
          class="px-6 py-4 bg-white/20 border-t border-gray-200/50 flex justify-between items-center"
        >
          <span class="text-xs text-text-muted font-medium"
            >Showing 4 of 36 providers</span
          >
          <div class="flex gap-1">
            <button
              class="size-8 rounded-lg flex items-center justify-center border border-gray-200 hover:bg-white text-text-muted transition-colors"
              ><span class="material-symbols-outlined text-[18px]"
                >chevron_left</span
              ></button
            >
            <button
              class="size-8 rounded-lg flex items-center justify-center border border-primary bg-primary text-white text-xs font-bold"
              >1</button
            >
            <button
              class="size-8 rounded-lg flex items-center justify-center border border-gray-200 hover:bg-white text-text-muted text-xs font-bold"
              >2</button
            >
            <button
              class="size-8 rounded-lg flex items-center justify-center border border-gray-200 hover:bg-white text-text-muted transition-colors"
              ><span class="material-symbols-outlined text-[18px]"
                >chevron_right</span
              ></button
            >
          </div>
        </div>
      </div>
