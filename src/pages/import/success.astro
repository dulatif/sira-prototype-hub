---
import Base from "../../layouts/Base.astro";
import Sidebar from "../../components/Sidebar.astro";
import Header from "../../components/Header.astro";
---

<Base title="Sira - Import Success">
  <div class="flex h-screen overflow-hidden bg-[#F2F8F8] dark:bg-[#21242c]">
    <Sidebar activePage="import-data" />
    <main class="flex-1 flex flex-col relative min-w-0 overflow-hidden">
      <Header
        title="Import Success"
        subtitle="Data synchronization complete"
        icon="check_circle"
      />

      <!-- Content -->
      <div
        class="flex-1 flex items-center justify-center p-4 md:p-8 relative z-10 overflow-y-auto"
      >
        <!-- Center Glass Card -->
        <div
          class="glass-card w-full max-w-[840px] rounded-3xl p-8 md:p-14 flex flex-col gap-10 animate-pop origin-center"
        >
          <!-- Hero Header -->
          <div class="flex flex-col items-center text-center gap-5">
            <div class="relative">
              <div class="absolute inset-0 bg-primary/20 blur-xl rounded-full">
              </div>
              <div
                class="relative bg-white dark:bg-slate-800 rounded-full p-4 shadow-lg shadow-primary/10 ring-1 ring-primary/10"
              >
                <span
                  class="material-symbols-rounded text-5xl text-primary icon-filled animate-pulse"
                  >check_circle</span
                >
              </div>
            </div>
            <div class="animate-slide-up delay-100">
              <h1
                class="text-3xl md:text-4xl font-bold text-[#0c1d1b] dark:text-white tracking-tight mb-2 font-display"
              >
                Import Complete
              </h1>
              <p
                class="text-[#5c7a76] dark:text-slate-400 text-lg max-w-[480px] mx-auto leading-relaxed"
              >
                Your financial data has been successfully synchronized and
                categorized.
              </p>
            </div>
          </div>
          <!-- Bento Stats Grid -->
          <div
            class="grid grid-cols-1 md:grid-cols-3 gap-5 animate-slide-up delay-200"
          >
            <!-- Stat 1 -->
            <div class="glass-stat p-6 rounded-2xl flex flex-col gap-4 group">
              <div
                class="size-10 rounded-xl bg-teal-50 dark:bg-teal-900/30 flex items-center justify-center text-teal-700 dark:text-teal-300 group-hover:bg-primary group-hover:text-white transition-colors"
              >
                <span class="material-symbols-rounded">receipt_long</span>
              </div>
              <div>
                <p
                  class="text-[#5c7a76] dark:text-slate-400 text-sm font-bold uppercase tracking-wider mb-1"
                >
                  Transactions
                </p>
                <p
                  class="text-3xl font-bold text-[#0c1d1b] dark:text-white font-display"
                >
                  342
                </p>
              </div>
            </div>
            <!-- Stat 2 (Featured) -->
            <div
              class="glass-stat p-6 rounded-2xl flex flex-col gap-4 group border-primary/20 bg-white/60 dark:bg-slate-800/80"
            >
              <div
                class="size-10 rounded-xl bg-teal-50 dark:bg-teal-900/30 flex items-center justify-center text-teal-700 dark:text-teal-300 group-hover:bg-primary group-hover:text-white transition-colors"
              >
                <span class="material-symbols-rounded">account_balance</span>
              </div>
              <div>
                <p
                  class="text-[#5c7a76] dark:text-slate-400 text-sm font-bold uppercase tracking-wider mb-1"
                >
                  Total Value
                </p>
                <p
                  class="text-3xl font-bold text-primary font-mono tracking-tight"
                >
                  $12,450.00
                </p>
              </div>
            </div>
            <!-- Stat 3 -->
            <div class="glass-stat p-6 rounded-2xl flex flex-col gap-4 group">
              <div
                class="size-10 rounded-xl bg-teal-50 dark:bg-teal-900/30 flex items-center justify-center text-teal-700 dark:text-teal-300 group-hover:bg-primary group-hover:text-white transition-colors"
              >
                <span class="material-symbols-rounded">category</span>
              </div>
              <div>
                <p
                  class="text-[#5c7a76] dark:text-slate-400 text-sm font-bold uppercase tracking-wider mb-1"
                >
                  New Categories
                </p>
                <p
                  class="text-3xl font-bold text-[#0c1d1b] dark:text-white font-display"
                >
                  8
                </p>
              </div>
            </div>
          </div>
          <!-- Mindful Insight Box -->
          <div class="animate-slide-up delay-300">
            <div
              class="bg-[#A7E0DD]/20 border border-[#A7E0DD]/50 rounded-2xl p-5 flex flex-col sm:flex-row items-start sm:items-center gap-4"
            >
              <div
                class="p-2 bg-white/60 dark:bg-slate-800/60 rounded-full text-primary shrink-0 shadow-sm"
              >
                <span class="material-symbols-rounded icon-filled">spa</span>
              </div>
              <div class="flex-1">
                <p
                  class="text-[#0c1d1b] dark:text-slate-200 font-outfit text-lg font-medium italic"
                >
                  "Your wealth map is now more accurate. Time for a mindful
                  review?"
                </p>
              </div>
            </div>
          </div>
          <!-- Action Footer -->
          <div
            class="flex flex-col-reverse sm:flex-row gap-4 justify-center items-center pt-2 animate-slide-up delay-300"
          >
            <button
              class="group w-full sm:w-auto min-w-[160px] h-14 rounded-xl border border-primary/30 hover:border-primary text-primary hover:bg-primary/5 font-bold text-base transition-all flex items-center justify-center gap-2"
            >
              <span
                class="material-symbols-rounded text-[20px] transition-transform group-hover:-translate-x-1"
                >arrow_back</span
              >
              <span>View in Ledger</span>
            </button>
            <a
              href="/"
              class="group w-full sm:w-auto min-w-[200px] h-14 rounded-xl teal-flux-gradient bg-primary hover:bg-primary-hover text-white font-bold text-base shadow-lg shadow-primary/20 hover:shadow-primary/40 hover:shadow-xl transition-all hover:-translate-y-0.5 flex items-center justify-center gap-2"
            >
              <span>Go to Dashboard</span>
              <span
                class="material-symbols-rounded text-[20px] transition-transform group-hover:translate-x-1"
                >arrow_forward</span
              >
            </a>
          </div>
        </div>

        <!-- Decorative Background Elements -->
        <div
          class="fixed top-1/4 left-10 w-64 h-64 bg-teal-200/20 rounded-full blur-3xl pointer-events-none -z-10 animate-pulse"
        >
        </div>
        <div
          class="fixed bottom-10 right-10 w-96 h-96 bg-blue-200/20 rounded-full blur-3xl pointer-events-none -z-10"
        >
        </div>
      </div>
    </main>
  </div>
</Base>

<style>
  .glass-card {
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow:
      0 4px 6px -1px rgba(0, 0, 0, 0.02),
      0 2px 4px -1px rgba(0, 0, 0, 0.02),
      inset 0 0 20px rgba(255, 255, 255, 0.5);
  }
  :global(.dark) .glass-card {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2);
  }

  .glass-stat {
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    transition: all 0.3s ease;
  }
  :global(.dark) .glass-stat {
    background: rgba(30, 41, 59, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .glass-stat:hover {
    background: rgba(255, 255, 255, 0.7);
    transform: translateY(-2px);
    border-color: rgba(0, 194, 178, 0.3);
  }
  :global(.dark) .glass-stat:hover {
    background: rgba(30, 41, 59, 0.7);
  }

  .teal-flux-gradient {
    background: linear-gradient(135deg, #00c2b2 0%, #0b98a8 100%);
  }

  /* Animations */
  @keyframes popIn {
    0% {
      transform: scale(0.8);
      opacity: 0;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes slideUpFade {
    0% {
      transform: translateY(20px);
      opacity: 0;
    }
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .animate-pop {
    animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
  .animate-slide-up {
    animation: slideUpFade 0.6s ease-out forwards;
    opacity: 0;
  }

  .delay-100 {
    animation-delay: 100ms;
  }
  .delay-200 {
    animation-delay: 200ms;
  }
  .delay-300 {
    animation-delay: 300ms;
  }

  .icon-filled {
    font-variation-settings:
      "FILL" 1,
      "wght" 400,
      "GRAD" 0,
      "opsz" 24;
  }
</style>
