---
import Base from "../../layouts/Base.astro";
import Sidebar from "../../components/Sidebar.astro";
import Header from "../../components/Header.astro";
---

<Base title="Sira - Data Importer Center">
  <div class="flex h-screen overflow-hidden bg-[#f9fafa] dark:bg-[#21262c]">
    <Sidebar activePage="import-data" />
    <main class="flex-1 flex flex-col relative min-w-0 overflow-hidden">
      <Header
        title="Import Data"
        subtitle="Manage your data sources"
        icon="upload_file"
      />

      <!-- Background Blobs -->
      <div
        class="absolute top-0 right-0 w-[500px] h-[500px] bg-teal-300/20 dark:bg-teal-900/20 rounded-full blur-3xl pointer-events-none -translate-y-1/2 translate-x-1/4 z-0"
      >
      </div>
      <div
        class="absolute bottom-0 left-20 w-[300px] h-[300px] bg-blue-300/20 dark:bg-blue-900/20 rounded-full blur-3xl pointer-events-none translate-y-1/3 z-0"
      >
      </div>

      <div class="flex-1 overflow-y-auto relative z-10">
        <div class="max-w-6xl mx-auto p-8 flex flex-col gap-8 pb-32">
          <section
            class="glass-panel rounded-2xl p-12 shadow-glass text-center border-2 border-dashed border-primary/50 relative overflow-hidden group hover:border-primary transition-colors cursor-pointer"
          >
            <div
              class="absolute inset-0 bg-primary/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"
            >
            </div>
            <div
              class="relative z-10 flex flex-col items-center justify-center gap-5"
            >
              <div
                class="flex items-center justify-center gap-6 mb-2 opacity-60 group-hover:opacity-100 transition-opacity"
              >
                <span class="material-symbols-rounded text-5xl text-red-400"
                  >picture_as_pdf</span
                >
                <span class="material-symbols-rounded text-5xl text-emerald-500"
                  >description</span
                >
                <span class="material-symbols-rounded text-5xl text-blue-500"
                  >table_chart</span
                >
              </div>
              <div
                class="size-20 rounded-full bg-primary/10 flex items-center justify-center mb-2 animate-pulse ring-4 ring-primary/5"
              >
                <span
                  class="material-symbols-rounded text-4xl text-primary-dark"
                  >cloud_upload</span
                >
              </div>
              <div>
                <h3
                  class="text-xl font-bold text-slate-800 dark:text-white mb-2"
                >
                  Drag & Drop bank statements or receipts
                </h3>
                <p
                  class="text-sm text-slate-500 dark:text-slate-400 font-medium bg-white/50 dark:bg-slate-800/50 px-3 py-1 rounded-full inline-block"
                >
                  Supports PDF, CSV, MT940
                </p>
              </div>
            </div>
          </section>

          <section
            class="glass-card rounded-2xl p-8 border border-white/60 dark:border-slate-700/60"
          >
            <div class="flex flex-wrap items-center justify-between mb-6 gap-4">
              <h3
                class="text-lg font-bold text-slate-800 dark:text-white flex items-center gap-2"
              >
                <span class="material-symbols-rounded text-teal-500">tune</span>
                Field Mapping Grid
              </h3>
              <div
                class="flex items-center gap-3 bg-slate-50 dark:bg-slate-800 px-4 py-2 rounded-lg border border-slate-100 dark:border-slate-700"
              >
                <span
                  class="text-xs text-slate-500 dark:text-slate-400 font-bold uppercase tracking-wide"
                  >Remember mapping</span
                >
                <label class="relative inline-flex items-center cursor-pointer">
                  <input checked="" class="sr-only peer" type="checkbox" />
                  <div
                    class="w-9 h-5 bg-slate-200 dark:bg-slate-600 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-primary"
                  >
                  </div>
                </label>
              </div>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <div
                class="flex items-center gap-4 bg-slate-50/80 dark:bg-slate-800/50 p-4 rounded-xl border border-slate-100 dark:border-slate-700 hover:border-primary/30 transition-colors"
              >
                <div class="flex-1 min-w-0">
                  <p
                    class="text-[10px] uppercase font-bold text-slate-400 mb-1"
                  >
                    CSV Column
                  </p>
                  <div class="flex items-center gap-2">
                    <span
                      class="material-symbols-rounded text-xs text-slate-400"
                      >table_rows</span
                    >
                    <p
                      class="font-mono text-sm font-bold text-slate-700 dark:text-slate-200 truncate"
                    >
                      Column A (Date)
                    </p>
                  </div>
                </div>
                <span class="material-symbols-rounded text-slate-300"
                  >arrow_right_alt</span
                >
                <div class="flex-1 min-w-0">
                  <p
                    class="text-[10px] uppercase font-bold text-primary-dark mb-1"
                  >
                    Sira Field
                  </p>
                  <div class="relative">
                    <select
                      class="w-full bg-white dark:bg-slate-700 border-none text-sm font-bold text-slate-800 dark:text-white rounded-lg py-2 pl-3 pr-8 focus:ring-2 focus:ring-primary/20 cursor-pointer shadow-sm appearance-none"
                    >
                      <option>Transaction Date</option>
                      <option>Posting Date</option>
                    </select>
                    <span
                      class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"
                      >expand_more</span
                    >
                  </div>
                </div>
              </div>
              <div
                class="flex items-center gap-4 bg-slate-50/80 dark:bg-slate-800/50 p-4 rounded-xl border border-slate-100 dark:border-slate-700 hover:border-primary/30 transition-colors"
              >
                <div class="flex-1 min-w-0">
                  <p
                    class="text-[10px] uppercase font-bold text-slate-400 mb-1"
                  >
                    CSV Column
                  </p>
                  <div class="flex items-center gap-2">
                    <span
                      class="material-symbols-rounded text-xs text-slate-400"
                      >attach_money</span
                    >
                    <p
                      class="font-mono text-sm font-bold text-slate-700 dark:text-slate-200 truncate"
                    >
                      Column D (Value)
                    </p>
                  </div>
                </div>
                <span class="material-symbols-rounded text-slate-300"
                  >arrow_right_alt</span
                >
                <div class="flex-1 min-w-0">
                  <p
                    class="text-[10px] uppercase font-bold text-primary-dark mb-1"
                  >
                    Sira Field
                  </p>
                  <div class="relative">
                    <select
                      class="w-full bg-white dark:bg-slate-700 border-none text-sm font-bold text-slate-800 dark:text-white rounded-lg py-2 pl-3 pr-8 focus:ring-2 focus:ring-primary/20 cursor-pointer shadow-sm appearance-none"
                    >
                      <option>Amount</option>
                      <option>Fee</option>
                    </select>
                    <span
                      class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"
                      >expand_more</span
                    >
                  </div>
                </div>
              </div>
              <div
                class="flex items-center gap-4 bg-slate-50/80 dark:bg-slate-800/50 p-4 rounded-xl border border-slate-100 dark:border-slate-700 hover:border-primary/30 transition-colors"
              >
                <div class="flex-1 min-w-0">
                  <p
                    class="text-[10px] uppercase font-bold text-slate-400 mb-1"
                  >
                    CSV Column
                  </p>
                  <div class="flex items-center gap-2">
                    <span
                      class="material-symbols-rounded text-xs text-slate-400"
                      >description</span
                    >
                    <p
                      class="font-mono text-sm font-bold text-slate-700 dark:text-slate-200 truncate"
                    >
                      Column B (Memo)
                    </p>
                  </div>
                </div>
                <span class="material-symbols-rounded text-slate-300"
                  >arrow_right_alt</span
                >
                <div class="flex-1 min-w-0">
                  <p
                    class="text-[10px] uppercase font-bold text-primary-dark mb-1"
                  >
                    Sira Field
                  </p>
                  <div class="relative">
                    <select
                      class="w-full bg-white dark:bg-slate-700 border-none text-sm font-bold text-slate-800 dark:text-white rounded-lg py-2 pl-3 pr-8 focus:ring-2 focus:ring-primary/20 cursor-pointer shadow-sm appearance-none"
                    >
                      <option>Description</option>
                      <option>Notes</option>
                    </select>
                    <span
                      class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"
                      >expand_more</span
                    >
                  </div>
                </div>
              </div>
              <div
                class="flex items-center gap-4 bg-slate-50/80 dark:bg-slate-800/50 p-4 rounded-xl border border-slate-100 dark:border-slate-700 hover:border-primary/30 transition-colors"
              >
                <div class="flex-1 min-w-0">
                  <p
                    class="text-[10px] uppercase font-bold text-slate-400 mb-1"
                  >
                    CSV Column
                  </p>
                  <div class="flex items-center gap-2">
                    <span
                      class="material-symbols-rounded text-xs text-slate-400"
                      >category</span
                    >
                    <p
                      class="font-mono text-sm font-bold text-slate-700 dark:text-slate-200 truncate"
                    >
                      Column E (Type)
                    </p>
                  </div>
                </div>
                <span class="material-symbols-rounded text-slate-300"
                  >arrow_right_alt</span
                >
                <div class="flex-1 min-w-0">
                  <p
                    class="text-[10px] uppercase font-bold text-primary-dark mb-1"
                  >
                    Sira Field
                  </p>
                  <div class="relative">
                    <select
                      class="w-full bg-white dark:bg-slate-700 border-none text-sm font-bold text-slate-800 dark:text-white rounded-lg py-2 pl-3 pr-8 focus:ring-2 focus:ring-primary/20 cursor-pointer shadow-sm appearance-none"
                    >
                      <option>Category</option>
                      <option>Tag</option>
                    </select>
                    <span
                      class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"
                      >expand_more</span
                    >
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section
            class="glass-card rounded-2xl p-8 border border-white/60 dark:border-slate-700/60 flex flex-col gap-6"
          >
            <div>
              <h3
                class="text-lg font-bold text-slate-800 dark:text-white flex items-center gap-2"
              >
                <span class="material-symbols-rounded text-teal-500"
                  >fact_check</span
                >
                Review Hub
              </h3>
            </div>
            <div
              class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4"
            >
              <div
                class="bg-slate-100 dark:bg-slate-800 p-1 rounded-lg inline-flex items-center"
              >
                <button
                  class="px-4 py-1.5 rounded-md bg-white dark:bg-slate-700 shadow-sm text-xs font-bold text-slate-800 dark:text-white transition-all"
                  >All</button
                >
                <button
                  class="px-4 py-1.5 rounded-md text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all"
                  >Income</button
                >
                <button
                  class="px-4 py-1.5 rounded-md text-xs font-medium text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all"
                  >Expense</button
                >
              </div>
              <div class="flex items-center gap-3 w-full md:w-auto">
                <div class="relative flex-1 md:w-64">
                  <span
                    class="material-symbols-rounded absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]"
                    >search</span
                  >
                  <input
                    class="w-full pl-9 pr-4 py-2 bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm font-medium focus:ring-2 focus:ring-primary/20 focus:border-primary/50 outline-none placeholder:text-gray-400 transition-all text-slate-800 dark:text-white"
                    placeholder="Search transactions..."
                    type="text"
                  />
                </div>
                <div class="relative shrink-0">
                  <select
                    class="appearance-none bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 py-2 pl-3 pr-8 rounded-lg text-sm font-bold focus:outline-none focus:ring-2 focus:ring-primary/20 cursor-pointer transition-all"
                  >
                    <option>Sort by: Date</option>
                    <option>Sort by: Amount</option>
                  </select>
                  <span
                    class="material-symbols-rounded absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"
                    >expand_more</span
                  >
                </div>
              </div>
            </div>
            <div
              class="bg-white/60 dark:bg-slate-800/60 rounded-xl border border-white dark:border-slate-700 shadow-sm overflow-hidden"
            >
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                  <thead
                    class="bg-slate-50/50 dark:bg-slate-800/50 border-b border-slate-100 dark:border-slate-700"
                  >
                    <tr>
                      <th
                        class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-wider"
                        >Date</th
                      >
                      <th
                        class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-wider w-1/3"
                        >Description</th
                      >
                      <th
                        class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-wider text-right"
                        >Amount</th
                      >
                      <th
                        class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-wider"
                        >Category</th
                      >
                      <th
                        class="px-6 py-4 text-xs font-bold text-slate-400 uppercase tracking-wider text-center"
                        >Status</th
                      >
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-50 dark:divide-slate-700">
                    <tr
                      class="hover:bg-blue-50/30 dark:hover:bg-blue-900/10 transition-colors group"
                    >
                      <td
                        class="px-6 py-4 font-mono text-xs text-slate-600 dark:text-slate-300"
                        >2023-10-24</td
                      >
                      <td class="px-6 py-4">
                        <input
                          class="w-full bg-transparent border-none p-0 text-sm font-semibold text-slate-800 dark:text-white focus:ring-0 placeholder:text-gray-300"
                          type="text"
                          value="UBER *TRIP 8219"
                        />
                      </td>
                      <td
                        class="px-6 py-4 text-right font-mono text-sm font-bold text-slate-800 dark:text-white"
                        >- $24.50</td
                      >
                      <td class="px-6 py-4">
                        <span
                          class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300 gap-1.5 border border-purple-200 dark:border-purple-800"
                        >
                          <span class="material-symbols-rounded text-[14px]"
                            >auto_awesome</span
                          > Transport
                        </span>
                      </td>
                      <td class="px-6 py-4 text-center">
                        <span
                          class="material-symbols-rounded text-emerald-500 text-[20px]"
                          >check_circle</span
                        >
                      </td>
                    </tr>
                    <tr
                      class="hover:bg-amber-50/50 bg-amber-50/20 dark:bg-amber-900/10 dark:hover:bg-amber-900/20 transition-colors group"
                    >
                      <td
                        class="px-6 py-4 font-mono text-xs text-slate-600 dark:text-slate-300"
                        >2023-10-24</td
                      >
                      <td class="px-6 py-4">
                        <input
                          class="w-full bg-transparent border-none p-0 text-sm font-semibold text-slate-800 dark:text-white focus:ring-0 placeholder:text-gray-300"
                          type="text"
                          value="STARBUCKS #2291"
                        />
                      </td>
                      <td
                        class="px-6 py-4 text-right font-mono text-sm font-bold text-slate-800 dark:text-white"
                        >- $6.45</td
                      >
                      <td class="px-6 py-4">
                        <span
                          class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold bg-orange-100 dark:bg-orange-900/30 text-orange-700 dark:text-orange-300 gap-1.5 border border-orange-200 dark:border-orange-800"
                        >
                          <span class="material-symbols-rounded text-[14px]"
                            >restaurant</span
                          > Food & Drink
                        </span>
                      </td>
                      <td class="px-6 py-4 text-center relative group/tooltip">
                        <button
                          class="bg-amber-100 dark:bg-amber-900/50 p-1 rounded-full text-amber-600 dark:text-amber-400 hover:bg-amber-200 dark:hover:bg-amber-900 transition-colors"
                        >
                          <span
                            class="material-symbols-rounded text-[18px] animate-pulse"
                            >warning</span
                          >
                        </button>
                        <div
                          class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover/tooltip:block bg-gray-800 text-white text-xs px-2 py-1 rounded shadow-lg whitespace-nowrap z-50"
                        >
                          Potential Duplicate
                        </div>
                      </td>
                    </tr>
                    <tr
                      class="hover:bg-blue-50/30 dark:hover:bg-blue-900/10 transition-colors group"
                    >
                      <td
                        class="px-6 py-4 font-mono text-xs text-slate-600 dark:text-slate-300"
                        >2023-10-23</td
                      >
                      <td class="px-6 py-4">
                        <input
                          class="w-full bg-transparent border-none p-0 text-sm font-semibold text-slate-800 dark:text-white focus:ring-0 placeholder:text-gray-300"
                          type="text"
                          value="NETFLIX.COM"
                        />
                      </td>
                      <td
                        class="px-6 py-4 text-right font-mono text-sm font-bold text-slate-800 dark:text-white"
                        >- $15.99</td
                      >
                      <td class="px-6 py-4">
                        <span
                          class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 gap-1.5 border border-blue-200 dark:border-blue-800"
                        >
                          <span class="material-symbols-rounded text-[14px]"
                            >auto_awesome</span
                          > Entertainment
                        </span>
                      </td>
                      <td class="px-6 py-4 text-center">
                        <span
                          class="material-symbols-rounded text-emerald-500 text-[20px]"
                          >check_circle</span
                        >
                      </td>
                    </tr>
                    <tr
                      class="hover:bg-blue-50/30 dark:hover:bg-blue-900/10 transition-colors group"
                    >
                      <td
                        class="px-6 py-4 font-mono text-xs text-slate-600 dark:text-slate-300"
                        >2023-10-22</td
                      >
                      <td class="px-6 py-4">
                        <input
                          class="w-full bg-transparent border-none p-0 text-sm font-semibold text-teal-700 dark:text-teal-400 focus:ring-0 placeholder:text-gray-300"
                          type="text"
                          value="Deposit - PAYROLL"
                        />
                      </td>
                      <td
                        class="px-6 py-4 text-right font-mono text-sm font-bold text-teal-600 dark:text-teal-400"
                        >+ $2,450.00</td
                      >
                      <td class="px-6 py-4">
                        <span
                          class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold bg-teal-100 dark:bg-teal-900/30 text-teal-700 dark:text-teal-300 gap-1.5 border border-teal-200 dark:border-teal-800"
                        >
                          <span class="material-symbols-rounded text-[14px]"
                            >attach_money</span
                          > Income
                        </span>
                      </td>
                      <td class="px-6 py-4 text-center">
                        <span
                          class="material-symbols-rounded text-emerald-500 text-[20px]"
                          >check_circle</span
                        >
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <div
            class="glass-panel rounded-2xl p-6 border border-white/60 dark:border-slate-700/60"
          >
            <h4
              class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4 ml-1"
            >
              Import History
            </h4>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              <div
                class="flex items-center justify-between p-3 bg-white/50 dark:bg-slate-800/50 rounded-xl border border-slate-100 dark:border-slate-700 hover:bg-white dark:hover:bg-slate-700 hover:shadow-sm transition-all cursor-pointer group"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="size-10 rounded-lg bg-red-50 dark:bg-red-900/20 flex items-center justify-center text-red-500 group-hover:bg-red-100 dark:group-hover:bg-red-900/40 transition-colors"
                  >
                    <span class="material-symbols-rounded text-[20px]"
                      >picture_as_pdf</span
                    >
                  </div>
                  <div>
                    <p class="text-xs font-bold text-slate-800 dark:text-white">
                      Chase_Oct_23.pdf
                    </p>
                    <p class="text-[10px] text-slate-400 font-mono">
                      Oct 25, 10:30 AM
                    </p>
                  </div>
                </div>
                <div class="text-right">
                  <span
                    class="block text-xs font-bold text-slate-700 dark:text-slate-300"
                    >42 txns</span
                  >
                  <span class="text-[10px] font-bold text-emerald-500"
                    >Success</span
                  >
                </div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-white/50 dark:bg-slate-800/50 rounded-xl border border-slate-100 dark:border-slate-700 hover:bg-white dark:hover:bg-slate-700 hover:shadow-sm transition-all cursor-pointer group"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="size-10 rounded-lg bg-emerald-50 dark:bg-emerald-900/20 flex items-center justify-center text-emerald-500 group-hover:bg-emerald-100 dark:group-hover:bg-emerald-900/40 transition-colors"
                  >
                    <span class="material-symbols-rounded text-[20px]"
                      >description</span
                    >
                  </div>
                  <div>
                    <p class="text-xs font-bold text-slate-800 dark:text-white">
                      Amex_Export.csv
                    </p>
                    <p class="text-[10px] text-slate-400 font-mono">
                      Oct 22, 09:15 AM
                    </p>
                  </div>
                </div>
                <div class="text-right">
                  <span
                    class="block text-xs font-bold text-slate-700 dark:text-slate-300"
                    >118 txns</span
                  >
                  <span class="text-[10px] font-bold text-emerald-500"
                    >Success</span
                  >
                </div>
              </div>
              <div
                class="flex items-center justify-between p-3 bg-white/50 dark:bg-slate-800/50 rounded-xl border border-slate-100 dark:border-slate-700 hover:bg-white dark:hover:bg-slate-700 hover:shadow-sm transition-all cursor-pointer group"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="size-10 rounded-lg bg-blue-50 dark:bg-blue-900/20 flex items-center justify-center text-blue-500 group-hover:bg-blue-100 dark:group-hover:bg-blue-900/40 transition-colors"
                  >
                    <span class="material-symbols-rounded text-[20px]"
                      >table_chart</span
                    >
