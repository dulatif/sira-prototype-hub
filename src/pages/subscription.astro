---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Header from "../components/Header.astro";
import SubscriptionCreateModal from "../components/SubscriptionCreateModal.astro";
import SubscriptionDetailModal from "../components/SubscriptionDetailModal.astro";
---

<Base title="Sira - Subscription Manager">
  <style>
    .glass-panel {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.6);
    }
    .glass-card {
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow:
        0 4px 6px -1px rgba(0, 0, 0, 0.02),
        0 2px 4px -1px rgba(0, 0, 0, 0.02);
    }
    .hide-scroll::-webkit-scrollbar {
      display: none;
    }
    .hide-scroll {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    .toggle-checkbox:checked {
      right: 0;
      border-color: #22c3b6;
    }
    .toggle-checkbox:checked + .toggle-label {
      background-color: #22c3b6;
    }
  </style>

  <div
    class="flex h-screen w-full overflow-hidden bg-[#f8fcfb] text-[#0f1a19] antialiased selection:bg-primary/30"
  >
    <Sidebar activePage="subscription" />

    <main
      class="flex-1 flex flex-col h-full relative overflow-hidden bg-gradient-to-br from-[#fafaf9] via-[#f2fcfb] to-[#e6f7f6]"
    >
      <Header
        title="Subscription Manager"
        subtitle="Manage your recurring payments"
        icon="credit_card_heart"
      />

      <div
        class="flex-1 overflow-y-auto relative p-4 md:p-8 md:pt-6 pb-20 scroll-smooth"
      >
        <div class="max-w-7xl mx-auto flex flex-col gap-8">
          <!-- Actions Header (Desktop) -->
          <div class="hidden md:flex items-center justify-between">
            <div>
              <h2 class="text-2xl font-bold text-slate-800">Overview</h2>
              <p class="text-slate-500 text-sm">
                Welcome back, get on top of your subs.
              </p>
            </div>
            <button
              id="add-subscription-desktop"
              class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-white font-bold text-sm shadow-lg shadow-primary/20 hover:shadow-primary/40 hover:-translate-y-0.5 transition-all"
            >
              <span class="material-symbols-outlined text-[20px]">add</span>
              Add Subscription
            </button>
          </div>
          <!-- Summary Section -->
          <section class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div
              class="glass-card p-6 rounded-2xl border-white/60 flex flex-col gap-4 relative overflow-hidden group hover:shadow-card-hover transition-all"
            >
              <div
                class="absolute -right-6 -top-6 size-24 rounded-full bg-primary/5 group-hover:bg-primary/10 transition-colors"
              >
              </div>
              <div class="flex items-center gap-3 text-slate-500">
                <span class="material-symbols-outlined">payments</span>
                <span class="text-sm font-semibold uppercase tracking-wider"
                  >Total Monthly</span
                >
              </div>
              <div class="flex items-baseline gap-2">
                <span class="font-mono text-3xl font-bold text-slate-800"
                  >$342.50</span
                >
                <span
                  class="text-xs font-bold text-emerald-500 bg-emerald-50 px-2 py-0.5 rounded-full"
                  >+2.4%</span
                >
              </div>
              <p class="text-xs text-slate-400">Across 12 active services</p>
            </div>

            <div
              class="glass-card p-6 rounded-2xl border-white/60 flex flex-col gap-4 relative overflow-hidden group hover:shadow-card-hover transition-all"
            >
              <div
                class="absolute -right-6 -top-6 size-24 rounded-full bg-blue-500/5 group-hover:bg-blue-500/10 transition-colors"
              >
              </div>
              <div class="flex items-center gap-3 text-slate-500">
                <span class="material-symbols-outlined">calendar_clock</span>
                <span class="text-sm font-semibold uppercase tracking-wider"
                  >Upcoming Payment</span
                >
              </div>
              <div class="flex items-center justify-between">
                <span class="font-mono text-3xl font-bold text-slate-800"
                  >$15.99</span
                >
                <div class="text-right">
                  <p class="text-sm font-bold text-slate-800">
                    Netflix Premium
                  </p>
                  <p class="text-xs text-slate-500">Tomorrow, Jan 16</p>
                </div>
              </div>
            </div>

            <div
              class="glass-card p-6 rounded-2xl border-white/60 flex flex-col gap-4 relative overflow-hidden group hover:shadow-card-hover transition-all"
            >
              <div
                class="absolute -right-6 -top-6 size-24 rounded-full bg-purple-500/5 group-hover:bg-purple-500/10 transition-colors"
              >
              </div>
              <div class="flex items-center gap-3 text-slate-500">
                <span class="material-symbols-outlined">savings</span>
                <span class="text-sm font-semibold uppercase tracking-wider"
                  >Projected Annual</span
                >
              </div>
              <div class="flex items-baseline gap-2">
                <span class="font-mono text-3xl font-bold text-slate-800"
                  >$4,110.00</span
                >
              </div>
              <p class="text-xs text-slate-400">Estimated cost for 2024</p>
            </div>
          </section>

          <!-- Upcoming Flows -->
          <section class="flex flex-col gap-4">
            <div class="flex items-center justify-between px-1">
              <h3
                class="text-slate-800 font-extrabold text-lg flex items-center gap-2"
              >
                <span class="material-symbols-outlined text-primary"
                  >schedule</span
                >
                Upcoming Flows <span
                  class="text-slate-400 text-sm font-normal ml-1"
                  >(Next 7 Days)</span
                >
              </h3>
              <div class="flex gap-2">
                <button
                  class="size-8 rounded-full border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-400 hover:text-primary transition-colors"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >chevron_left</span
                  >
                </button>
                <button
                  class="size-8 rounded-full border border-slate-200 bg-white hover:bg-slate-50 flex items-center justify-center text-slate-400 hover:text-primary transition-colors"
                >
                  <span class="material-symbols-outlined text-[18px]"
                    >chevron_right</span
                  >
                </button>
              </div>
            </div>
            <div class="flex gap-4 overflow-x-auto pb-4 hide-scroll snap-x">
              <!-- Card 1 -->
              <div
                class="min-w-[280px] snap-center glass-card p-5 rounded-2xl border-white/60 hover:border-primary/30 transition-all group"
              >
                <div class="flex items-start justify-between mb-6">
                  <div
                    class="size-12 rounded-xl bg-black flex items-center justify-center text-red-600 text-2xl font-bold shadow-sm"
                  >
                    N
                  </div>
                  <span
                    class="bg-red-50 text-red-600 px-2 py-1 rounded-lg text-[10px] font-bold uppercase tracking-wide"
                    >Due Tmrw</span
                  >
                </div>
                <div class="mb-4">
                  <h4 class="font-bold text-slate-800 text-lg">Netflix</h4>
                  <p class="text-slate-500 text-xs">Standard Plan • Monthly</p>
                </div>
                <div
                  class="flex items-center justify-between pt-4 border-t border-slate-100"
                >
                  <span class="font-mono text-lg font-bold text-slate-800"
                    >$15.99</span
                  >
                  <div class="flex gap-2">
                    <button
                      class="p-2 rounded-lg hover:bg-slate-100 text-slate-400 transition-colors"
                      title="Skip Payment"
                    >
                      <span class="material-symbols-outlined text-[20px]"
                        >fast_forward</span
                      >
                    </button>
                    <button
                      class="px-3 py-1.5 rounded-lg bg-primary text-white text-xs font-bold shadow-sm hover:shadow-md hover:bg-primary-dark transition-all"
                    >
                      Pay Now
                    </button>
                  </div>
                </div>
              </div>
              <!-- Card 2 -->
              <div
                class="min-w-[280px] snap-center glass-card p-5 rounded-2xl border-white/60 hover:border-primary/30 transition-all group"
              >
                <div class="flex items-start justify-between mb-6">
                  <div
                    class="size-12 rounded-xl bg-[#1db954] flex items-center justify-center text-white text-2xl shadow-sm"
                  >
                    <span class="material-symbols-outlined">graphic_eq</span>
                  </div>
                  <span
                    class="bg-emerald-50 text-emerald-600 px-2 py-1 rounded-lg text-[10px] font-bold uppercase tracking-wide"
                    >In 3 Days</span
                  >
                </div>
                <div class="mb-4">
                  <h4 class="font-bold text-slate-800 text-lg">Spotify</h4>
                  <p class="text-slate-500 text-xs">Family Plan • Monthly</p>
                </div>
                <div
                  class="flex items-center justify-between pt-4 border-t border-slate-100"
                >
                  <span class="font-mono text-lg font-bold text-slate-800"
                    >$16.99</span
                  >
                  <div class="flex gap-2">
                    <button
                      class="p-2 rounded-lg hover:bg-slate-100 text-slate-400 transition-colors"
                    >
                      <span class="material-symbols-outlined text-[20px]"
                        >fast_forward</span
                      >
                    </button>
                    <button
                      class="px-3 py-1.5 rounded-lg bg-white border border-primary text-primary text-xs font-bold shadow-sm hover:bg-primary hover:text-white transition-all"
                    >
                      Paid
                    </button>
                  </div>
                </div>
              </div>
              <!-- Card 3 -->
              <div
                class="min-w-[280px] snap-center glass-card p-5 rounded-2xl border-white/60 hover:border-primary/30 transition-all group"
              >
                <div class="flex items-start justify-between mb-6">
                  <div
                    class="size-12 rounded-xl bg-gradient-to-r from-purple-600 to-blue-600 flex items-center justify-center text-white text-lg font-bold shadow-sm"
                  >
                    <span class="material-symbols-outlined">palette</span>
                  </div>
                  <span
                    class="bg-blue-50 text-blue-600 px-2 py-1 rounded-lg text-[10px] font-bold uppercase tracking-wide"
                    >In 5 Days</span
                  >
                </div>
                <div class="mb-4">
                  <h4 class="font-bold text-slate-800 text-lg">Adobe CC</h4>
                  <p class="text-slate-500 text-xs">Creative Cloud • Monthly</p>
                </div>
                <div
                  class="flex items-center justify-between pt-4 border-t border-slate-100"
                >
                  <span class="font-mono text-lg font-bold text-slate-800"
                    >$54.99</span
                  >
                  <div class="flex gap-2">
                    <button
                      class="p-2 rounded-lg hover:bg-slate-100 text-slate-400 transition-colors"
                    >
                      <span class="material-symbols-outlined text-[20px]"
                        >fast_forward</span
                      >
                    </button>
                    <button
                      class="px-3 py-1.5 rounded-lg bg-primary text-white text-xs font-bold shadow-sm hover:shadow-md hover:bg-primary-dark transition-all"
                    >
                      Pay Now
                    </button>
                  </div>
                </div>
              </div>
              <!-- Card 4 -->
              <div
                class="min-w-[280px] snap-center glass-card p-5 rounded-2xl border-white/60 hover:border-primary/30 transition-all group"
              >
                <div class="flex items-start justify-between mb-6">
                  <div
                    class="size-12 rounded-xl bg-slate-800 flex items-center justify-center text-white text-2xl shadow-sm"
                  >
                    <span class="material-symbols-outlined">fitness_center</span
                    >
                  </div>
                  <span
                    class="bg-slate-100 text-slate-600 px-2 py-1 rounded-lg text-[10px] font-bold uppercase tracking-wide"
                    >In 7 Days</span
                  >
                </div>
                <div class="mb-4">
                  <h4 class="font-bold text-slate-800 text-lg">Equinox</h4>
                  <p class="text-slate-500 text-xs">All Access • Monthly</p>
                </div>
                <div
                  class="flex items-center justify-between pt-4 border-t border-slate-100"
                >
                  <span class="font-mono text-lg font-bold text-slate-800"
                    >$210.00</span
                  >
                  <div class="flex gap-2">
                    <button
                      class="p-2 rounded-lg hover:bg-slate-100 text-slate-400 transition-colors"
                    >
                      <span class="material-symbols-outlined text-[20px]"
                        >fast_forward</span
                      >
                    </button>
                    <button
                      class="px-3 py-1.5 rounded-lg bg-primary text-white text-xs font-bold shadow-sm hover:shadow-md hover:bg-primary-dark transition-all"
                    >
                      Pay Now
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Main Grid (List & Ops) -->
          <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
            <!-- List Column -->
            <div class="xl:col-span-9 flex flex-col gap-4">
              <h3
                class="text-slate-800 font-extrabold text-lg flex items-center gap-2 px-1"
              >
                <span class="material-symbols-outlined text-primary"
                  >list_alt</span
                >
                Active Subscriptions
              </h3>
              <div
                class="glass-card rounded-2xl overflow-hidden border-white/60"
              >
                <div class="overflow-x-auto">
                  <table class="w-full text-left border-collapse">
                    <thead>
                      <tr
                        class="bg-white/40 border-b border-slate-200/60 text-xs uppercase tracking-wider text-slate-500 font-bold"
                      >
                        <th class="p-5 font-bold">Service</th>
                        <th class="p-5 font-bold">Category</th>
                        <th class="p-5 font-bold">Freq</th>
                        <th class="p-5 font-bold">Last Payment</th>
                        <th class="p-5 font-bold">Next Billing</th>
                        <th class="p-5 font-bold text-right">Amount</th>
                        <th class="p-5 font-bold text-center">Settings</th>
                      </tr>
                    </thead>
                    <tbody class="text-sm">
                      <tr
                        class="hover:bg-white/40 transition-colors border-b border-slate-100/50 cursor-pointer subscription-row"
                      >
                        <td class="p-5">
                          <div class="flex items-center gap-3">
                            <div
                              class="size-9 rounded-lg bg-black text-red-600 flex items-center justify-center font-bold text-sm"
                            >
                              N
                            </div>
                            <span class="font-bold text-slate-800">Netflix</span
                            >
                          </div>
                        </td>
                        <td class="p-5"
                          ><span
                            class="px-2 py-1 bg-purple-50 text-purple-600 rounded-md text-[11px] font-bold uppercase"
                            >Entertainment</span
                          ></td
                        >
                        <td class="p-5 text-slate-600">Monthly</td>
                        <td class="p-5 text-slate-500">Dec 16, 2023</td>
                        <td class="p-5 text-slate-800 font-medium"
                          >Jan 16, 2024</td
                        >
                        <td
                          class="p-5 text-right font-mono font-bold text-slate-800"
                          >$15.99</td
                        >
                        <td class="p-5">
                          <div class="flex items-center justify-center gap-4">
                            <div class="flex items-center gap-2">
                              <div
                                class="relative inline-block w-8 mr-2 align-middle select-none transition duration-200 ease-in"
                              >
                                <input
                                  checked=""
                                  class="toggle-checkbox absolute block w-4 h-4 rounded-full bg-white border-4 appearance-none cursor-pointer border-slate-300 transition-all duration-300"
                                  id="toggle1"
                                  name="toggle"
                                  type="checkbox"
                                />
                                <label
                                  class="toggle-label block overflow-hidden h-4 rounded-full bg-slate-300 cursor-pointer transition-colors duration-300"
                                  for="toggle1"></label>
                              </div>
                            </div>
                            <span
                              class="px-2 py-0.5 rounded-full bg-teal-50 border border-teal-100 text-teal-600 text-[9px] font-extrabold tracking-wide uppercase"
                              >CHILL</span
                            >
                          </div>
                        </td>
                      </tr>
                      <tr
                        class="hover:bg-white/40 transition-colors border-b border-slate-100/50 cursor-pointer subscription-row"
                      >
                        <td class="p-5">
                          <div class="flex items-center gap-3">
                            <div
                              class="size-9 rounded-lg bg-[#1db954] text-white flex items-center justify-center font-bold text-sm"
                            >
                              <span
                                class="material-symbols-outlined text-[18px]"
                                >graphic_eq</span
                              >
                            </div>
                            <span class="font-bold text-slate-800">Spotify</span
                            >
                          </div>
                        </td>
                        <td class="p-5"
                          ><span
                            class="px-2 py-1 bg-purple-50 text-purple-600 rounded-md text-[11px] font-bold uppercase"
                            >Entertainment</span
                          ></td
                        >
                        <td class="p-5 text-slate-600">Monthly</td>
                        <td class="p-5 text-slate-500">Dec 18, 2023</td>
                        <td class="p-5 text-slate-800 font-medium"
                          >Jan 18, 2024</td
                        >
                        <td
                          class="p-5 text-right font-mono font-bold text-slate-800"
                          >$16.99</td
                        >
                        <td class="p-5">
                          <div class="flex items-center justify-center gap-4">
                            <div class="flex items-center gap-2">
                              <div
                                class="relative inline-block w-8 mr-2 align-middle select-none transition duration-200 ease-in"
                              >
                                <input
                                  checked=""
                                  class="toggle-checkbox absolute block w-4 h-4 rounded-full bg-white border-4 appearance-none cursor-pointer border-slate-300 transition-all duration-300"
                                  id="toggle2"
                                  name="toggle"
                                  type="checkbox"
                                />
                                <label
                                  class="toggle-label block overflow-hidden h-4 rounded-full bg-slate-300 cursor-pointer transition-colors duration-300"
                                  for="toggle2"></label>
                              </div>
                            </div>
                            <span
                              class="px-2 py-0.5 rounded-full bg-rose-50 border border-rose-100 text-rose-600 text-[9px] font-extrabold tracking-wide uppercase"
                              >VIBES</span
                            >
                          </div>
                        </td>
                      </tr>
                      <tr
                        class="hover:bg-white/40 transition-colors border-b border-slate-100/50 cursor-pointer subscription-row"
                      >
                        <td class="p-5">
                          <div class="flex items-center gap-3">
                            <div
                              class="size-9 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-sm"
                            >
                              F
                            </div>
                            <span class="font-bold text-slate-800">Figma</span>
                          </div>
                        </td>
                        <td class="p-5"
                          ><span
                            class="px-2 py-1 bg-blue-50 text-blue-600 rounded-md text-[11px] font-bold uppercase"
                            >SaaS</span
                          ></td
                        >
                        <td class="p-5 text-slate-600">Yearly</td>
                        <td class="p-5 text-slate-500">Feb 15, 2023</td>
                        <td class="p-5 text-slate-800 font-medium"
                          >Feb 15, 2024</td
                        >
                        <td
                          class="p-5 text-right font-mono font-bold text-slate-800"
                          >$144.00</td
                        >
                        <td class="p-5">
                          <div class="flex items-center justify-center gap-4">
                            <div class="flex items-center gap-2">
                              <div
                                class="relative inline-block w-8 mr-2 align-middle select-none transition duration-200 ease-in"
                              >
                                <input
                                  checked=""
                                  class="toggle-checkbox absolute block w-4 h-4 rounded-full bg-white border-4 appearance-none cursor-pointer border-slate-300 transition-all duration-300"
                                  id="toggle3"
                                  name="toggle"
                                  type="checkbox"
                                />
                                <label
                                  class="toggle-label block overflow-hidden h-4 rounded-full bg-slate-300 cursor-pointer transition-colors duration-300"
                                  for="toggle3"></label>
                              </div>
                            </div>
                            <span
                              class="px-2 py-0.5 rounded-full bg-blue-50 border border-blue-100 text-blue-600 text-[9px] font-extrabold tracking-wide uppercase"
                              >WORK</span
                            >
                          </div>
                        </td>
                      </tr>
                      <tr
                        class="hover:bg-white/40 transition-colors border-b border-slate-100/50 cursor-pointer subscription-row"
                      >
                        <td class="p-5">
                          <div class="flex items-center gap-3">
                            <div
                              class="size-9 rounded-lg bg-slate-800 text-white flex items-center justify-center font-bold text-sm"
                            >
                              <span
                                class="material-symbols-outlined text-[18px]"
                                >cloud</span
                              >
                            </div>
                            <span class="font-bold text-slate-800">AWS</span>
                          </div>
                        </td>
                        <td class="p-5"
                          ><span
                            class="px-2 py-1 bg-orange-50 text-orange-600 rounded-md text-[11px] font-bold uppercase"
                            >Infra</span
                          ></td
                        >
                        <td class="p-5 text-slate-600">Monthly</td>
                        <td class="p-5 text-slate-500">Dec 30, 2023</td>
                        <td class="p-5 text-slate-800 font-medium"
                          >Jan 30, 2024</td
                        >
                        <td
                          class="p-5 text-right font-mono font-bold text-slate-800"
                          >$45.20</td
                        >
                        <td class="p-5">
                          <div class="flex items-center justify-center gap-4">
                            <div class="flex items-center gap-2">
                              <div
                                class="relative inline-block w-8 mr-2 align-middle select-none transition duration-200 ease-in"
                              >
                                <input
                                  class="toggle-checkbox absolute block w-4 h-4 rounded-full bg-white border-4 appearance-none cursor-pointer border-slate-300 transition-all duration-300"
                                  id="toggle4"
                                  name="toggle"
                                  type="checkbox"
                                />
                                <label
                                  class="toggle-label block overflow-hidden h-4 rounded-full bg-slate-300 cursor-pointer transition-colors duration-300"
                                  for="toggle4"></label>
                              </div>
                            </div>
                            <span
                              class="px-2 py-0.5 rounded-full bg-slate-100 border border-slate-200 text-slate-500 text-[9px] font-extrabold tracking-wide uppercase"
                              >HOST</span
                            >
                          </div>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
                <div
                  class="p-4 border-t border-white/50 bg-white/30 flex items-center justify-center"
                >
                  <button
                    class="text-sm font-semibold text-primary hover:text-primary-dark transition-colors flex items-center gap-1"
                  >
                    View all 12 subscriptions
                    <span class="material-symbols-outlined text-[16px]"
                      >arrow_forward</span
                    >
                  </button>
                </div>
              </div>
            </div>

            <!-- Savings Ops Column -->
            <div class="xl:col-span-3 flex flex-col gap-4">
              <h3
                class="text-slate-800 font-extrabold text-lg flex items-center gap-2 px-1"
              >
                <span class="material-symbols-outlined text-primary"
                  >trending_down</span
                >
                Savings Ops
              </h3>

              <!-- Ops Card 1 -->
              <div
                class="glass-card p-5 rounded-2xl border-orange-100 bg-orange-50/30 flex flex-col gap-3"
              >
                <div class="flex items-center gap-2 text-orange-600">
                  <span class="material-symbols-outlined">warning</span>
                  <span class="text-xs font-bold uppercase tracking-wider"
                    >Low Usage Alert</span
                  >
                </div>
                <div class="flex items-center gap-3">
                  <div
                    class="size-10 rounded-lg bg-black text-white flex items-center justify-center font-bold text-xs"
                  >
                    MC
                  </div>
                  <div>
                    <p class="font-bold text-slate-800 text-sm">MasterClass</p>
