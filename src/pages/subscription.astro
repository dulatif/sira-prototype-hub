                </div>
                <div class="pt-2">
                  <p class="text-xs text-slate-600 mb-2">
                    You spend <span class="font-mono font-bold">$15.00</span>/mo
                    here.
                  </p>
                  <button
                    class="w-full py-2 rounded-xl bg-white border border-orange-200 text-orange-600 text-xs font-bold shadow-sm hover:bg-orange-50 transition-colors"
                  >
                    Review & Cancel
                  </button>
                </div>
              </div>

              <!-- Ops Card 2 -->
              <div
                class="glass-card p-5 rounded-2xl border-blue-100 bg-blue-50/30 flex flex-col gap-3"
              >
                <div class="flex items-center gap-2 text-blue-600">
                  <span class="material-symbols-outlined">info</span>
                  <span class="text-xs font-bold uppercase tracking-wider"
                    >Price Update</span
                  >
                </div>
                <div class="flex items-center gap-3">
                  <div
                    class="size-10 rounded-lg bg-[#001d51] text-white flex items-center justify-center font-bold text-xs"
                  >
                    D+
                  </div>
                  <div>
                    <p class="font-bold text-slate-800 text-sm">Disney+</p>
                    <p class="text-xs text-slate-500">Hike detected</p>
                  </div>
                </div>
                <div class="pt-1">
                  <p class="text-xs text-slate-600">
                    Plan increasing by <span class="font-bold text-red-500"
                      >+$3.00</span
                    > next cycle.
                  </p>
                </div>
              </div>

              <!-- Savings Summary -->
              <div
                class="p-4 rounded-xl bg-primary/5 border border-primary/10 text-center"
              >
                <p class="text-xs text-slate-500 mb-1">
                  Potential Monthly Savings
                </p>
                <p class="font-mono text-xl font-bold text-primary">$18.00</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile FAB -->
      <button
        id="add-subscription-fab"
        class="md:hidden fixed bottom-6 right-6 size-14 rounded-full bg-primary text-white shadow-lg flex items-center justify-center z-50"
      >
        <span class="material-symbols-outlined">add</span>
      </button>

      <SubscriptionCreateModal />
      <SubscriptionDetailModal />
    </main>
  </div>

  <script>
    const addBtnDesktop = document.getElementById("add-subscription-desktop");
    const addBtnFab = document.getElementById("add-subscription-fab");
    const subscriptionRows = document.querySelectorAll(".subscription-row");

    function openModal() {
      document.dispatchEvent(new CustomEvent("open-subscription-modal"));
    }

    function openDetailModal() {
      document.dispatchEvent(new CustomEvent("open-subscription-detail-modal"));
    }

    addBtnDesktop?.addEventListener("click", openModal);
    addBtnFab?.addEventListener("click", openModal);

    subscriptionRows.forEach((row) => {
      row.addEventListener("click", (e) => {
        // Prevent opening if clicking on toggle checkboxes or their labels
        if (
          (e.target as HTMLElement).closest(".toggle-checkbox") ||
          (e.target as HTMLElement).closest(".toggle-label")
        ) {
          return;
        }
        openDetailModal();
      });
    });
  </script>
</Base>
