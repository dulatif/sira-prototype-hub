---
// Categories Page
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Header from "../components/Header.astro";
---

<Base title="Sira - Category Manager">
  <style>
    .glass-panel {
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.4);
    }
    .shadow-glass {
      box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
    }
    .tree-connector {
      position: absolute;
      left: 26px;
      top: -18px;
      bottom: 50%;
      width: 24px;
      border-left: 2px solid #e2e8f0;
      border-bottom: 2px solid #e2e8f0;
      border-bottom-left-radius: 12px;
      z-index: 0;
    }
  </style>

  <div
    class="flex h-screen w-full overflow-hidden bg-[#f8fcfb] text-slate-900 transition-colors duration-300"
  >
    <Sidebar activePage="categories" />

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <Header
        title="Categories"
        subtitle="Organize your spending"
        icon="category"
      />

      <main class="flex-1 flex overflow-hidden">
        <!-- Sidebar Category List -->
        <aside
          class="w-[380px] lg:w-[420px] flex flex-col bg-white border-r border-slate-100 h-full flex-none overflow-y-auto"
        >
          <div class="p-6 pb-2">
            <div class="flex items-center justify-between mb-6">
              <h3 class="text-lg font-bold text-slate-700">Manager</h3>
              <button
                class="flex items-center gap-1.5 px-3 py-1.5 bg-primary/10 hover:bg-primary text-primary hover:text-white rounded-lg transition-all text-xs font-bold"
              >
                <span class="material-symbols-outlined text-sm">add</span>
                New Category
              </button>
            </div>
            <div class="relative mb-4">
              <span
                class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xl"
                >filter_list</span
              >
              <input
                class="w-full h-11 pl-10 pr-4 bg-slate-50 border-none rounded-xl text-sm font-medium focus:ring-2 focus:ring-primary/50 placeholder-slate-400"
                placeholder="Filter list..."
                type="text"
              />
            </div>
          </div>

          <div class="px-3 py-2 space-y-2">
            <!-- Food & Drinks Category (Expanded) -->
            <div class="group/item">
              <div
                class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 cursor-pointer transition-colors group-hover/item:bg-slate-50"
              >
                <span
                  class="material-symbols-outlined text-slate-300 cursor-grab hover:text-slate-500 text-lg"
                  >drag_indicator</span
                >
                <div
                  class="w-10 h-10 rounded-xl bg-orange-100 flex items-center justify-center text-orange-600 shrink-0 shadow-sm"
                >
                  <span class="material-symbols-outlined">restaurant</span>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-bold text-slate-900">Food &amp; Drinks</p>
                  <p
                    class="text-[10px] font-mono font-medium text-slate-400 uppercase tracking-tight"
                  >
                    $500.00 BUDGET
                  </p>
                </div>
                <span class="material-symbols-outlined text-slate-400"
                  >expand_less</span
                >
              </div>

              <!-- Subcategories -->
              <div class="relative pl-4 mt-1 space-y-1">
                <!-- Coffee (Selected) -->
                <div
                  class="relative flex items-center gap-3 p-2.5 pl-12 rounded-xl bg-primary/5 border border-primary/20 cursor-pointer shadow-sm"
                >
                  <div
                    class="tree-connector"
                    style="border-color: rgba(99, 193, 187, 0.4)"
                  >
                  </div>
                  <span
                    class="material-symbols-outlined text-primary/40 text-base z-10"
                    >drag_indicator</span
                  >
                  <div
                    class="w-8 h-8 rounded-lg bg-white shadow-sm flex items-center justify-center text-primary z-10"
                  >
                    <span class="material-symbols-outlined text-lg">coffee</span
                    >
                  </div>
                  <div class="flex-1 z-10">
                    <p class="font-bold text-sm text-slate-900">Coffee</p>
                  </div>
                  <div class="w-1.5 h-1.5 rounded-full bg-primary mr-2 z-10">
                  </div>
                </div>

                <!-- Groceries -->
                <div
                  class="relative flex items-center gap-3 p-2.5 pl-12 rounded-xl hover:bg-slate-50 cursor-pointer opacity-70 hover:opacity-100 transition-all"
                >
                  <div class="tree-connector"></div>
                  <span
                    class="material-symbols-outlined text-slate-300 text-base z-10"
                    >drag_indicator</span
                  >
                  <div
                    class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-slate-500 z-10"
                  >
                    <span class="material-symbols-outlined text-lg"
                      >shopping_basket</span
                    >
                  </div>
                  <div class="flex-1 z-10">
                    <p class="font-semibold text-sm text-slate-700">
                      Groceries
                    </p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Transportation Category -->
            <div
              class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 cursor-pointer transition-colors"
            >
              <span class="material-symbols-outlined text-slate-300 text-lg"
                >drag_indicator</span
              >
              <div
                class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center text-blue-600 shrink-0"
              >
                <span class="material-symbols-outlined">directions_car</span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-bold text-slate-900">Transportation</p>
              </div>
              <span class="material-symbols-outlined text-slate-400"
                >expand_more</span
              >
            </div>

            <!-- Housing Category -->
            <div
              class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 cursor-pointer transition-colors"
            >
              <span class="material-symbols-outlined text-slate-300 text-lg"
                >drag_indicator</span
              >
              <div
                class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-600 shrink-0"
              >
                <span class="material-symbols-outlined">cottage</span>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-bold text-slate-900">Housing</p>
              </div>
              <span class="material-symbols-outlined text-slate-400"
                >expand_more</span
              >
            </div>
          </div>
        </aside>

        <!-- Category Editor Panel -->
        <section
          class="flex-1 relative bg-slate-50 flex flex-col items-center justify-center p-8 overflow-y-auto"
        >
          <!-- Background Blobs -->
          <div
            class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-primary/5 rounded-full blur-3xl pointer-events-none"
          >
          </div>
          <div
            class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-blue-400/5 rounded-full blur-3xl pointer-events-none"
          >
          </div>

          <!-- Editor Card -->
          <div
            class="w-full max-w-2xl glass-panel shadow-glass rounded-[2.5rem] p-1 relative z-10"
          >
            <div class="bg-white/60 rounded-[2.2rem] p-10 backdrop-blur-md">
              <!-- Header -->
              <div class="flex items-start justify-between mb-10">
                <div>
                  <div class="flex items-center gap-2 mb-2">
                    <span
                      class="text-[10px] font-extrabold uppercase tracking-[0.2em] text-primary"
                      >Editing Category</span
                    >
                    <div class="h-px w-6 bg-primary/30"></div>
                  </div>
                  <h2
                    class="text-4xl font-extrabold text-slate-900 tracking-tight"
                  >
                    Coffee
                  </h2>
                </div>
                <button
                  class="w-12 h-12 rounded-2xl flex items-center justify-center text-red-400 hover:bg-red-50 transition-all border border-red-100"
                >
                  <span class="material-symbols-outlined">delete</span>
                </button>
              </div>

              <!-- Form -->
              <form class="space-y-8" onsubmit="event.preventDefault();">
                <!-- Type Toggle -->
                <div class="flex justify-center">
                  <div class="inline-flex bg-slate-100 p-1.5 rounded-2xl">
                    <button
                      class="px-10 py-3 rounded-xl bg-primary text-white shadow-lg shadow-primary/20 font-bold text-sm"
                      type="button">Expense</button
                    >
                    <button
                      class="px-10 py-3 rounded-xl text-slate-500 font-bold text-sm hover:text-slate-700"
                      type="button">Income</button
                    >
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                  <!-- Category Name -->
                  <div class="col-span-full space-y-2.5">
                    <label
                      class="text-xs font-bold text-slate-400 uppercase tracking-widest ml-1"
                      >Category Name</label
                    >
                    <input
                      class="w-full h-14 px-5 bg-white/80 border border-slate-200 rounded-2xl text-lg font-bold focus:ring-4 focus:ring-primary/10 focus:border-primary transition-all shadow-sm"
                      type="text"
                      value="Coffee"
                    />
                  </div>

                  <!-- Parent Category -->
                  <div class="space-y-2.5">
                    <label
                      class="text-xs font-bold text-slate-400 uppercase tracking-widest ml-1"
                      >Parent Category</label
                    >
                    <div class="relative">
                      <button
                        class="w-full h-14 px-5 flex items-center justify-between bg-white/80 border border-slate-200 rounded-2xl font-bold hover:border-primary transition-all text-left"
                        type="button"
                      >
                        <div class="flex items-center gap-3">
                          <span
                            class="material-symbols-outlined text-orange-500"
                            >restaurant</span
                          >
                          <span>Food &amp; Drinks</span>
                        </div>
                        <span class="material-symbols-outlined text-slate-400"
                          >unfold_more</span
                        >
                      </button>
                    </div>
                  </div>

                  <!-- Monthly Budget -->
                  <div class="space-y-2.5">
                    <label
                      class="text-xs font-bold text-slate-400 uppercase tracking-widest ml-1"
                      >Monthly Budget</label
                    >
                    <div class="relative">
                      <span
                        class="absolute left-5 top-1/2 -translate-y-1/2 text-primary font-mono font-bold"
                        >$</span
                      >
                      <input
                        class="w-full h-14 pl-10 pr-5 bg-white/80 border border-slate-200 rounded-2xl font-mono text-lg font-bold focus:ring-4 focus:ring-primary/10 transition-all shadow-sm"
                        type="text"
                        value="150.00"
                      />
                    </div>
                  </div>

                  <!-- Visual Icon -->
                  <div class="col-span-full space-y-2.5">
                    <label
                      class="text-xs font-bold text-slate-400 uppercase tracking-widest ml-1"
                      >Visual Icon</label
                    >
                    <div
                      class="bg-white/40 border border-slate-200 rounded-3xl p-6 shadow-sm"
                    >
                      <div class="grid grid-cols-6 gap-4">
                        <button
                          class="aspect-square rounded-2xl bg-primary text-white flex items-center justify-center ring-4 ring-primary/20 shadow-lg shadow-primary/30 transition-all"
                          type="button"
                        >
                          <span class="material-symbols-outlined text-2xl"
                            >coffee</span
                          >
                        </button>
                        <button
                          class="aspect-square rounded-2xl bg-white text-slate-400 hover:text-primary hover:border-primary border border-transparent transition-all flex items-center justify-center"
                          type="button"
                        >
                          <span class="material-symbols-outlined"
                            >local_cafe</span
                          >
                        </button>
                        <button
                          class="aspect-square rounded-2xl bg-white text-slate-400 hover:text-primary hover:border-primary border border-transparent transition-all flex items-center justify-center"
                          type="button"
                        >
                          <span class="material-symbols-outlined"
                            >bakery_dining</span
                          >
                        </button>
                        <button
                          class="aspect-square rounded-2xl bg-white text-slate-400 hover:text-primary hover:border-primary border border-transparent transition-all flex items-center justify-center"
                          type="button"
                        >
                          <span class="material-symbols-outlined">liquor</span>
                        </button>
                        <button
                          class="aspect-square rounded-2xl bg-white text-slate-400 hover:text-primary hover:border-primary border border-transparent transition-all flex items-center justify-center"
                          type="button"
                        >
                          <span class="material-symbols-outlined">icecream</span
                          >
                        </button>
                        <button
                          class="aspect-square rounded-2xl bg-white text-slate-400 hover:text-primary hover:border-primary border border-transparent transition-all flex items-center justify-center"
                          type="button"
                        >
                          <span class="material-symbols-outlined">fastfood</span
                          >
                        </button>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Footer -->
                <div
                  class="pt-10 flex items-center justify-between border-t border-slate-200/50"
                >
                  <span
                    class="text-xs font-mono text-slate-400 flex items-center gap-2"
                  >
                    <span
                      class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
                    ></span>
                    DRAFT SAVED 2:14 PM
                  </span>
                  <div class="flex gap-4">
                    <button
                      class="px-8 py-4 rounded-2xl text-slate-500 font-bold text-sm hover:bg-slate-50 transition-all"
                      type="button">Discard</button
                    >
                    <button
                      class="px-10 py-4 rounded-2xl bg-primary hover:bg-primary/90 text-white font-bold text-sm shadow-xl shadow-primary/20 hover:shadow-primary/40 transition-all transform hover:-translate-y-1"
                      type="submit">Save Changes</button
                    >
                  </div>
                </div>
              </form>
            </div>
          </div>

          <p
            class="mt-8 text-[11px] font-bold text-slate-400 uppercase tracking-widest"
          >
            Sira Mindful Finance • Category Manager Pro
          </p>
        </section>
      </main>
    </div>
  </div>
</Base>
