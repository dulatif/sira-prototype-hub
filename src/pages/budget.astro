---
// Budget Page
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import Header from "../components/Header.astro";
---

<Base title="Sira - Budget Manager">
  <style>
    .glass-panel {
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.4);
    }
    .shadow-glass {
      box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
    }
    .shadow-glow-warning {
      box-shadow: 0 0 10px rgba(250, 204, 21, 0.4);
    }
    .shadow-glow-danger {
      box-shadow: 0 0 10px rgba(239, 68, 68, 0.4);
    }
  </style>

  <div
    class="flex h-screen w-full overflow-hidden bg-[#f8fcfb] text-slate-900 transition-colors duration-300"
  >
    <Sidebar activePage="budget" />

    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
      <Header title="Budget Manager" subtitle="October 2023" icon="pie_chart" />

      <main class="flex-1 flex overflow-hidden">
        <!-- Left Sidebar - Budget List -->
        <aside
          class="w-72 flex-none flex flex-col bg-white border-r border-slate-100 h-full overflow-y-auto z-30 transition-all"
        >
          <div
            class="p-4 border-b border-slate-50 flex items-center justify-between sticky top-0 bg-inherit z-10 backdrop-blur-sm"
          >
            <h3
              class="text-xs font-bold text-slate-500 uppercase tracking-widest pl-1"
            >
              Budget
            </h3>
            <button
              class="p-1.5 rounded-lg text-slate-400 hover:bg-slate-50 hover:text-primary transition-all"
            >
              <span class="material-symbols-outlined text-lg">tune</span>
            </button>
          </div>

          <div class="p-3 space-y-2">
            <!-- Coffee (Selected) -->
            <div
              class="group relative p-3 rounded-xl bg-primary/5 border border-primary/20 cursor-pointer overflow-hidden shadow-sm shadow-primary/5"
            >
              <div class="absolute bottom-0 left-0 h-1 bg-primary/20 w-full">
                <div class="h-full bg-primary w-[75%] rounded-r-full"></div>
              </div>
              <div class="flex items-center gap-3 relative z-10 mb-1">
                <div
                  class="w-9 h-9 rounded-lg bg-white text-primary shadow-sm flex items-center justify-center ring-1 ring-slate-100"
                >
                  <span class="material-symbols-outlined text-xl">coffee</span>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-bold text-sm text-slate-900 truncate">
                    Coffee
                  </p>
                  <p
                    class="text-[10px] text-slate-500 font-mono tracking-tight"
                  >
                    $112 / $150
                  </p>
                </div>
                <div class="text-right">
                  <span class="block text-xs font-bold text-primary">$38</span>
                  <span
                    class="block text-[9px] text-slate-400 font-medium uppercase"
                    >Left</span
                  >
                </div>
              </div>
            </div>

            <!-- Groceries (Warning) -->
            <div
              class="group relative p-3 rounded-xl hover:bg-slate-50 cursor-pointer transition-all border border-transparent hover:border-slate-200"
            >
              <div
                class="absolute bottom-0 left-0 h-1 bg-slate-100 w-full rounded-b-xl overflow-hidden"
              >
                <div class="h-full bg-yellow-400 w-[90%] shadow-glow-warning">
                </div>
              </div>
              <div class="flex items-center gap-3 relative z-10 mb-1">
                <div
                  class="w-9 h-9 rounded-lg bg-slate-50 text-slate-500 group-hover:text-yellow-500 flex items-center justify-center transition-colors"
                >
                  <span class="material-symbols-outlined text-xl"
                    >shopping_basket</span
                  >
                </div>
                <div class="flex-1 min-w-0">
                  <p
                    class="font-bold text-sm text-slate-700 truncate group-hover:text-slate-900"
                  >
                    Groceries
                  </p>
                  <p
                    class="text-[10px] text-slate-500 font-mono tracking-tight"
                  >
                    $450 / $500
                  </p>
                </div>
                <div class="text-right">
                  <span class="block text-xs font-bold text-yellow-500"
                    >$50</span
                  >
                  <span
                    class="block text-[9px] text-slate-400 font-medium uppercase"
                    >Left</span
                  >
                </div>
              </div>
            </div>

            <!-- Transport (Over Budget) -->
            <div
              class="group relative p-3 rounded-xl hover:bg-slate-50 cursor-pointer transition-all border border-transparent hover:border-slate-200"
            >
              <div
                class="absolute bottom-0 left-0 h-1 bg-slate-100 w-full rounded-b-xl overflow-hidden"
              >
                <div class="h-full bg-red-500 w-[100%] shadow-glow-danger">
                </div>
              </div>
              <div class="flex items-center gap-3 relative z-10 mb-1">
                <div
                  class="w-9 h-9 rounded-lg bg-slate-50 text-slate-500 group-hover:text-red-500 flex items-center justify-center transition-colors"
                >
                  <span class="material-symbols-outlined text-xl"
                    >directions_car</span
                  >
                </div>
                <div class="flex-1 min-w-0">
                  <p
                    class="font-bold text-sm text-slate-700 truncate group-hover:text-slate-900"
                  >
                    Transport
                  </p>
                  <p
                    class="text-[10px] text-slate-500 font-mono tracking-tight"
                  >
                    $320 / $300
                  </p>
                </div>
                <div class="text-right">
                  <span class="block text-xs font-bold text-red-500">-$20</span>
                  <span
                    class="block text-[9px] text-slate-400 font-medium uppercase"
                    >Over</span
                  >
                </div>
              </div>
            </div>

            <!-- Housing -->
            <div
              class="group relative p-3 rounded-xl hover:bg-slate-50 cursor-pointer transition-all border border-transparent hover:border-slate-200"
            >
              <div
                class="absolute bottom-0 left-0 h-1 bg-slate-100 w-full rounded-b-xl overflow-hidden"
              >
                <div class="h-full bg-emerald-500 w-[30%]"></div>
              </div>
              <div class="flex items-center gap-3 relative z-10 mb-1">
                <div
                  class="w-9 h-9 rounded-lg bg-slate-50 text-slate-500 group-hover:text-emerald-500 flex items-center justify-center transition-colors"
                >
                  <span class="material-symbols-outlined text-xl">cottage</span>
                </div>
                <div class="flex-1 min-w-0">
                  <p
                    class="font-bold text-sm text-slate-700 truncate group-hover:text-slate-900"
                  >
                    Housing
                  </p>
                  <p
                    class="text-[10px] text-slate-500 font-mono tracking-tight"
                  >
                    $600 / $2000
                  </p>
                </div>
                <div class="text-right">
                  <span class="block text-xs font-bold text-emerald-500"
                    >$1.4k</span
                  >
                  <span
                    class="block text-[9px] text-slate-400 font-medium uppercase"
                    >Left</span
                  >
                </div>
              </div>
            </div>

            <!-- Clothing -->
            <div
              class="group relative p-3 rounded-xl hover:bg-slate-50 cursor-pointer transition-all border border-transparent hover:border-slate-200"
            >
              <div
                class="absolute bottom-0 left-0 h-1 bg-slate-100 w-full rounded-b-xl overflow-hidden"
              >
                <div class="h-full bg-primary w-[10%]"></div>
              </div>
              <div class="flex items-center gap-3 relative z-10 mb-1">
                <div
                  class="w-9 h-9 rounded-lg bg-slate-50 text-slate-500 group-hover:text-primary flex items-center justify-center transition-colors"
                >
                  <span class="material-symbols-outlined text-xl"
                    >checkroom</span
                  >
                </div>
                <div class="flex-1 min-w-0">
                  <p
                    class="font-bold text-sm text-slate-700 truncate group-hover:text-slate-900"
                  >
                    Clothing
                  </p>
                  <p
                    class="text-[10px] text-slate-500 font-mono tracking-tight"
                  >
                    $20 / $200
                  </p>
                </div>
                <div class="text-right">
                  <span class="block text-xs font-bold text-slate-500"
                    >$180</span
                  >
                  <span
                    class="block text-[9px] text-slate-400 font-medium uppercase"
                    >Left</span
                  >
                </div>
              </div>
            </div>

            <!-- New Category Button -->
            <div class="pt-4 px-2">
              <button
                class="w-full py-3 rounded-xl border border-dashed border-slate-300 text-slate-400 hover:text-primary hover:border-primary hover:bg-primary/5 transition-all text-sm font-bold flex items-center justify-center gap-2"
              >
                <span class="material-symbols-outlined">add</span>
                New Category
              </button>
            </div>
          </div>
        </aside>

        <!-- Main Content - Budget Editor -->
        <section
          class="flex-1 relative bg-slate-50 flex flex-col p-6 md:p-8 lg:p-10 overflow-y-auto"
        >
          <!-- Background Blobs -->
          <div
            class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-primary/5 rounded-full blur-3xl pointer-events-none"
          >
          </div>
          <div
            class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-blue-400/5 rounded-full blur-3xl pointer-events-none"
          >
          </div>

          <!-- Summary Cards -->
          <div
            class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8 relative z-10 max-w-5xl mx-auto w-full"
          >
            <div
              class="glass-panel p-5 rounded-2xl flex flex-col relative overflow-hidden group hover:shadow-lg transition-all duration-300"
            >
              <div
                class="absolute right-0 top-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity"
              >
                <span class="material-symbols-outlined text-6xl text-slate-900"
                  >account_balance_wallet</span
                >
              </div>
              <span
                class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-2"
                >Total Budget Set</span
              >
              <span
                class="text-2xl font-mono font-bold text-slate-900 tracking-tight"
                >$4,250.00</span
              >
            </div>

            <div
              class="glass-panel p-5 rounded-2xl flex flex-col relative overflow-hidden group hover:shadow-lg transition-all duration-300"
            >
              <div
                class="absolute right-0 top-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity"
              >
                <span class="material-symbols-outlined text-6xl text-slate-900"
                  >credit_card</span
                >
              </div>
              <span
                class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-2"
                >Total Spent</span
              >
              <div class="flex items-end gap-3">
                <span
                  class="text-2xl font-mono font-bold text-slate-900 tracking-tight"
                  >$1,842.30</span
                >
                <span
                  class="text-[10px] font-bold text-emerald-600 bg-emerald-100 px-2 py-1 rounded-md mb-1"
                  >43% Used</span
                >
              </div>
            </div>

            <div
              class="glass-panel p-5 rounded-2xl flex flex-col relative overflow-hidden group hover:shadow-lg transition-all duration-300 border-b-2 border-b-primary"
            >
              <div
                class="absolute right-0 top-0 p-4 opacity-5 group-hover:opacity-10 transition-opacity"
              >
                <span class="material-symbols-outlined text-6xl text-slate-900"
                  >savings</span
                >
              </div>
              <span
                class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-2"
                >Remaining Balance</span
              >
              <span
                class="text-2xl font-mono font-bold text-primary tracking-tight"
                >$2,407.70</span
              >
            </div>
          </div>

          <!-- Editor Card -->
          <div
            class="w-full max-w-5xl mx-auto glass-panel shadow-glass rounded-[2.5rem] relative z-10 flex-1 flex flex-col min-h-[500px]"
          >
            <div
              class="bg-white/60 rounded-[2.2rem] p-8 md:p-12 backdrop-blur-xl h-full flex flex-col"
            >
              <!-- Header -->
              <div
                class="flex items-start justify-between mb-8 pb-8 border-b border-slate-100"
              >
                <div class="flex gap-6 items-center">
                  <div
                    class="w-20 h-20 rounded-2xl bg-gradient-to-br from-primary to-emerald-400 text-white shadow-xl shadow-primary/20 flex items-center justify-center"
                  >
                    <span class="material-symbols-outlined text-4xl"
                      >coffee</span
                    >
                  </div>
                  <div>
                    <div class="flex items-center gap-3 mb-1">
                      <span
                        class="text-[10px] font-extrabold uppercase tracking-[0.2em] text-primary bg-primary/10 px-2 py-1 rounded"
                        >Editing</span
                      >
                      <span
                        class="text-[10px] font-extrabold uppercase tracking-[0.2em] text-slate-400"
                        >ID: #CF-01</span
                      >
                    </div>
                    <h2
                      class="text-4xl font-extrabold text-slate-900 tracking-tight"
                    >
                      Coffee
                    </h2>
                  </div>
                </div>
                <div class="flex gap-3">
                  <button
                    class="w-12 h-12 rounded-xl flex items-center justify-center text-slate-400 hover:text-primary hover:bg-primary/5 transition-all border border-transparent hover:border-primary/20"
                    title="History"
                  >
                    <span class="material-symbols-outlined">history</span>
                  </button>
                  <button
                    class="w-12 h-12 rounded-xl flex items-center justify-center text-red-400 hover:text-white hover:bg-red-500 transition-all border border-red-100 shadow-sm"
                    title="Delete Category"
                  >
                    <span class="material-symbols-outlined">delete</span>
                  </button>
                </div>
              </div>

              <!-- Form -->
              <form class="space-y-8 flex-1" onsubmit="event.preventDefault();">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                  <!-- Monthly Budget Limit -->
                  <div class="lg:col-span-2 space-y-3">
                    <label
                      class="text-xs font-bold text-slate-400 uppercase tracking-widest ml-1"
                      >Monthly Budget Limit</label
                    >
                    <div class="relative group">
                      <span
                        class="absolute left-6 top-1/2 -translate-y-1/2 text-primary font-mono font-bold text-2xl"
                        >$</span
                      >
                      <input
                        class="w-full h-20 pl-14 pr-6 bg-white border-2 border-slate-100 rounded-2xl font-mono text-4xl font-bold focus:ring-0 focus:border-primary transition-all shadow-sm text-slate-900 placeholder-slate-300"
                        type="text"
                        value="150.00"
                      />
                      <span
                        class="absolute right-6 top-1/2 -translate-y-1/2 text-slate-400 text-sm font-bold"
                        >USD</span
                      >
                    </div>
                  </div>

                  <!-- Frequency -->
                  <div class="space-y-3">
                    <label
                      class="text-xs font-bold text-slate-400 uppercase tracking-widest ml-1"
                      >Frequency</label
                    >
                    <div class="bg-slate-100 p-1.5 rounded-2xl h-20 flex">
                      <button
                        class="flex-1 rounded-xl bg-white text-slate-900 shadow-sm font-bold text-sm transition-all border border-slate-200"
                        type="button">Monthly</button
                      >
                      <button
                        class="flex-1 rounded-xl text-slate-500 hover:text-slate-700 font-bold text-sm transition-all"
                        type="button">Weekly</button
                      >
                    </div>
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
                  <!-- Category Name -->
                  <div class="space-y-3">
                    <label
                      class="text-xs font-bold text-slate-400 uppercase tracking-widest ml-1"
                      >Category Name</label
                    >
                    <input
                      class="w-full h-14 px-5 bg-slate-50 border border-slate-200 rounded-2xl font-bold focus:ring-4 focus:ring-primary/10 transition-all shadow-sm hover:bg-white focus:bg-white"
                      type="text"
                      value="Coffee"
                    />
                  </div>

                  <!-- Parent Group -->
                  <div class="space-y-3">
                    <label
                      class="text-xs font-bold text-slate-400 uppercase tracking-widest ml-1"
                      >Parent Group</label
                    >
                    <button
                      class="w-full h-14 px-5 flex items-center justify-between bg-slate-50 border border-slate-200 rounded-2xl font-bold hover:border-primary transition-all text-left group hover:bg-white"
                      type="button"
                    >
                      <div class="flex items-center gap-3">
                        <div
                          class="w-6 h-6 rounded bg-orange-100 flex items-center justify-center text-orange-600"
                        >
                          <span class="material-symbols-outlined text-sm"
                            >restaurant</span
                          >
                        </div>
                        <span>Food &amp; Drinks</span>
                      </div>
                      <span
                        class="material-symbols-outlined text-slate-400 group-hover:text-primary transition-colors"
                        >unfold_more</span
                      >
                    </button>
                  </div>
                </div>

                <!-- Rollover Toggle -->
                <div
                  class="bg-primary/5 rounded-[1.5rem] p-6 border border-primary/10 flex flex-col md:flex-row items-center justify-between gap-6"
                >
                  <div class="flex items-start gap-4">
                    <div
                      class="w-10 h-10 rounded-full bg-white shadow-sm text-primary flex items-center justify-center mt-1"
                    >
                      <span class="material-symbols-outlined">auto_mode</span>
                    </div>
                    <div>
                      <p class="font-bold text-slate-900">
                        Rollover Unused Budget
                      </p>
                      <p class="text-xs text-slate-500 mt-1 max-w-xs">
                        If enabled, any remaining budget from this month will be
                        added to next month's limit.
                      </p>
                    </div>
                  </div>
                  <label
                    class="relative inline-flex items-center cursor-pointer"
                  >
                    <input checked class="sr-only peer" type="checkbox" />
                    <div
                      class="w-14 h-8 bg-slate-200 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-primary/20 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-primary"
                    >
                    </div>
                  </label>
                </div>

                <!-- Actions -->
                <div class="flex items-center justify-end gap-4 pt-4 mt-auto">
                  <button
                    class="px-8 py-4 rounded-2xl text-slate-500 font-bold text-sm hover:bg-slate-100 transition-all"
                    type="button">Cancel</button
                  >
                  <button
                    class="px-10 py-4 rounded-2xl bg-slate-900 text-white font-bold text-sm shadow-xl shadow-slate-900/10 hover:shadow-slate-900/20 transition-all transform hover:-translate-y-1 flex items-center gap-2"
                    type="submit"
                  >
                    <span class="material-symbols-outlined text-lg">save</span>
                    Save Changes
                  </button>
                </div>
              </form>
            </div>
          </div>

          <p
            class="mt-8 text-center text-[11px] font-bold text-slate-400 uppercase tracking-widest opacity-50"
          >
            Sira Mindful Finance • Budgeting Engine v2.4
          </p>
        </section>
      </main>
    </div>
  </div>
</Base>
